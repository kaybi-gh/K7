<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:K7.Clients.MAUI"
             xmlns:mauiPages="clr-namespace:K7.Clients.MAUI.Pages;assembly=K7.Clients.MAUI"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="K7.Clients.MAUI.BlazorPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}"
             Padding="0">

    <Grid x:Name="RootGrid" SafeAreaEdges="None">
        <!-- Native MediaElement (video) - Android/iOS decode on TextureView (Android).
             NativeVideoPlayerOverlay (ZIndex 5+) owns transport chrome when MauiNativeVideoChrome
             is enabled (Android/iOS only). Windows stays full Blazor + Video.js in WebView2.
             Black at launch avoids a white flash before first frame. -->
        <toolkit:MediaElement x:Name="NativePlayer"
                              Aspect="AspectFit"
                              IsVisible="False"
                              ShouldAutoPlay="False"
                              BackgroundColor="Black"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              ShouldShowPlaybackControls="False"
                              AndroidViewType="TextureView"
                              InputTransparent="True" ZIndex="1"/>

        <!-- Native MediaElement (audio - Android/iOS/MacCatalyst). Windows uses WebView audioplayer.js. -->
        <toolkit:MediaElement x:Name="NativeAudioPlayer"
                              IsVisible="False"
                              ShouldAutoPlay="True"
                              ShouldShowPlaybackControls="False"
                              InputTransparent="True"
                              WidthRequest="0" HeightRequest="0" />

        <!-- Secondary audio element for overlapping crossfade / gapless prebuffer (MacCatalyst) -->
        <toolkit:MediaElement x:Name="NativeAudioCrossfadePlayer"
                              IsVisible="False"
                              ShouldAutoPlay="False"
                              ShouldShowPlaybackControls="False"
                              InputTransparent="True"
                              WidthRequest="0" HeightRequest="0" />
        
        <!-- Blazor shell: on Android/iOS with native overlay, WebView is hidden during play.
             Windows Video.js + Blazor controls stay in WebView2 for the whole session. -->
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html"
                   HorizontalOptions="Fill" VerticalOptions="Fill"
                   BackgroundColor="Transparent" ZIndex="2">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type mauiPages:MauiRoutes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <!-- Splash overlay - covers BlazorWebView until Blazor is ready -->
        <Grid x:Name="SplashOverlay" ZIndex="3"
              BackgroundColor="#0d0907"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              InputTransparent="False">
            <skia:SKLottieView x:Name="SplashAnimation"
                               Source="splash.json"
                               RepeatCount="-1"
                               WidthRequest="120"
                               HeightRequest="120"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

        <!-- Fallback close for native-only paths (Android/iOS); hidden on Windows (Blazor overlay handles close) -->
        <Button x:Name="NativePlayerCloseButton"
                Text="&#x2715;"
                IsVisible="False"
                ZIndex="4"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="16"
                WidthRequest="40"
                HeightRequest="40"
                CornerRadius="20"
                BackgroundColor="#80000000"
                TextColor="White"
                FontSize="18"
                Clicked="OnNativePlayerCloseClicked" />
    </Grid>
</ContentPage>