<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
    <!-- Workaround to not get Directory.Build.props TargetFramework on this project -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- CI single-platform publish: set on this project only via -p:K7PublishPlatform=...
         Do not pass global -p:TargetFrameworks= (poisons ProjectReference restore / NETSDK1005). -->
    <TargetFrameworks Condition="'$(K7PublishPlatform)' == 'android'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(K7PublishPlatform)' == 'windows'">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(K7PublishPlatform)' == 'ios'">net10.0-ios</TargetFrameworks>
    <!-- Linux desktop (GTK4 via dotnet/maui-labs) is a plain net10.0 TFM: no custom TFM, no MAUI
         workload. Default on Linux hosts, opt-in elsewhere with -p:K7PublishPlatform=linux. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux')) and '$(K7PublishPlatform)' == ''">net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(K7PublishPlatform)' == 'linux'">net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
    <!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

    <!-- Note for MacCatalyst:
      The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
      When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
      The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
      either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
    <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
    
    <OutputType>Exe</OutputType>
    <RootNamespace>K7.Clients.MAUI</RootNamespace>
		<AssemblyName>K7.Clients.MAUI</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>K7</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.k7.maui</ApplicationId>

    <!-- Versions: Resizetizer requires ApplicationDisplayVersion as 3-part numeric semver
         (no prerelease label). System.Version also rejects labels, so parse the core only. -->
    <_VersionCore>$([System.String]::Copy('$(Version)').Split('-')[0])</_VersionCore>
    <ApplicationDisplayVersion>$(_VersionCore)</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse('$(_VersionCore)').Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse('$(_VersionCore)').Minor), 100)))), $([System.Version]::Parse('$(_VersionCore)').Build)))</ApplicationVersion>

    <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Mono win-x64 runtime packs are not published for .NET 10; CoreCLR is required for RID publish. -->
    <UseMonoRuntime Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</UseMonoRuntime>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
    <DefaultLanguage>en</DefaultLanguage>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <!-- net10.0 = Linux GTK4 head. The MAUI SDK is not imported for this TFM (labs pattern), so the
       Platforms folder filtering, implicit usings and static web asset copy are declared here. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <UseMaui>false</UseMaui>
    <EnableDefaultMauiResourceItems>false</EnableDefaultMauiResourceItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);Platforms\**</DefaultItemExcludes>
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Include="Platforms\Linux\**\*.cs" />
    <!-- SingleProject targets (Controls.Build.Tasks) drop every Platforms/** compile item that is
         not on this allow-list. Condition-gated so the other TFMs still exclude Platforms/Linux. -->
    <MauiPlatformSpecificFolder Include="Platforms\Linux" />
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" />
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" />
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.BlazorWebView" />
    <!-- LibVLC 4 Direct Play (system libvlc, VLC 4 nightly). HLS stays Video.js in WebKitGTK. -->
    <PackageReference Include="LibVLCSharp" />
    <!-- Splash Lottie via Skottie into a Gtk.Picture (no SkiaSharp GTK handler). -->
    <PackageReference Include="SkiaSharp.Skottie" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <!-- Freedesktop app icon (mark on dark); LinuxNativeProtocol installs it as com.k7.maui in the
         user hicolor theme so the desktop entry, dock and "Open with" show the K7 symbol. -->
    <None Include="..\..\..\branding\icon.png"
          Link="hicolor\512x512\apps\com.k7.maui.png"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- Window icon: the labs host picks the newest file in hicolor/scalable/apps and uses its
         name as the default icon name, so ship the composed mark there too (see MauiIcon Remove). -->
    <None Include="..\..\..\branding\icon.png"
          Link="hicolor\scalable\apps\com.k7.maui.png"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- Same global usings the MAUI SDK adds on platform TFMs. -->
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Accessibility" />
    <Using Include="Microsoft.Maui.ApplicationModel" />
    <Using Include="Microsoft.Maui.ApplicationModel.Communication" />
    <Using Include="Microsoft.Maui.ApplicationModel.DataTransfer" />
    <Using Include="Microsoft.Maui.Authentication" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui.Controls.Hosting" />
    <Using Include="Microsoft.Maui.Controls.Xaml" />
    <Using Include="Microsoft.Maui.Devices" />
    <Using Include="Microsoft.Maui.Devices.Sensors" />
    <Using Include="Microsoft.Maui.Dispatching" />
    <Using Include="Microsoft.Maui.Graphics" />
    <Using Include="Microsoft.Maui.Hosting" />
    <Using Include="Microsoft.Maui.Media" />
    <Using Include="Microsoft.Maui.Networking" />
    <Using Include="Microsoft.Maui.Storage" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
    <AndroidCreatePackagePerAbi>True</AndroidCreatePackagePerAbi>
    <RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidUseAapt2>True</AndroidUseAapt2>
    <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
    <RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
    <!-- EF Core 10.0 trimmer bug: IL2037 on ExecuteUpdateAsync -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);IL2037</NoWarn>
    <TrimMode>partial</TrimMode>
    <!--
      Profiled Mono AOT: the default maui / maui-blazor profiles plus custom.aprof recorded on
      the TV box (K7 pages, SignalR, auth stack and the generic instantiations created at
      runtime by System.Text.Json / EF Core, which a static full AOT cannot see). Full AOT of
      every assembly was measured at 105 MB for no first-paint gain; it stays available for
      an A/B with -p:AndroidEnableProfiledAot=false. Not NativeAOT / PublishAot (EF Core,
      OpenIddict and Blazor Hybrid still need the JIT fallback for dynamic code).
    -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot Condition="'$(AndroidEnableProfiledAot)' == ''">true</AndroidEnableProfiledAot>
  </PropertyGroup>

  <!--
    Custom AOT profiles recorded on a device with Mono.AotProfiler.Android (docs/dev/developing.md,
    MAUI startup): custom.aprof (manual session: playback, menus) and tour.aprof (unattended
    AotProfileTour). Every *.aprof next to the csproj is picked up and the AOT compiler takes the
    union; only used when AndroidEnableProfiledAot is true, next to the default maui / maui-blazor
    profiles.
  -->
  <ItemGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
    <AndroidAotProfile Include="$(MSBuildThisFileDirectory)*.aprof" />
  </ItemGroup>

  <!--
    AOT profile recording build: -p:K7AotProfiling=true (docs/dev/developing.md, MAUI startup).
    The JIT must stay on so the profiler sees every method, and the Android SDK does not ship
    libmono-profiler-aot.so itself: it comes from the Mono.AotProfiler.Android package.
  -->
  <PropertyGroup Condition="'$(K7AotProfiling)' == 'true' And '$(TargetFramework)' == 'net10.0-android'">
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidEnableAotProfiler>true</AndroidEnableAotProfiler>
    <AndroidEmbedProfilers>aot</AndroidEmbedProfilers>
    <!-- Turns on AotProfileTour: the app walks its pages by itself while the profile records. -->
    <DefineConstants>$(DefineConstants);K7_AOT_PROFILING</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(K7AotProfiling)' == 'true' And '$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="Mono.AotProfiler.Android" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0d0907" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0d0907" BaseSize="256,256" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiAsset Include="..\Shared\UI\wwwroot\animations\splash.json" LogicalName="splash.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="SkiaSharp.Extended.UI.Maui" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Maui.Essentials" />
    <PackageReference Include="OpenIddict.Client.SystemIntegration" />
    <PackageReference Include="OpenIddict.Client.SystemNetHttp" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="LibVLCSharp.MAUI" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="SharpDX.Direct3D11" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.GooglePlayServices.Basement" />
    <PackageReference Include="Xamarin.GooglePlayServices.Cast" />
    <PackageReference Include="Xamarin.GooglePlayServices.Cast.Framework" />
    <PackageReference Include="SkiaSharp.Skottie" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\K7.Clients.Shared.csproj" />
    <ProjectReference Include="..\Shared\UI\K7.Clients.Shared.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="BlazorPage.xaml.cs">
      <DependentUpon>BlazorPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Platforms\iOS\Services\CodecService.cs">
      <ExcludeFromCurrentConfiguration>false</ExcludeFromCurrentConfiguration>
    </Compile>
    <Compile Update="Platforms\Windows\MauiProgram.Windows.cs">
      <ExcludeFromCurrentConfiguration>false</ExcludeFromCurrentConfiguration>
    </Compile>
    <Compile Update="SetupPage.xaml.cs">
      <DependentUpon>SetupPage.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="SetupPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="K7.Clients.MAUI.SmokeTests" />
  </ItemGroup>

  <!-- Linux: appicon.svg is only the background layer of the composed MAUI icon (Resizetizer
       does not run here). Without this the labs host shows a plain dark square as window icon. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <MauiIcon Remove="Resources\AppIcon\appicon.svg" />
  </ItemGroup>

  <Import Project="Platforms\Windows\LibVlcWindowsNative.targets" />

  <!-- Linux: libvlc 4 bundle (tools/linux/bundle-libvlc.sh output, gitignored) copied next to the
       app as libvlc/linux-x64, the counterpart of libvlc/win-x64 on Windows. Without it the client
       falls back to a system VLC 4. The publish tree is shipped as a Flatpak only
       (tools/linux/build-flatpak.sh); the Debian package and the tarball were dropped. -->
  <PropertyGroup>
    <K7LinuxLibVlcDir Condition="'$(K7LinuxLibVlcDir)' == ''">$(MSBuildProjectDirectory)/libvlc/linux-x64</K7LinuxLibVlcDir>
  </PropertyGroup>

  <Target Name="K7CopyLibVlcLinuxNatives"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(TargetFramework)' == 'net10.0' and Exists('$(K7LinuxLibVlcDir)/libvlc.so.12')">
    <ItemGroup>
      <_K7LibVlcLinuxFiles Include="$(K7LinuxLibVlcDir)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_K7LibVlcLinuxFiles)"
          DestinationFiles="@(_K7LibVlcLinuxFiles->'$(OutDir)libvlc/linux-x64/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="K7PublishLibVlcLinuxNatives"
          AfterTargets="Publish"
          Condition="'$(TargetFramework)' == 'net10.0'">
    <Message Importance="high"
             Condition="!Exists('$(K7LinuxLibVlcDir)/libvlc.so.12')"
             Text="K7: no libvlc bundle at $(K7LinuxLibVlcDir) (run tools/linux/bundle-libvlc.sh); Direct Play will need a system VLC 4" />
    <ItemGroup Condition="Exists('$(K7LinuxLibVlcDir)/libvlc.so.12')">
      <_K7LibVlcLinuxPublishFiles Include="$(K7LinuxLibVlcDir)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_K7LibVlcLinuxPublishFiles)"
          DestinationFiles="@(_K7LibVlcLinuxPublishFiles->'$(PublishDir)libvlc/linux-x64/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Linux: the GTK BlazorWebView serves wwwroot from the output folder (PhysicalFileProvider).
       Without the MAUI SDK nothing turns static web assets (own wwwroot + RCL _content) into
       app files, so copy them next to the exe on build and publish. -->
  <Target Name="K7CopyStaticWebAssetsLinux"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="ResolveProjectReferences;StaticWebAssetsPrepareForRun;StaticWebAssetsPrepareForPublish;LoadStaticWebAssetsPublishManifest"
          Condition="'$(TargetFramework)' == 'net10.0'">
    <ComputeStaticWebAssetsTargetPaths Assets="@(StaticWebAsset)" PathPrefix="wwwroot">
      <Output TaskParameter="AssetsWithTargetPath" ItemName="_K7LinuxStaticWebAsset" />
    </ComputeStaticWebAssetsTargetPaths>
    <Copy SourceFiles="@(_K7LinuxStaticWebAsset)"
          DestinationFiles="@(_K7LinuxStaticWebAsset->'$(OutDir)%(TargetPath)')"
          SkipUnchangedFiles="true" />
    <!-- The labs GTK scheme handler looks assets up with their query string: Blazor-ApexCharts
         imports "./apexcharts.esm.js?ver=x.y.z" from its module and gets a 404. -->
    <ItemGroup>
      <_K7LinuxVersionedModule Include="@(_K7LinuxStaticWebAsset->'$(OutDir)%(TargetPath)')"
                               Condition="$([System.String]::new('%(TargetPath)').Contains('Blazor-ApexCharts')) And $([System.String]::new('%(TargetPath)').EndsWith('.js'))" />
    </ItemGroup>
    <K7StripModuleVersionQuery Files="@(_K7LinuxVersionedModule)" />
  </Target>

  <UsingTask TaskName="K7StripModuleVersionQuery"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        foreach (var file in Files)
        {
            var path = file.ItemSpec;
            if (!File.Exists(path))
                continue;

            var text = File.ReadAllText(path);
            var stripped = Regex.Replace(text, @"(\.js)\?ver=[0-9A-Za-z.\-]+", "$1");
            if (!string.Equals(text, stripped, StringComparison.Ordinal))
                File.WriteAllText(path, stripped);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="K7PublishStaticWebAssetsLinux"
          AfterTargets="Publish"
          BeforeTargets="_PrepareDebStagingDir;_PrepareAppImageDir"
          Condition="'$(TargetFramework)' == 'net10.0'">
    <Copy SourceFiles="@(_K7LinuxStaticWebAsset)"
          DestinationFiles="@(_K7LinuxStaticWebAsset->'$(PublishDir)%(TargetPath)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_K7LinuxVersionedPublishModule Include="@(_K7LinuxStaticWebAsset->'$(PublishDir)%(TargetPath)')"
                                      Condition="$([System.String]::new('%(TargetPath)').Contains('Blazor-ApexCharts')) And $([System.String]::new('%(TargetPath)').EndsWith('.js'))" />
    </ItemGroup>
    <K7StripModuleVersionQuery Files="@(_K7LinuxVersionedPublishModule)" />
  </Target>

</Project>
