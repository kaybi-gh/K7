@inject IStringLocalizer<AdminStreamCard> L

<div class="stream-card @CardVariantClass focusable"
     role="button"
     tabindex="0"
     aria-label="@DetailsAriaLabel"
     @onclick="OnCardClicked"
     @onkeydown="OnCardKeyDown"
     @onkeydown:preventDefault="true">
    <div class="stream-card__artwork" @onclick:stopPropagation="@HasMediaHref">
        <MediaCard Model="ArtworkModel"
                   Variant="ArtworkVariant"
                   Href="@MediaHref"
                   FooterVisible="false"
                   ContextMenuEnabled="false"
                   PlaceholderIcon="@PlaceholderIcon" />
        @if (Stream.State == (int)K7.Server.Domain.Enums.PlaybackState.Paused)
        {
            <div class="stream-card__pause" aria-hidden="true">
                <K7Icon Icon="@Phosphor.Pause" />
            </div>
        }
    </div>

    <div class="stream-card__body">
        <div class="stream-card__header">
            <div class="stream-card__user">
                <K7Avatar Size="sm" Image="@Stream.UserAvatarUrl" UserId="@Stream.UserId">@UserInitial</K7Avatar>
                <span class="stream-card__user-name">@(Stream.UserName ?? "-")</span>
            </div>
            <div class="stream-card__header-tags">
                @if (PosterStatus is not null)
                {
                    <span class="stream-card__status stream-card__status--@PosterStatus">@PosterStatusLabel</span>
                }
                @if (ShowCompute)
                {
                    <span class="stream-card__compute" title="@ComputeLabel">@ComputeLabel</span>
                }
                @if (!string.IsNullOrEmpty(Stream.SharedProfileName))
                {
                    <K7Chip Size="xs" Variant="outlined">@Stream.SharedProfileName</K7Chip>
                }
            </div>
        </div>

        <div class="stream-card__title-row">
            <span class="stream-card__title">@(Stream.MediaTitle ?? "-")</span>
            @if (Stream.State == (int)K7.Server.Domain.Enums.PlaybackState.Buffering)
            {
                <K7Chip Size="xs" Color="info">@L["Buffering"]</K7Chip>
            }
        </div>

        @if (Stream.StreamDecision is { } decision)
        {
            <div class="stream-card__tracks">
                @if (decision.SourceVideoCodec is not null)
                {
                    <div class="stream-card__track-row">
                        <span class="stream-card__track-label">@L["Video"]</span>
                        <span class="stream-card__codec">
                            <span>@decision.SourceVideoCodec.ToUpperInvariant()</span>
                            <span class="stream-card__arrow">@L["Arrow"]</span>
                            <span>@((decision.StreamVideoCodec ?? decision.SourceVideoCodec).ToUpperInvariant())</span>
                        </span>
                        <span class="stream-card__pill @(IsVideoTranscoded ? "stream-card__pill--transcode" : "stream-card__pill--direct")"
                              title="@decision.VideoEncoder">
                            @VideoDecisionLabel
                        </span>
                    </div>
                }
                @if (decision.SourceAudioCodec is not null)
                {
                    var lang = decision.AudioTrackLanguage is not null
                        ? K7.Shared.SupportedLanguages.FindByCode(decision.AudioTrackLanguage)
                        : null;
                    <div class="stream-card__track-row">
                        <span class="stream-card__track-label">@L["Audio"]</span>
                        <span class="stream-card__codec">
                            @if (lang is not null)
                            {
                                <span class="fi fi-@lang.CountryCode stream-card__track-flag"></span>
                            }
                            <span>@decision.SourceAudioCodec.ToUpperInvariant()</span>
                            <span class="stream-card__arrow">@L["Arrow"]</span>
                            <span>@((decision.StreamAudioCodec ?? decision.SourceAudioCodec).ToUpperInvariant())</span>
                        </span>
                        <span class="stream-card__pill @(IsAudioTranscoded ? "stream-card__pill--transcode" : "stream-card__pill--direct")"
                              title="@decision.AudioEncoder">
                            @AudioDecisionLabel
                        </span>
                    </div>
                }
                @if (HasSubtitleTrack)
                {
                    var subLang = decision.SubtitleTrackLanguage is not null
                        ? K7.Shared.SupportedLanguages.FindByCode(decision.SubtitleTrackLanguage)
                        : null;
                    <div class="stream-card__track-row">
                        <span class="stream-card__track-label">@L["Subtitles"]</span>
                        <span class="stream-card__codec">
                            @if (subLang is not null)
                            {
                                <span class="fi fi-@subLang.CountryCode stream-card__track-flag"></span>
                            }
                            @if (decision.SubtitleTrackTitle is { } subTitle)
                            {
                                <span class="stream-card__track-title">@subTitle</span>
                            }
                            @if (decision.SubtitleCodec is { } subCodec)
                            {
                                <span>@subCodec.ToUpperInvariant()</span>
                            }
                        </span>
                        <span class="stream-card__pill @(IsSubtitleBurnIn ? "stream-card__pill--transcode" : "stream-card__pill--direct")">
                            @(IsSubtitleBurnIn ? L["BurnIn"] : L["Sidecar"])
                        </span>
                    </div>
                }
            </div>
            @if (FormatReason(decision.Reason) is { Length: > 0 } reason)
            {
                <p class="stream-card__note">@reason</p>
            }
        }

        @if (ShowProgress)
        {
            <div class="stream-card__progress">
                <K7ProgressBar Value="@ProgressPercent" />
                <div class="stream-card__times">
                    <span>@FormatTime(Stream.Position)</span>
                    @if (Stream.State == (int)K7.Server.Domain.Enums.PlaybackState.Paused)
                    {
                        <span class="stream-card__paused-label">@L["Paused"]</span>
                    }
                    <span>@FormatRemainingTime()</span>
                </div>
            </div>
        }

        <div class="stream-card__footer">
            <span class="stream-card__device">
                <K7Icon Icon="@Phosphor.Monitor" IconSize="@K7IconSize.Sm" />
                @DeviceLabel
            </span>
            <span class="stream-card__footer-meta">
                @if (Stream.StreamDecision?.SourceResolution is { } res)
                {
                    <span class="stream-card__meta">
                        @if (Stream.StreamDecision.StreamResolution is { } streamRes
                            && !string.Equals(res, streamRes, StringComparison.OrdinalIgnoreCase))
                        {
                            @($"{FormatResolution(res)} {L["Arrow"]} {FormatResolution(streamRes)}")
                        }
                        else
                        {
                            @FormatResolution(res)
                        }
                    </span>
                }
                @if (Stream.StreamDecision?.Bitrate is > 0)
                {
                    <span class="stream-card__meta">@FormatBitrate(Stream.StreamDecision.Bitrate.Value)</span>
                }
            </span>
        </div>
    </div>
</div>
