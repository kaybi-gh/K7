@inject IStringLocalizer<ResetPasswordDialog> L
@inject IStringLocalizer<SharedResource> S

<div class="k7-dialog-content">
    <div class="d-flex flex-col gap-2 mt-2">
        <K7TextField @bind-Value="_newPassword" Label="@L["NewPassword"]" Variant="outlined"
                      Type="password" Required="true" RequiredError="@L["PasswordRequired"]" Immediate="true" />
        <PasswordRulesHint Password="@_newPassword" />
    </div>
</div>
<div class="k7-dialog-actions">
    <K7Button OnClick="Cancel">@L["Cancel"]</K7Button>
    <K7Button Color="primary" Variant="filled" OnClick="Submit"
               Disabled="@(!CanSubmit || _isSubmitting)">
        @if (_isSubmitting)
        {
            <K7Spinner Size="sm" />
        }
        @L["ResetPassword"]
    </K7Button>
</div>
