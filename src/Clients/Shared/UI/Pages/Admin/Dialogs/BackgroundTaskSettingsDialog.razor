@inject IStringLocalizer<BackgroundTaskSettingsDialog> L
@inject IStringLocalizer<SharedResource> S

<div class="k7-dialog-content">
    @if (_isLoading)
    {
        <K7ProgressBar Indeterminate="true" />
    }
    else if (_settings is null)
    {
        <K7Alert Severity="K7Severity.Error">@S["LoadError"]</K7Alert>
    }
    else
    {
        <div class="background-task-settings">
            <K7TextField TValue="int" Type="number" @bind-Value="_workerCount"
                         Label="@L["WorkerCountLabel"]"
                         Class="background-task-settings__number" />

            <div class="background-task-settings__lanes">
                <h6 class="background-task-settings__lanes-title">@L["LanesTitle"]</h6>
                <p class="background-task-settings__hint">@L["LaneLimitHint"]</p>

                @foreach (var lane in _settings.Lanes)
                {
                    var current = lane;
                    <div class="background-task-settings__lane">
                        <K7TextField TValue="int" Type="number"
                                     Value="GetLaneLimit(current.Lane)"
                                     ValueChanged="@(v => SetLaneLimit(current.Lane, v))"
                                     Label="@GetLaneLabel(current.Lane)"
                                     Class="background-task-settings__number" />
                        <span class="background-task-settings__stats">
                            <span>@L["ActiveCount"] @current.ActiveCount</span>
                            <span>@L["PendingCount"] @current.PendingCount</span>
                        </span>
                    </div>
                }
            </div>
        </div>
    }
</div>
<div class="k7-dialog-actions">
    <K7Button OnClick="Cancel">@S["Cancel"]</K7Button>
    <K7Button Variant="filled" Color="primary" OnClick="Submit" Disabled="_isLoading || _settings is null">@S["Save"]</K7Button>
</div>
