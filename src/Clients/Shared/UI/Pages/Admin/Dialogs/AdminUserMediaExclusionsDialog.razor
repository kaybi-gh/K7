@inject IStringLocalizer<AdminUserMediaExclusionsDialog> L
@inject IStringLocalizer<SharedResource> S

<div class="k7-dialog-content media-exclusions">
    @if (_loading)
    {
        <K7ProgressBar Indeterminate="true" />
    }
    else if (_excludedMedias.Count == 0)
    {
        <p class="media-exclusions__empty">@L["Empty"]</p>
    }
    else
    {
        <p class="media-exclusions__intro">@string.Format(L["Hint"], _excludedMedias.Count)</p>

        <K7TextField TValue="string"
                     Value="@_search"
                     ValueChanged="@(value => _search = value ?? "")"
                     Immediate="true"
                     Placeholder="@L["SearchPlaceholder"]"
                     AdornmentIcon="@Phosphor.MagnifyingGlass" />

        @if (FilteredMedias.Count == 0)
        {
            <p class="media-exclusions__empty">@L["NoMatch"]</p>
        }
        else
        {
            <K7CheckboxList TItem="ExcludedMediaItem"
                            Items="FilteredMedias"
                            IsChecked="@(_ => true)"
                            CheckedChanged="@(e => ToggleMedia(e.Item, e.Checked))"
                            Class="media-exclusions__list">
                <ItemTemplate Context="media">
                    @if (!string.IsNullOrEmpty(media.PosterUrl))
                    {
                        <K7Avatar Size="sm" Image="@media.PosterUrl" />
                    }
                    else
                    {
                        <K7Avatar Size="sm" Letter="M" />
                    }
                    <span class="media-exclusions__text">
                        <span class="media-exclusions__name">@(media.Title ?? media.Id.ToString())</span>
                    </span>
                </ItemTemplate>
            </K7CheckboxList>
        }
    }
</div>
<div class="k7-dialog-actions">
    <K7Button OnClick="Cancel">@S["Cancel"]</K7Button>
    <K7Button Color="primary" Variant="filled" OnClick="Submit">@S["Save"]</K7Button>
</div>
