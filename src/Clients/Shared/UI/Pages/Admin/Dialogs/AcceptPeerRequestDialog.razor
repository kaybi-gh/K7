@using K7.Clients.Shared.Interfaces
@using K7.Clients.Shared.Models
@using K7.Shared.Dtos.Entities
@using K7.Shared.Interfaces
@inject IStringLocalizer<AcceptPeerRequestDialog> L
@inject IStringLocalizer<SharedResource> S
@inject ILibraryService LibraryService

<div class="k7-dialog-content accept-dialog">
    <div class="accept-dialog__peer">
        <span class="accept-dialog__peer-name">@RequesterName</span>
        <span class="accept-dialog__peer-url">@RequesterUrl</span>
    </div>
    <p>@L["UrlWarning"]</p>
    <p>@L["Message"]</p>

    @if (_isLoading)
    {
        <span>@S["Loading"]</span>
    }
    else
    {
        <div>
            <K7SettingRow Label="@L["SharedLibrariesLabel"]" Stacked="true">
                @if (_libraries.Count == 0)
                {
                    <span class="accept-dialog__empty">@L["NoLibraries"]</span>
                }
                else
                {
                    <K7CheckboxList TItem="LibraryDto"
                                    Items="_libraries"
                                    IsChecked="@(l => _selectedIds.Contains(l.Id))"
                                    CheckedChanged="@(e => ToggleLibrary(e.Item.Id))"
                                    ItemLabel="@(l => l.Title)"
                                    Class="accept-dialog__list" />
                }
            </K7SettingRow>
            <K7SettingRow Label="@L["AutoShareNewLibraries"]">
                <K7Switch Value="_autoShareNew"
                          ValueChanged="@(v => _autoShareNew = v)"
                          AriaLabel="@L["AutoShareNewLibraries"]" />
            </K7SettingRow>
        </div>
    }
</div>
<div class="k7-dialog-actions">
    <K7Button OnClick="Cancel">@S["Cancel"]</K7Button>
    <K7Button Variant="filled" Color="primary" OnClick="Submit">@L["Accept"]</K7Button>
</div>
