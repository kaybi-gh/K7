@inject IStringLocalizer<CreateUserDialog> L
@inject IStringLocalizer<SharedResource> S

<div class="k7-dialog-content">
        <div>
            <K7SettingRow Label="@L["Username"]" Required="true">
                <K7TextField @bind-Value="_username" Variant="outlined"
                             Required="true" RequiredError="@L["UsernameRequired"]" />
            </K7SettingRow>
            <K7SettingRow Label="@L["EmailOptional"]" Hint="@L["EmailHelper"]">
                <K7TextField @bind-Value="_email" Variant="outlined" />
            </K7SettingRow>
            <K7SettingRow Label="@L["Password"]" Hint="@L["PasswordHelper"]">
                <K7TextField @bind-Value="_password" Variant="outlined"
                             Type="password" Immediate="true" />
            </K7SettingRow>
            @if (!string.IsNullOrWhiteSpace(_password))
            {
                <PasswordRulesHint Password="@_password" Policy="@_policy" />
            }
            <K7SettingRow Label="@L["Role"]">
                <K7Select TValue="string" @bind-Value="_role" Variant="outlined">
                    <K7SelectItem Value="@("User")" Text="@S["RoleUser"]">@S["RoleUser"]</K7SelectItem>
                    <K7SelectItem Value="@("Administrator")" Text="@S["RoleAdministrator"]">@S["RoleAdministrator"]</K7SelectItem>
                </K7Select>
            </K7SettingRow>
        </div>
    </div>
    <div class="k7-dialog-actions">
        <K7Button OnClick="Cancel">@L["Cancel"]</K7Button>
        <K7Button Color="primary" Variant="filled" OnClick="Submit"
                   Disabled="@(!CanSubmit)">
            @if (_isSubmitting)
            {
                <K7Spinner Size="sm" />
            }
            @L["Create"]
        </K7Button>
    </div>
