@using K7.Server.Domain.Enums
@using K7.Shared.Dtos.Entities
@using Microsoft.AspNetCore.Components.Forms
@inject IStringLocalizer<EditLibraryGroupDialog> L
@inject IStringLocalizer<SharedResource> S

<div class="k7-dialog-content group-editor">
    <div>
        <K7SettingRow Label="@L["TitleLabel"]">
            <K7TextField @bind-Value="_title" Variant="outlined" Immediate="true" />
        </K7SettingRow>
        <K7SettingRow Label="@L["DescriptionLabel"]" Stacked="true">
            <K7TextField @bind-Value="_description" Variant="outlined" Lines="3" Immediate="true" />
        </K7SettingRow>
        <K7SettingRow Label="@L["ExploreTapActionSection"]" Hint="@L["ExploreTapActionHint"]">
            <K7ButtonGroup TValue="ExploreTapAction"
                           Options="TapActionOptions"
                           Value="_exploreTapAction"
                           ValueChanged="@(action => _exploreTapAction = action)"
                           AriaLabel="@L["ExploreTapActionSection"]" />
        </K7SettingRow>
        <K7SettingRow Label="@L["IconLabel"]">
            @if (!string.IsNullOrEmpty(_icon))
            {
                <i class="@_icon group-editor__icon-preview" aria-hidden="true"></i>
            }
            else
            {
                <span class="group-editor__none">@L["IconNone"]</span>
            }
            <K7Button Variant="outlined" Size="sm" OnClick="OpenIconPickerAsync">@L["IconChange"]</K7Button>
        </K7SettingRow>
        <K7SettingRow Label="@L["CoverLabel"]">
            @if (_pendingCover?.SourcePictureId.HasValue == true)
            {
                <K7Image Src="@($"/api/metadata-pictures/{_pendingCover.SourcePictureId}?size=Small")"
                         Class="group-editor__cover-preview"
                         Width="48"
                         Height="48"
                         ObjectFit="cover"
                         Alt="cover"
                         LoadingMode="K7ImageLoadingMode.Css" />
            }
            else if (_pendingCover?.File is not null)
            {
                <span class="group-editor__none">@_pendingCover.File.Name</span>
            }
            else if (_currentCoverPictureId.HasValue)
            {
                <K7Image Src="@($"/api/metadata-pictures/{_currentCoverPictureId}?size=Small")"
                         Class="group-editor__cover-preview"
                         Width="48"
                         Height="48"
                         ObjectFit="cover"
                         Alt="cover"
                         LoadingMode="K7ImageLoadingMode.Css" />
            }
            else
            {
                <span class="group-editor__none">@L["CoverNone"]</span>
            }
            <K7Button Variant="outlined" Size="sm" OnClick="OpenCoverPickerAsync">@L["CoverChange"]</K7Button>
            @if (_currentCoverPictureId.HasValue || _pendingCover is not null)
            {
                <K7Button Variant="text" Size="sm" OnClick="RemoveCover">@L["RemoveCover"]</K7Button>
            }
        </K7SettingRow>
        <K7SettingRow Label="@L["ColorLabel"]">
            <K7ColorPicker Value="@_cardColor" ValueChanged="OnCardColorChangedAsync" />
            <K7Button Variant="outlined"
                      Size="sm"
                      Disabled="@(!CanApplyCoverDominantColor)"
                      OnClick="ApplyCoverDominantColorAsync">
                @L["UseCoverDominantColor"]
            </K7Button>
        </K7SettingRow>
        <K7SettingRow Label="@L["PreviewLabel"]">
            <div class="group-editor__preview">
                <K7CategoryCard Title="@(_title ?? "")"
                                Description="@(_description ?? "")"
                                Icon="@PreviewIcon"
                                GradientStart="@_previewColors.GradientStart"
                                IconColor="@_previewColors.IconColor"
                                ImageUrl="@PreviewImageUrl"
                                CardColor="@_cardColor" />
            </div>
        </K7SettingRow>
    </div>

</div>
<div class="k7-dialog-actions">
    <K7Button OnClick="Cancel">@S["Cancel"]</K7Button>
    <K7Button Color="primary" Variant="filled" OnClick="Submit" Disabled="_isSubmitting">
        @if (_isSubmitting)
        {
            <K7Spinner Size="sm" />
        }
        @S["Save"]
    </K7Button>
</div>
