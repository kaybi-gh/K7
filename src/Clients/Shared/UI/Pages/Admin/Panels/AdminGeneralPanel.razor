@page "/admin/general"
@layout AdminLayout
@using K7.Clients.Shared.Models
@using K7.Clients.Shared.Services.Resources
@inject IStringLocalizer<AdminGeneralPanel> L
@inject IStringLocalizer<SharedResource> S

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="admin-page-intro">
    <AdminPageHeader Title="@L["PageTitle"]" Subtitle="@L["Subtitle"]" />
</div>

@if (_isLoading)
{
    <K7ProgressBar Indeterminate="true" />
}
else
{
    <div class="settings-form-page">
        <div class="settings-form-page__body pa-4 d-flex flex-col gap-6">
            <section class="d-flex flex-col gap-4">
                <K7LanguageSelect Value="@_defaultLanguage"
                                  ValueChanged="OnDefaultLanguageChanged"
                                  Label="@L["DefaultLanguage"]"
                                  Languages="SupportedLanguages.Interface" />

                <K7Select TValue="ThemeDefinition"
                          Label="@L["DefaultTheme"]"
                          Value="_defaultTheme"
                          ValueChanged="OnDefaultThemeChanged"
                          ToStringFunc="@(t => t?.Name)">
                    @foreach (var theme in Themes.Collection)
                    {
                        <K7SelectItem Value="@theme" Text="@theme.Name">@theme.Name</K7SelectItem>
                    }
                </K7Select>
            </section>

            <K7Divider />

            <section class="d-flex flex-col gap-3">
                <div>
                    <h6 class="mb-1">@L["ThemeSongsSection"]</h6>
                    <p class="text-sm" Color="secondary">@L["PlayThemeSongsHint"]</p>
                </div>
                <K7Switch Label="@L["PlayThemeSongs"]"
                          Value="_playThemeSongs"
                          ValueChanged="OnPlayThemeSongsChanged" />
            </section>

            <K7Divider />

            <section class="d-flex flex-col gap-3">
                <div>
                    <h6 class="mb-1">@L["MediaLinkPreviewsSection"]</h6>
                    <p class="text-sm" Color="secondary">@L["MediaLinkPreviewsHint"]</p>
                </div>
                <K7Switch Label="@L["MediaLinkPreviews"]"
                          Value="_mediaLinkPreviewsEnabled"
                          ValueChanged="OnMediaLinkPreviewsChanged" />
            </section>
        </div>

        <K7SettingsActionBar IsDirty="IsDirty"
                             IsSaving="_saving"
                             ShowResetToDefaults="false"
                             OnSave="SaveAsync"
                             OnCancel="CancelChanges" />
    </div>
}
