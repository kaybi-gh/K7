@page "/admin/advanced/link-previews"
@page "/admin/general"
@page "/admin/interface"
@page "/admin/interface/appearance"
@page "/admin/interface/theme-songs"
@layout AdminLayout
@inject IStringLocalizer<AdminGeneralPanel> L
@inject IStringLocalizer<SharedResource> S
@inject IStringLocalizer<InterfaceSettingsSplit> Li
@inject IStringLocalizer<AdvancedSettingsSplit> La
@inject NavigationManager NavigationManager

@* Server defaults shown as the Appearance and Theme songs sub-pages of Interface (one form,
   one Save) and as the Link previews sub-page of Advanced (one switch, saved on change). *@
<PageTitle>@(IsLinkPreviewsPage ? La["Title"] : Li["Title"])</PageTitle>

<div class="settings-form-page settings-form-page--section-actions">
    <div class="settings-form-page__body">
        @if (IsLinkPreviewsPage)
        {
            <AdvancedSettingsSplit Section="@AdvancedSettingsSplit.LinkPreviews">
                @if (_isLoading)
                {
                    <K7ProgressBar Indeterminate="true" />
                }
                else
                {
                    <K7SettingRow Label="@L["MediaLinkPreviews"]" Hint="@L["MediaLinkPreviewsHint"]">
                        <K7Switch AriaLabel="@L["MediaLinkPreviews"]"
                                  Value="_mediaLinkPreviewsEnabled"
                                  ValueChanged="OnMediaLinkPreviewsChangedAsync"
                                  Disabled="_linkPreviewsSaving" />
                    </K7SettingRow>
                }
            </AdvancedSettingsSplit>
        }
        else
        {
            <InterfaceSettingsSplit Section="@ActiveSection" Admin="true">
                @if (_isLoading)
                {
                    <K7ProgressBar Indeterminate="true" />
                }
                else if (IsThemeSongs)
                {
                    <K7SettingRow Label="@L["PlayThemeSongs"]" Hint="@L["PlayThemeSongsHint"]">
                        <K7Switch AriaLabel="@L["PlayThemeSongs"]"
                                  Value="_playThemeSongs"
                                  ValueChanged="OnPlayThemeSongsChanged" />
                    </K7SettingRow>
                }
                else
                {
                    <K7SettingRow Label="@L["DefaultLanguage"]">
                        <K7LanguageSelect Value="@_defaultLanguage"
                                          ValueChanged="OnDefaultLanguageChanged"
                                          Languages="SupportedLanguages.Interface" />
                    </K7SettingRow>
                    <K7SettingRow Label="@L["DefaultTheme"]" Stacked="true">
                        <K7ThemePicker Themes="SelectableThemes"
                                       Value="@_defaultTheme.Id"
                                       ValueChanged="OnDefaultThemeChanged"
                                       AriaLabel="@L["DefaultTheme"]" />
                    </K7SettingRow>
                    <K7SettingRow Label="@L["ServerThemes"]" Hint="@L["ServerThemesHint"]" Stacked="true">
                        <CustomThemeList Themes="_serverThemes"
                                         Server="true"
                                         MaxCount="ServerThemes.MaxCount"
                                         Disabled="_savingThemes"
                                         OnAdded="AddServerThemeAsync"
                                         OnEdited="ReplaceServerThemeAsync"
                                         OnDeleted="RemoveServerThemeAsync" />
                    </K7SettingRow>
                }
            </InterfaceSettingsSplit>
        }
    </div>

    @if (!_isLoading && IsLinkPreviewsPage)
    {
        <K7SettingsActionBar AutoSave="true"
                             SaveState="_linkPreviewsSaveState"
                             ShowResetToDefaults="false" />
    }
    else if (!_isLoading)
    {
        <K7SettingsActionBar IsDirty="IsDirty"
                             IsSaving="_saving"
                             ShowResetToDefaults="false"
                             OnSave="SaveAsync"
                             OnCancel="CancelChanges" />
    }
</div>
