@page "/admin/video-playback"
@page "/admin/video-playback/{Section}"
@layout AdminLayout
@using K7.Shared
@using K7.Shared.Enums
@inject IStringLocalizer<AdminVideoPlayerSettingsPanel> L
@inject IStringLocalizer<AdminTrackSelectionPanel> Lt
@inject IStringLocalizer<SettingsVideoPlayerPage> Ls

@if (_loading)
{
    <div class="admin-page-intro">
        <AdminPageHeader Title="@L["PageTitle"]" Subtitle="@L["DefaultsInfo"]">
            <Actions>
                <SettingsMirrorLink />
            </Actions>
        </AdminPageHeader>
    </div>
    <div class="d-flex flex-col pa-16">
        <K7Spinner />
    </div>
}
else if (_settings is not null && _preferences is not null && _videoPolicy is not null)
{
    <div class="settings-form-page">
        <div class="settings-form-page__body">
            <K7SettingsSplit IndexLabel="@L["PageTitle"]"
                             DetailTitle="@ActiveSectionTitle"
                             BackHref="@BasePath"
                             DetailOpen="IsSectionOpen">
                <Header>
                    <div class="admin-page-intro">
                        <AdminPageHeader Title="@L["PageTitle"]" Subtitle="@L["DefaultsInfo"]">
                            <Actions>
                                <SettingsMirrorLink />
                            </Actions>
                        </AdminPageHeader>
                    </div>
                </Header>
                <Index>
                    @foreach (var section in Sections)
                    {
                        <K7SettingsNavItem Href="@($"{BasePath}/{section.Key}")"
                                           Icon="@section.Icon"
                                           Title="@section.Title"
                                           Description="@section.Description"
                                           Active="@(section.Key == ActiveSection)" />
                    }
                </Index>
                <Detail>
                    @switch (ActiveSection)
                    {
                        case VideoSettingsSections.Tracks:
                            <TrackSelectionSettingsFields Preferences="_preferences"
                                                          Settings="_settings"
                                                          Libraries="_libraries"
                                                          SelectedLibraryId="_selectedLibraryId"
                                                          LibraryScopeChanged="OnLibraryScopeChanged"
                                                          Changed="StateHasChanged"
                                                          Localizer="Lt" />
                            break;

                        case VideoSettingsSections.Resume:
                            <PlaybackPolicySettingsFields VideoPolicy="_videoPolicy"
                                                          VideoPolicyChanged="OnVideoPolicyChanged"
                                                          ShowHeading="false" />
                            break;

                        default:
                            <VideoPlayerSettingsFields Settings="_settings"
                                                       Section="@ActiveSection"
                                                       Changed="StateHasChanged"
                                                       Localizer="L"
                                                       ServerDefaults="true" />
                            break;
                    }
                </Detail>
            </K7SettingsSplit>
        </div>

        <K7SettingsActionBar IsDirty="IsDirty"
                             IsSaving="_saving"
                             ResetDisabled="ResetDisabled"
                             OnSave="SaveAsync"
                             OnCancel="CancelChanges"
                             OnResetToDefaults="ResetAsync" />
    </div>
}
