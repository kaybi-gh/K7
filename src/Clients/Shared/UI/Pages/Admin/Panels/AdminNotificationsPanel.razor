@page "/admin/notifications"
@page "/admin/notifications/{RuleId:guid}"
@layout AdminLayout
@using K7.Shared.Dtos.Notifications
@inject IStringLocalizer<AdminNotificationsPanel> L
@inject IStringLocalizer<SharedResource> S
@implements IAsyncDisposable

@* List on the left, the selected rule's sheet on the right. Narrow screens and TV show the list,
   then the sheet as its own screen (same shell as the settings pages). *@
<div class="notifications-page" aria-live="polite">
    @if (_isLoading)
    {
        <div class="admin-page-intro">
            <AdminPageHeader Title="@L["Title"]" Subtitle="@L["Subtitle"]" />
        </div>
        <K7ProgressBar Indeterminate="true" />
    }
    else if (_rules.Count == 0)
    {
        <div class="admin-page-intro">
            <AdminPageHeader Title="@L["Title"]" Subtitle="@L["Subtitle"]">
                <Actions>
                    <K7Button Variant="filled" Color="primary" StartIcon="@Phosphor.Plus"
                              OnClick="OpenCreateDialog" aria-label="@L["AriaCreate"]">
                        @L["CreateRule"]
                    </K7Button>
                </Actions>
            </AdminPageHeader>
        </div>
        <K7EmptyState Icon="@Phosphor.Bell" Title="@L["Empty"]" Subtitle="@L["EmptyHint"]" />
    }
    else
    {
        var selectedRule = SelectedRule;

        <K7SettingsSplit IndexLabel="@L["Title"]"
                         WideIndex="true"
                         DetailTitle="@(selectedRule?.Name ?? "")"
                         BackHref="@BasePath"
                         DetailOpen="IsRuleOpen">
            <Header>
                <div class="admin-page-intro">
                    <AdminPageHeader Title="@(_selectionMode ? string.Format(L["SelectedCount"], SelectedCount) : L["Title"])"
                                     Subtitle="@L["Subtitle"]">
                        <Actions>
                            @if (_selectionMode)
                            {
                                <K7Button Variant="text" OnClick="ToggleSelectAll" Disabled="@_deleting">
                                    @(AllSelected ? L["DeselectAll"] : L["SelectAll"])
                                </K7Button>
                                <K7Button Variant="filled"
                                          Color="error"
                                          StartIcon="@Phosphor.Trash"
                                          OnClick="ConfirmDeleteSelectedAsync"
                                          Disabled="@(SelectedCount == 0 || _deleting)"
                                          AriaLabel="@L["DeleteSelected"]">
                                    @L["DeleteSelected"]
                                </K7Button>
                                <K7Button Variant="text" OnClick="ExitSelectionMode" Disabled="@_deleting" AriaLabel="@S["Cancel"]">
                                    @S["Cancel"]
                                </K7Button>
                            }
                            else
                            {
                                <K7ResultCount Count="_rules.Count" />
                                <K7IconButton Icon="@Phosphor.ListChecks"
                                              OnClick="EnterSelectionMode"
                                              AriaLabel="@L["Select"]" />
                                <K7Button Variant="filled" Color="primary" StartIcon="@Phosphor.Plus"
                                          OnClick="OpenCreateDialog" aria-label="@L["AriaCreate"]">
                                    @L["CreateRule"]
                                </K7Button>
                            }
                        </Actions>
                    </AdminPageHeader>
                </div>
            </Header>
            <Index>
                @foreach (var rule in _rules)
                {
                    <K7EntityRow @key="rule.Id"
                                 Id="@($"rule-{rule.Id}")"
                                 Title="@rule.Name"
                                 Subtitle="@GetEventDisplayNames(rule.EventTypeNames)"
                                 Href="@($"{BasePath}/{rule.Id}")"
                                 OnClick="@(_selectionMode ? EventCallback.Factory.Create(this, () => ToggleSelection(rule.Id)) : default)"
                                 Checked="@(_selectionMode ? IsSelected(rule.Id) : null)"
                                 Active="@(!_selectionMode && rule.Id == selectedRule?.Id)"
                                 Dimmed="@(!rule.IsEnabled)">
                        <Leading>
                            <K7Icon Icon="@GetProviderIcon(rule)" IconSize="@K7IconSize.Md" />
                        </Leading>
                        <Trailing>
                            <K7Chip Size="sm" Color="default">@rule.ProviderType</K7Chip>
                            @if (!rule.IsEnabled)
                            {
                                <K7Chip Size="sm" Color="default">@L["Disabled"]</K7Chip>
                            }
                        </Trailing>
                    </K7EntityRow>
                }
            </Index>
            <Detail>
                @if (selectedRule is not null)
                {
                    var rule = selectedRule;
                    var destination = GetDestination(rule);

                    <div>
                        <K7SettingRow Label="@L["HeaderEnabled"]">
                            <K7Switch AriaLabel="@L["HeaderEnabled"]"
                                      Value="@rule.IsEnabled"
                                      ValueChanged="@(v => OnToggleEnabled(rule, v))" />
                        </K7SettingRow>
                        <K7SettingRow Label="@L["FieldEvents"]">
                            <span class="rule-sheet__value">@GetAllEventDisplayNames(rule.EventTypeNames)</span>
                        </K7SettingRow>
                        <K7SettingRow Label="@L["HeaderProvider"]">
                            <K7Chip Size="sm" Color="default">@rule.ProviderType</K7Chip>
                        </K7SettingRow>
                        @if (destination is not null)
                        {
                            <K7SettingRow Label="@L["FieldDestination"]">
                                <span class="rule-sheet__value">@destination</span>
                            </K7SettingRow>
                        }
                        <K7SettingRow Label="@L["FieldSchedule"]">
                            <span class="rule-sheet__value">@GetScheduleSummary(rule)</span>
                        </K7SettingRow>
                        @if (rule.CooldownSeconds is > 0)
                        {
                            <K7SettingRow Label="@L["FieldCooldown"]">
                                <span class="rule-sheet__value">@string.Format(L["SecondsValue"], rule.CooldownSeconds)</span>
                            </K7SettingRow>
                        }
                        @if (rule.BatchDebounceSeconds is > 0)
                        {
                            <K7SettingRow Label="@L["FieldBatching"]">
                                <span class="rule-sheet__value">@string.Format(L["SecondsValue"], rule.BatchDebounceSeconds)</span>
                            </K7SettingRow>
                        }
                        <K7SettingRow Label="@L["FieldLastModified"]">
                            <span class="rule-sheet__value">@rule.LastModified.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                        </K7SettingRow>
                    </div>

                    <h6 class="rule-sheet__heading">@L["HeaderActions"]</h6>
                    <div class="rule-sheet__actions">
                        <K7SheetAction Icon="@Phosphor.PaperPlaneTilt" Label="@L["ActionTest"]" OnClick="@(() => TestRule(rule))" />
                        <K7SheetAction Icon="@Phosphor.PencilSimple" Label="@L["ActionEdit"]" Badges="GetEditBadges(rule)" OnClick="@(() => OpenEditDialog(rule))" />
                        <K7SheetAction Icon="@Phosphor.Trash" Label="@L["ActionDelete"]" Danger="true" OnClick="@(() => ConfirmDelete(rule))" />
                    </div>
                }
            </Detail>
        </K7SettingsSplit>
    }
</div>
