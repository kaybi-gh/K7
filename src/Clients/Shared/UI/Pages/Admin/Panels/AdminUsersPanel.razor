@page "/admin/users"
@page "/admin/users/{UserId:guid}"
@layout AdminLayout
@using K7.Shared.Dtos.Users
@inject IStringLocalizer<AdminUsersPanel> L
@inject IStringLocalizer<SharedResource> S
@implements IAsyncDisposable

@* List on the left, the selected user's sheet on the right. Narrow screens and TV show the list,
   then the sheet as its own screen (same shell as the settings pages). *@
<div class="users-page" aria-live="polite">
    @if (_isLoading)
    {
        <div class="admin-page-intro">
            <AdminPageHeader Title="@L["Title"]" Subtitle="@L["Subtitle"]" />
        </div>
        <K7ProgressBar Indeterminate="true" />
    }
    else
    {
        var selectedUser = SelectedUser;

        <K7SettingsSplit IndexLabel="@L["Title"]"
                         WideIndex="true"
                         DetailTitle="@(selectedUser?.UserName ?? selectedUser?.Email ?? "")"
                         BackHref="@BasePath"
                         DetailOpen="IsUserOpen">
            <Header>
                <div class="admin-page-intro">
                    <AdminPageHeader Title="@(_selectionMode ? string.Format(L["SelectedCount"], SelectedCount) : L["Title"])"
                                     Subtitle="@L["Subtitle"]">
                        <Actions>
                            @if (_selectionMode)
                            {
                                <K7Button Variant="text" OnClick="ToggleSelectAll" Disabled="@(!HasSelectableUsers || _deleting)">
                                    @(AllSelected ? L["DeselectAll"] : L["SelectAll"])
                                </K7Button>
                                <K7Button Variant="filled"
                                          Color="error"
                                          StartIcon="@Phosphor.Trash"
                                          OnClick="ConfirmDeleteSelectedAsync"
                                          Disabled="@(SelectedCount == 0 || _deleting)"
                                          AriaLabel="@L["DeleteSelected"]">
                                    @L["DeleteSelected"]
                                </K7Button>
                                <K7Button Variant="text" OnClick="ExitSelectionMode" Disabled="@_deleting" AriaLabel="@S["Cancel"]">
                                    @S["Cancel"]
                                </K7Button>
                            }
                            else
                            {
                                @if (_users.Count > 0)
                                {
                                    <K7ResultCount Count="_users.Count" />
                                    <K7IconButton Icon="@Phosphor.ListChecks"
                                                  OnClick="EnterSelectionMode"
                                                  Disabled="@(!HasSelectableUsers)"
                                                  AriaLabel="@L["Select"]" />
                                }
                                <K7Button Variant="filled" Color="primary" StartIcon="@Phosphor.UserPlus"
                                          OnClick="OpenCreateUserDialog" aria-label="@L["AriaCreateUser"]">
                                    @L["CreateUserTitle"]
                                </K7Button>
                            }
                        </Actions>
                    </AdminPageHeader>
                </div>
            </Header>
            <Index>
                <K7TextField TValue="string"
                             Value="@_search"
                             ValueChanged="@(value => _search = value ?? "")"
                             Immediate="true"
                             Placeholder="@L["SearchPlaceholder"]"
                             AdornmentIcon="@Phosphor.MagnifyingGlass"
                             Class="users-search" />

                @if (_users.Count == 0)
                {
                    <p class="users-list-empty">@L["Empty"]</p>
                }
                else if (FilteredUsers.Count == 0)
                {
                    <p class="users-list-empty">@L["NoMatch"]</p>
                }

                @foreach (var user in FilteredUsers)
                {
                    var selected = IsSelected(user.Id);
                    <K7EntityRow @key="user.Id"
                                 Id="@($"user-{user.Id}")"
                                 Title="@(user.UserName ?? "-")"
                                 Subtitle="@(user.Email ?? "-")"
                                 Href="@($"{BasePath}/{user.Id}")"
                                 OnClick="@(_selectionMode ? EventCallback.Factory.Create(this, () => ToggleSelection(user.Id)) : default)"
                                 Disabled="@(_selectionMode && !CanDeleteUser(user))"
                                 Checked="@(_selectionMode ? selected : null)"
                                 Active="@(!_selectionMode && user.Id == selectedUser?.Id)"
                                 Highlighted="@(user.Id == _highlightedUserId)"
                                 Dimmed="@(!user.IsActive)">
                        <Leading>
                            <K7Avatar Size="sm" Image="@user.AvatarUrl"
                                      Letter="@(user.UserName?[..1].ToUpperInvariant() ?? "?")"
                                      UserId="@user.Id">
                                <span class="connection-badge connection-badge--@GetPresenceBadgeClass(user)"
                                      title="@GetPresenceTitle(user)"
                                      aria-label="@GetPresenceTitle(user)"></span>
                            </K7Avatar>
                        </Leading>
                        <Trailing>
                            @if (IsCurrentUser(user))
                            {
                                <K7Chip Size="sm" Variant="filled" Color="primary">@L["ThisUser"]</K7Chip>
                            }
                            @if (user.IsGuest)
                            {
                                <K7Chip Size="sm" Color="default">@S["Guest"]</K7Chip>
                            }
                            else if (user.Role == Roles.Administrator)
                            {
                                <K7Chip Size="sm" Color="default">@L["RoleAdministrator"]</K7Chip>
                            }
                            @if (user.GuardianUserIds.Count > 0)
                            {
                                <K7Chip Size="sm" Color="default">@L["Managed"]</K7Chip>
                            }
                            @if (!user.IsActive)
                            {
                                <K7Chip Size="sm" Color="default">@L["Inactive"]</K7Chip>
                            }
                        </Trailing>
                    </K7EntityRow>
                }
            </Index>
            <Detail>
                @if (selectedUser is null)
                {
                    <p class="users-list-empty">@L["Empty"]</p>
                }
                else
                {
                    var user = selectedUser;

                    <div class="user-sheet__identity @(!user.IsActive ? "user-inactive" : "")">
                        <K7Avatar Size="md" Image="@user.AvatarUrl"
                                  Letter="@(user.UserName?[..1].ToUpperInvariant() ?? "?")"
                                  UserId="@user.Id" />
                        <div class="user-sheet__identity-text">
                            <span class="user-email">@(user.Email ?? "-")</span>
                            <span class="user-sheet__presence">
                                <span class="connection-badge connection-badge--@GetPresenceBadgeClass(user)" aria-hidden="true"></span>
                                @GetPresenceTitle(user)
                            </span>
                        </div>
                        @if (IsCurrentUser(user))
                        {
                            <K7Chip Size="sm" Variant="filled" Color="primary">@L["ThisUser"]</K7Chip>
                        }
                    </div>

                    <div>
                        @* A managed account cannot become an administrator: its guardians would get the role. *@
                        <K7SettingRow Label="@L["HeaderRole"]" Hint="@(IsManaged(user) ? L["RoleManagedHint"].Value : null)">
                            @if (user.IsGuest)
                            {
                                <K7Chip Size="sm" Color="default">@S["Guest"]</K7Chip>
                            }
                            else
                            {
                                <K7Select TValue="string" Value="@user.Role" ValueChanged="@(role => OnRoleChanged(user, role))"
                                          Variant="outlined">
                                    <K7SelectItem Value="@Roles.Administrator" Text="@L["RoleAdministrator"]" Disabled="@IsManaged(user)">@L["RoleAdministrator"]</K7SelectItem>
                                    <K7SelectItem Value="@Roles.User" Text="@L["RoleUser"]">@L["RoleUser"]</K7SelectItem>
                                </K7Select>
                            }
                        </K7SettingRow>
                        <K7SettingRow Label="@L["HeaderActive"]">
                            <K7Switch AriaLabel="@L["HeaderActive"]"
                                      Value="@user.IsActive"
                                      ValueChanged="@(v => OnToggleActive(user, v))" />
                        </K7SettingRow>
                        <K7SettingRow Label="@L["HeaderCreatedAt"]">
                            <span class="user-sheet__value">@user.Created.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                        </K7SettingRow>
                    </div>

                    <h6 class="user-sheet__heading">@L["SectionAccess"]</h6>
                    <div class="user-sheet__actions">
                        @if (!user.IsGuest)
                        {
                            <K7SheetAction Icon="@Phosphor.Sliders" Label="@L["ActionCapabilities"]" Badges="GetCapabilityBadges(user)" OnClick="@(() => OpenCapabilitiesDialog(user))" />
                        }
                        <K7SheetAction Icon="@Phosphor.VideoCamera" Label="@L["ActionLibraries"]" Badges="GetLibraryBadges(user)" OnClick="@(() => OpenLibraryExclusionsDialog(user))" />
                        <K7SheetAction Icon="@Phosphor.EyeSlash" Label="@L["ActionHiddenMedia"]" Badges="GetHiddenMediaBadges(user)" OnClick="@(() => OpenMediaExclusionsDialog(user))" />
                        <K7SheetAction Icon="@Phosphor.Shield" Label="@L["ActionRestrictions"]" Badges="GetRestrictionBadges(user)" OnClick="@(() => OpenRestrictionProfileDialog(user))" />
                        @if (!user.IsGuest)
                        {
                            <K7SheetAction Icon="@Phosphor.UserSwitch" Label="@L["ActionGuardians"]" Badges="GetGuardianBadges(user)" OnClick="@(() => OpenGuardiansDialog(user))" />
                        }
                        <K7SheetAction Icon="@Phosphor.ClockCounterClockwise" Label="@L["ActionPlaybackHistory"]" OnClick="@(() => NavigateToPlaybackHistory(user))" />
                    </div>

                    @if (!user.IsGuest && user.Id != _currentUserId)
                    {
                        <h6 class="user-sheet__heading">@L["SectionAccount"]</h6>
                        <div class="user-sheet__actions">
                            <K7SheetAction Icon="@Phosphor.Key" Label="@L["ActionResetPassword"]" OnClick="@(() => OpenResetPasswordDialog(user))" />
                            <K7SheetAction Icon="@Phosphor.GitMerge" Label="@L["ActionMerge"]" OnClick="@(() => OpenMergeUserDialog(user))" />
                            <K7SheetAction Icon="@Phosphor.Trash" Label="@L["ActionDelete"]" Danger="true" OnClick="@(() => ConfirmDelete(user))" />
                        </div>
                    }
                }
            </Detail>
        </K7SettingsSplit>
    }
</div>
