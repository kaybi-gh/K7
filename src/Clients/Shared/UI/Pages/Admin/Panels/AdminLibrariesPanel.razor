@page "/admin/libraries"
@layout AdminLayout
@using K7.Shared.Dtos.Entities
@implements IDisposable
@inject IStringLocalizer<AdminLibrariesPanel> L
@inject IStringLocalizer<SharedResource> S

<BrowseView TItem="LibraryDto"
            Items="_libraryItems"
            Loading="_isLoading"
            DefaultItemWidth="560"
            DefaultSpacing="16"
            GridItemAspectRatio="null"
            SingleColumnOnMobile="true"
            ShowBackToTop="false"
            PersistenceKey="admin-libraries">
    <ToolbarContent>
        <AdminPageHeader Title="@L["Title"]" Subtitle="@L["Subtitle"]">
            <Actions>
                <K7Button Variant="filled" Color="primary" StartIcon="@Phosphor.Plus" OnClick="OpenCreateDialog">
                    @L["NewLibrary"]
                </K7Button>
            </Actions>
        </AdminPageHeader>
    </ToolbarContent>
    <GridTemplate Context="library">
        <K7Paper Outlined="true" Elevation="0" Class="admin-entity-card">
            <div class="library-card">
            <div class="library-card__header">
                <K7Icon Icon="@GetMediaTypeIcon(library.MediaType)" IconSize="@K7IconSize.Sm" Color="primary" Class="library-card__icon" />
                <span class="library-card__name">@library.Title</span>
                <K7Chip Size="sm" Color="default" Class="library-card__type">@GetMediaTypeLabel(library.MediaType)</K7Chip>
            </div>
            <div class="library-card__path">
                @if (library.PeerServerBaseUrl is not null)
                {
                    <K7Icon Icon="@Phosphor.Globe" IconSize="@K7IconSize.Sm" />
                    <span>@library.PeerServerBaseUrl</span>
                }
                else
                {
                    <K7Icon Icon="@Phosphor.Folder" IconSize="@K7IconSize.Sm" />
                    <span>@library.RootPath</span>
                }
            </div>
            @{
                var stats = GetStats(library.Id);
            }
            @if (stats is not null)
            {
                <div class="library-card__stats">
                    <K7Chip Size="sm">@stats.FileCount @L["StatFiles"]</K7Chip>
                    @foreach (var entry in GetOrderedMediaCounts(library.Id))
                    {
                        <K7Chip Size="sm">@entry.Value @GetMediaTypeCountLabel(entry.Key)</K7Chip>
                    }
                </div>
            }
            @{
                var issueCount = GetIssueCount(library.Id);
            }
            @if (issueCount > 0)
            {
                <K7Chip Size="sm" Color="warning" Class="library-card__issues" OnClick="@(() => NavigateToDiagnostics(library.Id))">
                    <K7Icon Icon="@Phosphor.Warning" IconSize="@K7IconSize.Sm" />
                    @string.Format(L["IssueCount"], issueCount)
                </K7Chip>
            }
            @if (GetScanProgress(library.Id) is { } scanProgress)
            {
                <div class="library-card__scan-progress">
                    <span class="library-card__scan-label">@FormatScanProgress(scanProgress)</span>
                    @if (scanProgress.Total > 0)
                    {
                        <K7ProgressBar Value="@GetScanProgressValue(scanProgress)" />
                    }
                    else
                    {
                        <K7ProgressBar Indeterminate="true" />
                    }
                </div>
            }
            <div class="library-card__actions admin-entity-card__footer">
                <K7Button Variant="text" Size="sm" StartIcon="@Phosphor.Pencil" OnClick="@(() => OpenEditDialog(library))">@L["AriaEdit"]</K7Button>
                @if (library.PeerServerId is null)
                {
                    <K7Button Variant="text" Size="sm" Color="error" StartIcon="@Phosphor.Trash" OnClick="@(() => DeleteLibrary(library))">@L["AriaDelete"]</K7Button>
                }
                <K7Menu>
                    <ActivatorContent>
                        <K7IconButton Icon="@Phosphor.DotsThreeVertical" Size="sm" AriaLabel="@L["MoreActions"]" />
                    </ActivatorContent>
                    <ChildContent>
                        @if (library.PeerServerId is null)
                        {
                            <K7MenuItem Icon="@Phosphor.ArrowClockwise" OnClick="@(() => IndexLibrary(library))">@L["AriaIndex"]</K7MenuItem>
                            <K7MenuItem Icon="@Phosphor.MagnifyingGlass" OnClick="@(() => RematchLibrary(library))">@L["AriaRematch"]</K7MenuItem>
                            <K7MenuItem Icon="@Phosphor.ArrowsClockwise" OnClick="@(() => RefreshLibraryMetadata(library))">@L["AriaRefreshMetadata"]</K7MenuItem>
                        }
                        <K7MenuItem Icon="@Phosphor.Users" OnClick="@(() => OpenUsersDialog(library))">@L["AriaUserAccess"]</K7MenuItem>
                    </ChildContent>
                </K7Menu>
            </div>
            </div>
        </K7Paper>
    </GridTemplate>
    <EmptyContent>
        <K7EmptyState Icon="@Phosphor.VideoCamera" Title="@L["Empty"]" Subtitle="@L["EmptyDescription"]" />
    </EmptyContent>
</BrowseView>
