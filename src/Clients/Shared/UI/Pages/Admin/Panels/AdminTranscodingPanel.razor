@page "/admin/advanced"
@page "/admin/advanced/transcoding"
@page "/admin/transcoding"
@layout AdminLayout
@inject IStringLocalizer<AdminTranscodingPanel> L
@inject ITranscodeAdminService TranscodeAdmin
@inject IK7Snackbar Snackbar

<PageTitle>@L["Title"]</PageTitle>

<AdvancedSettingsSplit Section="@AdvancedSettingsSplit.Transcoding">
<div class="transcoding-panel">
    <p class="settings-field-hint">@L["Subtitle"]</p>

    @if (_loading)
    {
        <K7Paper Outlined="true" Elevation="0" Class="admin-surface-card transcoding-panel__card transcoding-panel__card--loading">
            <K7Spinner />
        </K7Paper>
    }
    else if (_settings is not null)
    {
        <K7Paper Outlined="true" Elevation="0" Class="admin-surface-card transcoding-panel__card">
            <div class="d-flex flex-col gap-4">
                <div>
                    <K7SettingRow Label="@L["EncoderMode"]">
                        <K7Select TValue="HardwareEncoderMode" Value="_settings.EncoderMode" ValueChanged="OnEncoderModeChanged" Variant="outlined">
                            <K7SelectItem Value="HardwareEncoderMode.Auto" Text="@L["EncoderAuto"]">@L["EncoderAuto"]</K7SelectItem>
                            <K7SelectItem Value="HardwareEncoderMode.Software" Text="@L["EncoderSoftware"]">@L["EncoderSoftware"]</K7SelectItem>
                            <K7SelectItem Value="HardwareEncoderMode.HardwarePreferred" Text="@L["EncoderHardwarePreferred"]">@L["EncoderHardwarePreferred"]</K7SelectItem>
                        </K7Select>
                    </K7SettingRow>

                    <K7SettingRow Label="@L["EnableHdrTonemap"]">
                        <K7Switch AriaLabel="@L["EnableHdrTonemap"]" Value="_settings.EnableHdrTonemap" ValueChanged="v => _settings = _settings with { EnableHdrTonemap = v }" />
                    </K7SettingRow>

                    <K7SettingRow Label="@L["MaxConcurrentTranscodes"]" Hint="@L["MaxConcurrentTranscodesHint"]">
                        <K7TextField TValue="int" aria-label="@L["MaxConcurrentTranscodes"]" Value="_settings.MaxConcurrentTranscodes" ValueChanged="v => _settings = _settings with { MaxConcurrentTranscodes = v }" Type="number" />
                    </K7SettingRow>

                    <K7SettingRow Label="@L["TranscodeTempQuotaMb"]" Hint="@L["TranscodeTempQuotaMbHint"]">
                        <K7TextField TValue="int" aria-label="@L["TranscodeTempQuotaMb"]" Value="_settings.TranscodeTempQuotaMb" ValueChanged="v => _settings = _settings with { TranscodeTempQuotaMb = v }" Type="number" />
                    </K7SettingRow>

                    <K7SettingRow Label="@L["EncoderThrottleBufferSegments"]" Hint="@L["EncoderThrottleBufferSegmentsHint"]">
                        <K7TextField TValue="int" aria-label="@L["EncoderThrottleBufferSegments"]" Value="_settings.EncoderThrottleBufferSegments" ValueChanged="v => _settings = _settings with { EncoderThrottleBufferSegments = v }" Type="number" />
                    </K7SettingRow>
                </div>

                <div class="d-flex align-center gap-2">
                    <K7Button Color="primary" OnClick="SaveAsync" Disabled="_saving">@L["Save"]</K7Button>
                    <K7Button OnClick="TestEncoderAsync" Variant="K7ButtonVariant.Outlined" Disabled="_testing">@L["TestEncoder"]</K7Button>
                    @if (_testing)
                    {
                        <K7Spinner Size="20" />
                    }
                </div>
            </div>
        </K7Paper>

        @if (_capabilities is not null)
        {
            <K7Paper Outlined="true" Elevation="0" Class="admin-surface-card transcoding-panel__card">
                <h6>@L["CapabilitiesTitle"]</h6>
                <p class="text-caption transcoding-panel__hint">@L["FfmpegVersion"]: @(_capabilities.FfmpegVersion ?? "-")</p>
                @if (_capabilities.AvailableHardwareEncoders.Count > 0)
                {
                    <p>@L["HardwareEncoders"]: @string.Join(", ", _capabilities.AvailableHardwareEncoders)</p>
                }
                else
                {
                    <p>@L["NoHardwareEncoders"]</p>
                }
            </K7Paper>
        }

        @if (_testResult is not null)
        {
            <K7Paper Outlined="true" Elevation="0" Class="admin-surface-card transcoding-panel__card">
                @if (_testResult.Success)
                {
                    <span class="transcoding-panel__test transcoding-panel__test--ok">@L["TestSuccess"] @_testResult.SelectedEncoder (@(_testResult.IsHardwareAccelerated ? L["Hardware"] : L["Software"]))</span>
                }
                else
                {
                    <span class="transcoding-panel__test transcoding-panel__test--error">@L["TestFailed"]: @_testResult.Error</span>
                }
            </K7Paper>
        }
    }
</div>
</AdvancedSettingsSplit>
