@page "/admin/library-groups"
@page "/admin/library-groups/{GroupId:guid}"
@layout AdminLayout
@using K7.Server.Domain.Enums
@using K7.Shared.Dtos.Entities
@inject IStringLocalizer<AdminLibraryGroupsPanel> L
@inject IStringLocalizer<SharedResource> S

@* List on the left, the selected group's sheet on the right. Narrow screens and TV show the
   list, then the sheet as its own screen (same shell as the users page). *@
<div class="library-groups-page" aria-live="polite">
    @if (_isLoading)
    {
        <div class="admin-page-intro">
            <AdminPageHeader Title="@L["Title"]" Subtitle="@L["Subtitle"]" />
        </div>
        <K7ProgressBar Indeterminate="true" />
    }
    else if (Groups.Count == 0)
    {
        <div class="admin-page-intro">
            <AdminPageHeader Title="@L["Title"]" Subtitle="@L["Subtitle"]" />
        </div>
        <K7EmptyState Icon="@Phosphor.Folders" Title="@L["Empty"]" Subtitle="@L["EmptyDescription"]">
            <ActionContent>
                <K7Button Variant="filled" Color="primary" StartIcon="@Phosphor.Plus" OnClick="GoToLibraries">
                    @L["CreateLibrary"]
                </K7Button>
            </ActionContent>
        </K7EmptyState>
    }
    else
    {
        var selectedGroup = SelectedGroup;

        <K7SettingsSplit IndexLabel="@L["Title"]"
                         WideIndex="true"
                         DetailTitle="@(selectedGroup?.Title ?? "")"
                         BackHref="@BasePath"
                         DetailOpen="IsGroupOpen">
            <Header>
                <div class="admin-page-intro">
                    <AdminPageHeader Title="@L["Title"]" Subtitle="@L["Subtitle"]">
                        <Actions>
                            <K7ResultCount Count="Groups.Count" />
                        </Actions>
                    </AdminPageHeader>
                </div>
            </Header>
            <Index>
                @foreach (var group in Groups)
                {
                    <K7EntityRow @key="group.Id"
                                 Title="@group.Title"
                                 Subtitle="@GetLibrariesSummary(group)"
                                 Href="@($"{BasePath}/{group.Id}")"
                                 Active="@(group.Id == selectedGroup?.Id)"
                                 Dimmed="@(group.LibraryIds.Count == 0)">
                        <Leading>
                            <K7Icon Icon="@GetGroupIcon(group)" IconSize="@K7IconSize.Md" />
                        </Leading>
                        <Trailing>
                            <K7Chip Size="sm" Color="default">@GetMediaTypeLabel(group.MediaType)</K7Chip>
                            @if (group.ExploreTapAction == ExploreTapAction.Browse)
                            {
                                <K7Chip Size="sm" Color="default">@L["TapActionBrowse"]</K7Chip>
                            }
                        </Trailing>
                    </K7EntityRow>
                }
            </Index>
            <Detail>
                @if (selectedGroup is not null)
                {
                    var group = selectedGroup;
                    var libraries = GetLibraries(group);

                    var cardColors = LibraryGroupCardColors.GetRgbaColors(group.MediaType, group.CardColor);

                    @* The card as users see it in Explore, before any edit. *@
                    <div class="group-sheet__preview">
                        <K7CategoryCard Title="@group.Title"
                                        Description="@(group.Description ?? "")"
                                        Icon="@GetGroupIcon(group)"
                                        GradientStart="@cardColors.GradientStart"
                                        IconColor="@cardColors.IconColor"
                                        ImageUrl="@GetCoverUrl(group)"
                                        CardColor="@(group.CardColor ?? LibraryGroupCardColors.GetDefaultHex(group.MediaType))" />
                    </div>

                    <div>
                        <K7SettingRow Label="@L["FieldType"]">
                            <K7Chip Size="sm" Color="default">@GetMediaTypeLabel(group.MediaType)</K7Chip>
                        </K7SettingRow>
                        <K7SettingRow Label="@L["FieldTapAction"]" Hint="@L["FieldTapActionHint"]">
                            <span class="group-sheet__value">@GetTapActionLabel(group.ExploreTapAction)</span>
                        </K7SettingRow>
                    </div>

                    <h6 class="group-sheet__heading">@L["FieldLibraries"]</h6>
                    @if (libraries.Count == 0)
                    {
                        <p class="group-sheet__value">@L["NoLibraries"]</p>
                    }
                    else
                    {
                        <div class="group-sheet__actions">
                            @foreach (var library in libraries)
                            {
                                <K7EntityRow @key="library.Id"
                                             Title="@library.Title"
                                             Subtitle="@GetMediaTypeLabel(library.MediaType)"
                                             Href="@($"/admin/libraries/{library.Id}")">
                                    <Leading>
                                        <K7Icon Icon="@GetMediaTypeIcon(library.MediaType)" IconSize="@K7IconSize.Md" />
                                    </Leading>
                                </K7EntityRow>
                            }
                        </div>
                    }

                    <h6 class="group-sheet__heading">@L["SectionActions"]</h6>
                    <div class="group-sheet__actions">
                        <K7SheetAction Icon="@Phosphor.PencilSimple" Label="@L["ActionEdit"]" OnClick="@(() => OpenEditDialog(group))" />
                        <K7SheetAction Icon="@Phosphor.Trash" Label="@L["ActionDelete"]" Badges="GetLibraryBadges(group)" Danger="true" OnClick="@(() => ConfirmDelete(group))" />
                    </div>
                }
            </Detail>
        </K7SettingsSplit>
    }
</div>
