@page "/admin/devices"
@layout AdminLayout
@using K7.Clients.Shared.Enums
@using K7.Shared.Dtos.Devices
@inject IStringLocalizer<AdminDevicesPanel> L
@inject IStringLocalizer<SharedResource> S

<div class="admin-devices-page">
<BrowseView TItem="DeviceDto" Items="_deviceItems" Loading="_isLoading" Class="admin-devices-browse"
            DefaultMode="BrowseViewMode.List" ListItemHeight="152" ShowBackToTop="false">
    <ToolbarContent>
        <AdminPageHeader Title="@(_selectionMode ? string.Format(L["SelectedCount"], SelectedCount) : L["Title"])"
                         Subtitle="@L["Subtitle"]">
            <Actions>
                @if (_selectionMode)
                {
                    <K7Button Variant="text" OnClick="ToggleSelectAll" Disabled="@(_deviceItems.Count == 0 || _deleting)">
                        @(AllSelected ? L["DeselectAll"] : L["SelectAll"])
                    </K7Button>
                    <K7Button Variant="filled"
                              Color="error"
                              StartIcon="@Phosphor.Trash"
                              OnClick="ConfirmDeleteSelectedAsync"
                              Disabled="@(SelectedCount == 0 || _deleting)"
                              AriaLabel="@L["DeleteSelected"]">
                        @L["DeleteSelected"]
                    </K7Button>
                    <K7Button Variant="text" OnClick="ExitSelectionMode" Disabled="@_deleting" AriaLabel="@S["Cancel"]">
                        @S["Cancel"]
                    </K7Button>
                }
                else
                {
                    @if (_devices?.TotalCount is int deviceCount)
                    {
                        <K7ResultCount Count="deviceCount" />
                    }
                    <K7IconButton Icon="@Phosphor.ListChecks"
                                  OnClick="EnterSelectionMode"
                                  Disabled="@(_deviceItems.Count == 0)"
                                  AriaLabel="@L["Select"]" />
                }
            </Actions>
        </AdminPageHeader>
    </ToolbarContent>
    <EmptyContent>
        <K7Paper Class="d-flex flex-col pa-8">
            <K7Icon Icon="@Phosphor.MonitorPlay" IconSize="@K7IconSize.Lg" Color="secondary" />
            <p Color="secondary">@L["NoDevices"]</p>
        </K7Paper>
    </EmptyContent>
    <ListTemplate Context="device">
        @{
            var isCurrent = IsCurrentDevice(device);
            var isFocused = device.Id == _focusedDeviceId;
            var selected = IsSelected(device.Id);
        }
        <div class="device-list-item">
            @if (_selectionMode)
            {
                <button type="button"
                        class="device-select-item focusable @(selected ? "is-selected" : null)"
                        @onclick="@(() => ToggleSelection(device.Id))">
                    <span class="device-select-item__check" aria-hidden="true">
                        <K7Icon Icon="@(selected ? Phosphor.Fill.CheckCircle : Phosphor.Circle)" IconSize="@K7IconSize.Md" />
                    </span>
                    <K7Paper id="@($"device-{device.Id}")" Outlined="true" Elevation="0" Class="@($"{GetDeviceClass(isCurrent, isFocused)} device-card-paper admin-entity-card")">
                        <div class="device-card">
                            <div class="device-card__header">
                                <K7Icon Icon="@GetDeviceIcon(device.DeviceType)" IconSize="@K7IconSize.Sm" Color="@(isCurrent ? "primary" : "default")" Class="device-card__icon" />
                                <span class="device-card__name">@(device.DeviceName ?? L["UnknownDevice"])</span>
                                @if (device.Users.Count > 0)
                                {
                                    <K7Chip Size="sm" Class="device-card__users">@string.Format(L["UserCount"], device.Users.Count)</K7Chip>
                                }
                                @if (isCurrent)
                                {
                                    <K7Chip Size="sm" Variant="filled" Color="primary" Class="device-card__current">@L["ThisDevice"]</K7Chip>
                                }
                            </div>
                            <div class="device-card__facts">
                                @foreach (var fact in GetDeviceFacts(device))
                                {
                                    <K7Chip Size="sm">@fact</K7Chip>
                                }
                            </div>
                            <div class="device-card__footer admin-entity-card__footer">
                                <span class="device-card__lastseen">@L["LastSeen"] @device.LastSeen.LocalDateTime.ToString("g")</span>
                            </div>
                        </div>
                    </K7Paper>
                </button>
            }
            else
            {
                <K7Paper id="@($"device-{device.Id}")" Outlined="true" Elevation="0" Class="@($"{GetDeviceClass(isCurrent, isFocused)} device-card-paper admin-entity-card")">
                    <div class="device-card">
                        <div class="device-card__header">
                            <K7Icon Icon="@GetDeviceIcon(device.DeviceType)" IconSize="@K7IconSize.Sm" Color="@(isCurrent ? "primary" : "default")" Class="device-card__icon" />
                            <span class="device-card__name">@(device.DeviceName ?? L["UnknownDevice"])</span>
                            @if (device.Users.Count > 0)
                            {
                                <K7Chip Size="sm" Class="device-card__users">@string.Format(L["UserCount"], device.Users.Count)</K7Chip>
                            }
                            @if (isCurrent)
                            {
                                <K7Chip Size="sm" Variant="filled" Color="primary" Class="device-card__current">@L["ThisDevice"]</K7Chip>
                            }
                        </div>
                        <div class="device-card__facts">
                            @foreach (var fact in GetDeviceFacts(device))
                            {
                                <K7Chip Size="sm">@fact</K7Chip>
                            }
                        </div>
                        <div class="device-card__footer admin-entity-card__footer">
                            <span class="device-card__lastseen">@L["LastSeen"] @device.LastSeen.LocalDateTime.ToString("g")</span>
                            <K7Button Variant="text" Size="sm" Color="error" StartIcon="@Phosphor.Trash" OnClick="@(() => DeleteDeviceAsync(device))">@L["DeleteDevice"]</K7Button>
                        </div>
                    </div>
                </K7Paper>
            }
        </div>
    </ListTemplate>
</BrowseView>
</div>
