@page "/admin/devices"
@page "/admin/devices/{DeviceId:guid}"
@layout AdminLayout
@using K7.Shared.Dtos.Devices
@inject IStringLocalizer<AdminDevicesPanel> L
@inject IStringLocalizer<SharedResource> S

@* List on the left, the selected device's sheet on the right. Narrow screens and TV show the list,
   then the sheet as its own screen (same shell as the settings pages). *@
<div class="devices-page" aria-live="polite">
    @if (_isLoading)
    {
        <div class="admin-page-intro">
            <AdminPageHeader Title="@L["Title"]" Subtitle="@L["Subtitle"]" />
        </div>
        <K7ProgressBar Indeterminate="true" />
    }
    else
    {
        var selectedDevice = SelectedDevice;
        var filteredDevices = FilteredDevices;

        <K7SettingsSplit IndexLabel="@L["Title"]"
                         WideIndex="true"
                         DetailTitle="@(selectedDevice is null ? "" : GetDeviceName(selectedDevice))"
                         BackHref="@BasePath"
                         DetailOpen="IsDeviceOpen">
            <Header>
                <div class="admin-page-intro">
                    <AdminPageHeader Title="@(_selectionMode ? string.Format(L["SelectedCount"], SelectedCount) : L["Title"])"
                                     Subtitle="@L["Subtitle"]">
                        <Actions>
                            @if (_selectionMode)
                            {
                                <K7Button Variant="text" OnClick="ToggleSelectAll" Disabled="@(_deviceItems.Count == 0 || _deleting)">
                                    @(AllSelected ? L["DeselectAll"] : L["SelectAll"])
                                </K7Button>
                                <K7Button Variant="filled"
                                          Color="error"
                                          StartIcon="@Phosphor.Trash"
                                          OnClick="ConfirmDeleteSelectedAsync"
                                          Disabled="@(SelectedCount == 0 || _deleting)"
                                          AriaLabel="@L["DeleteSelected"]">
                                    @L["DeleteSelected"]
                                </K7Button>
                                <K7Button Variant="text" OnClick="ExitSelectionMode" Disabled="@_deleting" AriaLabel="@S["Cancel"]">
                                    @S["Cancel"]
                                </K7Button>
                            }
                            else
                            {
                                @if (_devices?.TotalCount is int deviceCount)
                                {
                                    <K7ResultCount Count="deviceCount" />
                                }
                                <K7IconButton Icon="@Phosphor.ListChecks"
                                              OnClick="EnterSelectionMode"
                                              Disabled="@(_deviceItems.Count == 0)"
                                              AriaLabel="@L["Select"]" />
                            }
                        </Actions>
                    </AdminPageHeader>
                </div>
            </Header>
            <Index>
                <K7TextField TValue="string"
                             Value="@_search"
                             ValueChanged="@(value => _search = value ?? "")"
                             Immediate="true"
                             Placeholder="@L["SearchPlaceholder"]"
                             AdornmentIcon="@Phosphor.MagnifyingGlass"
                             Class="devices-search" />

                @if (_deviceItems.Count == 0)
                {
                    <p class="devices-list-empty">@L["NoDevices"]</p>
                }
                else if (filteredDevices.Count == 0)
                {
                    <p class="devices-list-empty">@L["NoMatch"]</p>
                }

                @foreach (var device in filteredDevices)
                {
                    var isCurrent = IsCurrentDevice(device);
                    var selected = IsSelected(device.Id);
                    <K7EntityRow @key="device.Id"
                                 Id="@($"device-{device.Id}")"
                                 Title="@GetDeviceName(device)"
                                 Subtitle="@GetRowSummary(device)"
                                 Href="@($"{BasePath}/{device.Id}")"
                                 OnClick="@(_selectionMode ? EventCallback.Factory.Create(this, () => ToggleSelection(device.Id)) : default)"
                                 Disabled="@(_selectionMode && _deleting)"
                                 Checked="@(_selectionMode ? selected : null)"
                                 Active="@(!_selectionMode && device.Id == selectedDevice?.Id)"
                                 Highlighted="@(device.Id == _focusedDeviceId)">
                        <Leading>
                            <K7Icon Icon="@GetDeviceIcon(device.DeviceType)" IconSize="@K7IconSize.Md" Color="@(isCurrent ? "primary" : "default")" />
                        </Leading>
                        <Trailing>
                            @if (isCurrent)
                            {
                                <K7Chip Size="sm" Variant="filled" Color="primary">@L["ThisDevice"]</K7Chip>
                            }
                        </Trailing>
                    </K7EntityRow>
                }
            </Index>
            <Detail>
                @if (selectedDevice is null)
                {
                    <p class="devices-list-empty">@L["NoDevices"]</p>
                }
                else
                {
                    var device = selectedDevice;
                    var isCurrent = IsCurrentDevice(device);
                    var system = GetSystemLabel(device);
                    var screen = GetScreenLabel(device);

                    <div class="device-sheet__identity">
                        <K7Icon Icon="@GetDeviceIcon(device.DeviceType)" IconSize="@K7IconSize.Lg" Color="@(isCurrent ? "primary" : "default")" />
                        <div class="device-sheet__identity-text">
                            <span class="device-sheet__type">@GetDeviceTypeLabel(device.DeviceType)</span>
                            <span class="device-sheet__lastseen">@L["LastSeen"] @device.LastSeen.LocalDateTime.ToString("g")</span>
                        </div>
                        @if (isCurrent)
                        {
                            <K7Chip Size="sm" Variant="filled" Color="primary">@L["ThisDevice"]</K7Chip>
                        }
                    </div>

                    <div>
                        <K7SettingRow Label="@L["FieldClient"]">
                            <span class="device-sheet__value">@GetClientTypeLabel(device.ClientType)</span>
                        </K7SettingRow>
                        @if (device.WebDeviceDetails is not null)
                        {
                            <K7SettingRow Label="@L["FieldBrowser"]">
                                <span class="device-sheet__value">@GetBrowserLabel(device.WebDeviceDetails.Browser)</span>
                            </K7SettingRow>
                        }
                        @if (system is not null)
                        {
                            <K7SettingRow Label="@L["FieldSystem"]">
                                <span class="device-sheet__value">@system</span>
                            </K7SettingRow>
                        }
                        @if (screen is not null)
                        {
                            <K7SettingRow Label="@L["FieldScreen"]">
                                <span class="device-sheet__value">@screen</span>
                            </K7SettingRow>
                        }
                        <K7SettingRow Label="@L["FieldUsers"]">
                            <span class="device-sheet__value">@(device.Users.Count == 0 ? "-" : GetUserNames(device))</span>
                        </K7SettingRow>
                    </div>

                    <div class="device-sheet__actions">
                        <K7SheetAction Icon="@Phosphor.Trash"
                                       Label="@L["DeleteDevice"]"
                                       Danger="true"
                                       Disabled="@_deleting"
                                       OnClick="@(() => DeleteDeviceAsync(device))" />
                    </div>
                }
            </Detail>
        </K7SettingsSplit>
    }
</div>
