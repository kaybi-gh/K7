@page "/admin/home-layout"
@layout AdminLayout
@inject IStringLocalizer<AdminHomeLayoutPanel> L
@inject IStringLocalizer<SharedResource> S

@if (_isLoading)
{
    <K7ProgressBar Indeterminate="true" />
}
else
{
    <div class="settings-form-page">
        <div class="settings-form-page__body d-flex flex-col pa-4 gap-4">
            <div class="d-flex align-center justify-between">
                <div>
                    <h6 class="mb-1">@L["PageTitle"]</h6>
                    <p class="text-sm" Color="secondary">@L["Description"]</p>
                </div>
                <K7Button Color="primary" Variant="outlined" StartIcon="@Phosphor.Plus"
                          OnClick="AddRow" Disabled="_saving">
                    @L["AddRow"]
                </K7Button>
            </div>

            <K7SortableList TItem="HomeRowEditModel"
                            Items="_rows"
                            ItemKey="@(row => row.Id)"
                            Disabled="_saving"
                            Reordered="RenumberRows">
                <span class="text-sm">@GetRowTitle(context.Title)</span>
                <div class="d-flex align-center gap-1">
                    <K7Switch Value="@context.IsVisible" ValueChanged="@(v => OnRowVisibilityChanged(context, v))" />
                    <K7IconButton Icon="@Phosphor.PencilSimple" OnClick="() => EditRow(context)"
                            AriaLabel="@L["EditRow"]" />
                    <K7IconButton Icon="@Phosphor.Trash" OnClick="() => DeleteRow(context)"
                            AriaLabel="@L["DeleteRow"]" />
                </div>
            </K7SortableList>

            <K7ExpansionPanel>
                <TitleContent>@L["PreviewTitle"]</TitleContent>
                <ChildContent>
                    <div class="d-flex justify-end mb-2">
                        <K7Button Color="secondary" Variant="text" StartIcon="@Phosphor.ArrowClockwise"
                                  OnClick="RefreshPreviewAsync" Disabled="_previewLoading">
                            @L["PreviewRefresh"]
                        </K7Button>
                    </div>
                    <HomeLayoutPreview @ref="_preview" Rows="_rows" />
                </ChildContent>
            </K7ExpansionPanel>
        </div>

        <K7SettingsActionBar IsDirty="IsDirty"
                             IsSaving="_saving"
                             ResetDisabled="ResetDisabled"
                             OnSave="SaveLayout"
                             OnCancel="CancelChanges"
                             OnResetToDefaults="ResetLayout" />
    </div>
}
