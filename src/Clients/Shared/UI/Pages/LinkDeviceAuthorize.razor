@page "/link"
@layout EmptyLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IStringLocalizer<LinkDeviceAuthorize> L

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="link-device">
    <div class="link-device__card">
        <div class="link-device__header">
            <i class="ph ph-devices link-device__icon"></i>
            <h2 class="link-device__title">@L["Title"]</h2>
        </div>

        @if (_approved)
        {
            <div class="link-device__alert link-device__alert--success">@L["DeviceAuthorized"]</div>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="link-device__alert link-device__alert--error">@GetErrorMessage()</div>
        }

        @if (!_approved)
        {
            <p class="link-device__hint">@L["EnterCode"]</p>
            <hr class="k7-divider" />

            <form @ref="_formRef" method="post" action="/connect/verify" id="link-form" data-enhance="false">
                <input @ref="_hiddenRef" type="hidden" name="user_code" id="user-code-hidden" value="@_userCode" />
                <div class="link-device__form">
                    <div class="link-device__code-row">
                        <input @ref="_segment0Ref" type="text" class="code-segment link-device__segment" data-idx="0" maxlength="4" inputmode="numeric" autocomplete="off" aria-label="@L["CodePart1"]" />
                        <span class="link-device__separator">-</span>
                        <input @ref="_segment1Ref" type="text" class="code-segment link-device__segment" data-idx="1" maxlength="4" inputmode="numeric" autocomplete="off" aria-label="@L["CodePart2"]" />
                        <span class="link-device__separator">-</span>
                        <input @ref="_segment2Ref" type="text" class="code-segment link-device__segment" data-idx="2" maxlength="4" inputmode="numeric" autocomplete="off" aria-label="@L["CodePart3"]" />
                    </div>

                    @* Only guardians see this choice. The radio value is posted as the account the
                       session is opened for. Empty means the signed-in user. *@
                    @if (_managedAccounts.Count > 0)
                    {
                        <fieldset class="link-device__accounts">
                            <legend class="link-device__legend">@L["ChooseAccount"]</legend>
                            <label class="link-device__account">
                                <input type="radio" name="target_user_id" value=""
                                       checked="@(_targetUserId is null)"
                                       @onchange="@(() => SelectTarget(null))" />
                                <K7Avatar Size="sm" Letter="@GetLetter(L["Myself"].Value)" />
                                <span class="link-device__account-name">@L["Myself"]</span>
                            </label>
                            @foreach (var account in _managedAccounts)
                            {
                                <label class="link-device__account" @key="account.Id">
                                    <input type="radio" name="target_user_id" value="@account.Id"
                                           checked="@(_targetUserId == account.Id)"
                                           @onchange="@(() => SelectTarget(account.Id))" />
                                    <K7Avatar Size="sm" Image="@(account.AvatarUrl ?? "")"
                                              Letter="@GetLetter(GetName(account))"
                                              UserId="@account.Id" />
                                    <span class="link-device__account-name">@GetName(account)</span>
                                </label>
                            }
                        </fieldset>

                        @if (SelectedAccount is { HasPin: true } selected)
                        {
                            <div class="link-device__pin">
                                <label class="link-device__legend" for="link-device-pin">@string.Format(L["PinLabel"], GetName(selected))</label>
                                <input id="link-device-pin" name="pin" type="password" class="link-device__segment"
                                       maxlength="4" inputmode="numeric" pattern="[0-9]{4}" autocomplete="off" required />
                            </div>
                        }
                    }

                    @if (_linkProfiles.Count > 0)
                    {
                        <fieldset class="link-device__accounts">
                            <legend class="link-device__legend">@L["SharedProfiles"]</legend>
                            <p class="link-device__hint">@L["SharedProfilesHint"]</p>
                            @foreach (var profile in _linkProfiles)
                            {
                                <label class="link-device__account" @key="profile.Id">
                                    <input type="checkbox"
                                           name="shared_profile_id"
                                           value="@profile.Id"
                                           checked="@_selectedProfileIds.Contains(profile.Id)"
                                           @onchange="args => ToggleProfile(profile.Id, args)" />
                                    <K7Avatar Size="sm"
                                              Image="@(profile.AvatarUrl ?? "")"
                                              Letter="@GetLetter(profile.Name)" />
                                    <span class="link-device__account-name">@profile.Name</span>
                                    @if (profile.HasPin)
                                    {
                                        <K7Icon Icon="@Phosphor.Lock" IconSize="@K7IconSize.Sm" Color="secondary" />
                                    }
                                </label>
                            }
                        </fieldset>
                    }

                    <K7Button Type="submit" Class="link-device__authorize">@L["AuthorizeDevice"]</K7Button>
                </div>
            </form>
        }
    </div>
</div>
