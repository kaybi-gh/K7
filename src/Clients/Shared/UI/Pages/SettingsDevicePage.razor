@page "/settings/device"
@layout SettingsLayout
@using K7.Clients.Shared.Helpers
@using K7.Server.Domain.Enums
@inject IStringLocalizer<SettingsDevicePage> L
@inject IStringLocalizer<SharedResource> S

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="admin-page-intro">
    <AdminPageHeader Title="@L["PageTitle"]" Subtitle="@L["Subtitle"]" />
</div>

<div class="settings-form-page">
    <div class="settings-form-page__body device-page pa-4">
        <section class="device-section">
            <h6 class="device-section__title">@L["IdentitySection"]</h6>
            @if (!_infoLoaded)
            {
                <K7Spinner />
            }
            else
            {
                <div>
                    <K7SettingRow Label="@L["FormFactor"]">
                        <span class="device-value">@DeviceTypeDisplay</span>
                    </K7SettingRow>
                    <K7SettingRow Label="@L["Hdr"]">
                        <span class="device-value">@HdrDisplay</span>
                    </K7SettingRow>
                    <K7SettingRow Label="@L["ServerUrl"]" Hint="@_backendUrl">
                        @if (DeviceService.GetClientType() != ClientType.Web)
                        {
                            <K7Button Variant="outlined" OnClick="ChangeBackendUrl">@L["ChangeServer"]</K7Button>
                        }
                    </K7SettingRow>
                </div>
            }
        </section>

        <section class="device-section">
            <h6 class="device-section__title">@L["SupportedCodecs"]</h6>
            @if (_codecSummary is null)
            {
                <p class="device-hint">@L["LoadingCodecs"]</p>
            }
            else
            {
                <div>
                    @CodecRow(L["CodecContainers"], DeviceCodecDisplay.FormatContainers(_codecSummary))
                    @CodecRow(L["CodecVideo"], DeviceCodecDisplay.FormatVideo(_codecSummary))
                    @CodecRow(L["CodecAudio"], DeviceCodecDisplay.FormatAudio(_codecSummary))
                    @CodecRow(L["CodecSubtitles"], DeviceCodecDisplay.FormatSubtitles(_codecSummary))
                </div>
            }
        </section>

        <section class="device-section">
            <h6 class="device-section__title">@L["LocalDataSection"]</h6>
            <div>
                <K7SettingRow Label="@L["ClearAllPreferences"]" Hint="@L["LocalDataSectionHint"]">
                    <K7Button Variant="filled"
                              Color="error"
                              Disabled="_clearingPreferences"
                              OnClick="ClearAllPreferencesAsync">
                        @L["ClearAllPreferences"]
                    </K7Button>
                </K7SettingRow>
            </div>
        </section>
    </div>
</div>

@code {
    // One codec family per line: its name on the left, what the device decodes as chips.
    private RenderFragment CodecRow(string label, IReadOnlyCollection<string>? values) =>
        @<K7SettingRow Label="@label" Class="device-codec-row">
            <div class="device-codec-chips">
                @if (values is { Count: > 0 })
                {
                    @foreach (var value in values)
                    {
                        <K7Chip Size="sm" Variant="outlined" Text="@value" />
                    }
                }
                else
                {
                    <span class="device-hint">@L["Unavailable"]</span>
                }
            </div>
        </K7SettingRow>;
}
