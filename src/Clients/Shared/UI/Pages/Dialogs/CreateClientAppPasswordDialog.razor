@inject IStringLocalizer<CreateClientAppPasswordDialog> L

@if (_createdPassword is null)
{
    <div class="k7-dialog-content">
        <div class="d-flex flex-col mt-2 gap-4">
            <K7TextField @bind-Value="_name" Label="@L["PasswordName"]" Variant="outlined" Required="true" />
            <p class="text-caption" style="color: var(--color-text-muted);">@L["NameHint"]</p>
        </div>
    </div>
    <div class="k7-dialog-actions">
        <K7Button OnClick="Cancel">@L["Cancel"]</K7Button>
        <K7Button Color="primary" Variant="filled" OnClick="Submit"
                  Disabled="@(string.IsNullOrWhiteSpace(_name) || _isSubmitting)">
            @if (_isSubmitting)
            {
                <K7Spinner Size="sm" />
            }
            @L["Create"]
        </K7Button>
    </div>
}
else
{
    <div class="k7-dialog-content">
        <div class="d-flex flex-col mt-2 gap-4">
            <K7Alert Severity="K7Severity.Warning" Icon="@Phosphor.WarningCircle">@L["CopyWarning"]</K7Alert>
            <div class="d-flex align-center gap-2">
                <code style="word-break: break-all; flex: 1; padding: 12px; background: var(--color-surface-variant); border-radius: 6px;">@_createdPassword</code>
                <K7Button OnClick="CopyToClipboard" Variant="K7ButtonVariant.Outlined" StartIcon="@Phosphor.Clipboard">
                    @L["CopyToClipboard"]
                </K7Button>
            </div>
        </div>
    </div>
    <div class="k7-dialog-actions">
        <K7Button Color="primary" Variant="filled" OnClick="Close">@L["Done"]</K7Button>
    </div>
}
