@page "/settings/home-layout"
@layout SettingsLayout
@inject IStringLocalizer<Settings> L
@inject IStringLocalizer<SharedResource> S

<PageTitle>@L["HomePageTitle"]</PageTitle>

<h4 class="mb-4">@L["HomePageTitle"]</h4>

@if (_isLoading)
{
    <K7ProgressBar Indeterminate="true" />
}
else
{
    <div class="settings-form-page">
        <div class="settings-form-page__body d-flex flex-col gap-4">
            <p class="text-sm" Color="secondary">@L["HomePageDescription"]</p>

            <K7SortableList TItem="HomeRowEditModel"
                            Items="_rows"
                            ItemKey="@(row => row.Id)"
                            Disabled="_saving"
                            Reordered="RenumberRows">
                <span class="text-sm">@GetRowTitle(context.Title)</span>
                <K7Switch Value="@context.IsVisible" ValueChanged="@(v => OnRowVisibilityChanged(context, v))" />
            </K7SortableList>

            <K7ExpansionPanel>
                <TitleContent>@L["PreviewTitle"]</TitleContent>
                <ChildContent>
                    <div class="d-flex justify-end mb-2">
                        <K7Button Color="secondary" Variant="text" StartIcon="@Phosphor.ArrowClockwise"
                                  OnClick="RefreshPreviewAsync" Disabled="_previewLoading">
                            @L["PreviewRefresh"]
                        </K7Button>
                    </div>
                    <HomeLayoutPreview @ref="_preview" Rows="_rows" />
                </ChildContent>
            </K7ExpansionPanel>
        </div>

        <K7SettingsActionBar IsDirty="IsDirty"
                             IsSaving="_saving"
                             ResetDisabled="ResetDisabled"
                             OnSave="SaveLayout"
                             OnCancel="CancelChanges"
                             OnResetToDefaults="ResetLayout" />
    </div>
}
