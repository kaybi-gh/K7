@page "/settings/interface/home"
@page "/settings/home-layout"
@layout SettingsLayout
@inject IStringLocalizer<Settings> L
@inject IStringLocalizer<SharedResource> S

<PageTitle>@L["HomePageTitle"]</PageTitle>

<div class="settings-form-page settings-form-page--section-actions">
    <div class="settings-form-page__body">
        <InterfaceSettingsSplit Section="@InterfaceSettingsSections.Home">
            @if (_isLoading)
            {
                <K7ProgressBar Indeterminate="true" />
            }
            else
            {
                <div class="d-flex flex-col gap-4">
                    <p class="settings-field-hint">@L["HomePageDescription"]</p>

                    <HomeRowList Rows="_rows" OnChanged="StateHasChanged" />

                    <HomeLayoutPreview Rows="_rows" />
                </div>
            }
        </InterfaceSettingsSplit>
    </div>

    @if (!_isLoading)
    {
        <K7SettingsActionBar AutoSave="true"
                             SaveState="_autoSave.State"
                             IsSaving="_autoSave.IsBusy"
                             ResetDisabled="ResetDisabled"
                             OnResetToDefaults="ResetLayoutAsync" />
    }
</div>
