@page "/settings/account"
@layout SettingsLayout
@using System.Security.Claims
@inject IUserAdminService UserService
@inject IK7ServerService ApiClient
@inject ILocalUserService LocalUserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SettingsAccountPage> L
@inject IStringLocalizer<SharedResource> S
@inject IJSRuntime JSRuntime
@inject IK7DialogService DialogService
@inject IDeviceService DeviceService
@inject IK7Snackbar Snackbar

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="admin-page-intro">
    <AdminPageHeader Title="@L["PageTitle"]" Subtitle="@L["Subtitle"]" />
</div>

<div class="account-page pa-4">
    @if (!_isGuest)
    {
        @* ---- Profile: who you are ---- *@
        <section class="account-section">
            <h6 class="account-section__title">@L["SectionProfile"]</h6>

            <div class="account-identity">
                <K7Avatar Image="@_avatarUrl" Letter="@_avatarLetter" Size="xl" Alt="@_displayName" />
                <div class="account-identity__actions">
                    <K7Button Variant="outlined" OnClick="UploadAvatar">@L["UploadAvatar"]</K7Button>
                    @if (!string.IsNullOrEmpty(_avatarUrl))
                    {
                        <K7Button Variant="text" Color="error" OnClick="RemoveAvatar">@L["RemoveAvatar"]</K7Button>
                    }
                </div>
            </div>
            <InputFile id="@_avatarFileInputId" @ref="_fileInput" OnChange="OnFileSelected" accept="image/*" class="account-file-input" />
            @if (_avatarError is not null)
            {
                <K7Alert Severity="K7Severity.Error" Class="mt-2">@_avatarError</K7Alert>
            }

            <div>
                <K7SettingRow Label="@L["DisplayName"]">
                    <K7TextField @bind-Value="@_displayName" MaxLength="50" />
                    @if (_displayName != _originalDisplayName)
                    {
                        <K7Button Variant="outlined" OnClick="SaveDisplayName">@S["Save"]</K7Button>
                    }
                </K7SettingRow>
                @if (_profileSuccess is not null)
                {
                    <K7Alert Severity="K7Severity.Success" Class="mt-2">@_profileSuccess</K7Alert>
                }
                @if (_profileError is not null)
                {
                    <K7Alert Severity="K7Severity.Error" Class="mt-2">@_profileError</K7Alert>
                }

                @if (_hasPassword)
                {
                    <K7SettingRow Label="@L["Email"]" Hint="@L["EmailHelper"]">
                        <K7TextField @bind-Value="@_newEmail" />
                    </K7SettingRow>
                    @if ((_newEmail ?? "") != (_email ?? ""))
                    {
                        <K7SettingRow Label="@L["CurrentPassword"]">
                            <K7TextField @bind-Value="@_emailPassword" Type="password" />
                            <K7Button Variant="outlined" OnClick="SaveEmail">@S["Save"]</K7Button>
                        </K7SettingRow>
                    }
                    @if (_emailError is not null)
                    {
                        <K7Alert Severity="K7Severity.Error" Class="mt-2">@_emailError</K7Alert>
                    }
                    @if (_emailSuccess is not null)
                    {
                        <K7Alert Severity="K7Severity.Success" Class="mt-2">@_emailSuccess</K7Alert>
                    }
                }
            </div>
        </section>

        @* ---- Security: how you sign in ---- *@
        <section class="account-section">
            <h6 class="account-section__title">@L["SectionSecurity"]</h6>

            <div>
                @if (!_hasPassword && !_localSignInEnabled)
                {
                    <K7SettingRow Label="@L["Password"]" Hint="@L["LocalSignInDisabledNoPassword"]" />
                }
                else
                {
                    <K7SettingRow Label="@L["Password"]" Hint="@(_hasPassword ? L["PasswordSet"] : L["NoPasswordSet"])">
                        <K7Button Variant="outlined" OnClick="OpenPasswordDialog">
                            @(_hasPassword ? L["ChangePassword"] : L["SetPassword"])
                        </K7Button>
                    </K7SettingRow>
                }
                @if (_passwordError is not null)
                {
                    <K7Alert Severity="K7Severity.Error" Class="mt-2">@_passwordError</K7Alert>
                }
                @if (_passwordSuccess is not null)
                {
                    <K7Alert Severity="K7Severity.Success" Class="mt-2">@_passwordSuccess</K7Alert>
                }

                @if (_hasPassword)
                {
                    @if (_twoFactorEnabled)
                    {
                        <K7SettingRow Label="@L["TwoFactor"]"
                                      Hint="@($"{L["TwoFactorEnabled"]} {L["RecoveryCodesRemaining", _recoveryCodesLeft]}")">
                            <K7Button Variant="outlined" OnClick="GenerateRecoveryCodesAsync">@L["RegenerateRecoveryCodes"]</K7Button>
                            <K7Button Variant="text" Color="error" OnClick="DisableTwoFactorAsync">@L["DisableTwoFactor"]</K7Button>
                        </K7SettingRow>
                    }
                    else if (_twoFactorSetup is not null)
                    {
                        <K7SettingRow Label="@L["TwoFactor"]" Hint="@L["TwoFactorSetupPrompt"]" />
                        <div class="account-two-factor-setup">
                            <p class="account-hint">@L["SharedKey"]: <span class="recovery-code">@_twoFactorSetup.SharedKey</span></p>
                            <div id="two-factor-qr"></div>
                            <K7TextField @bind-Value="_verifyCode" Label="@L["VerificationCode"]" />
                            <div class="account-actions">
                                <K7Button Variant="filled" OnClick="VerifyTwoFactorSetupAsync">@L["VerifyAndEnable"]</K7Button>
                                <K7Button Variant="text" OnClick="CancelTwoFactorSetup">@S["Cancel"]</K7Button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <K7SettingRow Label="@L["TwoFactor"]" Hint="@L["TwoFactorDisabled"]">
                            <K7Button Variant="outlined" OnClick="BeginTwoFactorSetupAsync">@L["EnableTwoFactor"]</K7Button>
                        </K7SettingRow>
                    }

                    @if (_recoveryCodes.Count > 0)
                    {
                        <K7Alert Severity="K7Severity.Warning" Class="mt-3">@L["SaveRecoveryCodes"]</K7Alert>
                        <ul class="recovery-codes-list">
                            @foreach (var recoveryCode in _recoveryCodes)
                            {
                                <li><span class="recovery-code">@recoveryCode</span></li>
                            }
                        </ul>
                    }

                    @if (_twoFactorError is not null)
                    {
                        <K7Alert Severity="K7Severity.Error" Class="mt-2">@_twoFactorError</K7Alert>
                    }
                    @if (_twoFactorSuccess is not null)
                    {
                        <K7Alert Severity="K7Severity.Success" Class="mt-2">@_twoFactorSuccess</K7Alert>
                    }
                }

                <K7SettingRow Label="@L["Pin"]" Hint="@(_hasPin ? L["PinSet"] : L["PinNotSet"])">
                    @if (_hasPin)
                    {
                        <K7Button Variant="outlined" OnClick="ChangePin">@L["ChangePin"]</K7Button>
                        <K7Button Variant="text" Color="error" OnClick="RemovePin">@L["RemovePin"]</K7Button>
                    }
                    else
                    {
                        <K7Button Variant="outlined" OnClick="SetPin">@L["SetPin"]</K7Button>
                    }
                </K7SettingRow>
                @if (_pinError is not null)
                {
                    <K7Alert Severity="K7Severity.Error" Class="mt-2">@_pinError</K7Alert>
                }
                @if (_pinSuccess is not null)
                {
                    <K7Alert Severity="K7Severity.Success" Class="mt-2">@_pinSuccess</K7Alert>
                }
            </div>
        </section>

        @* ---- Linked sign-in providers ---- *@
        @if (_loginMethods is not null && (_loginMethods.ExternalLogins.Count > 0 || _canShowLinkOidc))
        {
            <section class="account-section">
                <h6 class="account-section__title">@L["LoginMethods"]</h6>

                <div>
                    @foreach (var login in _loginMethods.ExternalLogins)
                    {
                        <K7SettingRow Label="@(login.ProviderDisplayName ?? login.Provider)">
                            <K7Button Variant="text" Color="error"
                                      Disabled="@(!login.CanUnlink)"
                                      OnClick="@(() => UnlinkLogin(login.Provider))">
                                @L["Unlink"]
                            </K7Button>
                        </K7SettingRow>
                    }
                    @if (_canShowLinkOidc)
                    {
                        <K7SettingRow Label="@(_loginMethods.OidcDisplayName ?? "OIDC")"
                                      Hint="@(_loginMethods.ExternalLogins.Count == 0 ? L["NoExternalLogins"].Value : null)">
                            <K7Button Variant="outlined" OnClick="LinkOidcAsync">
                                @L["LinkOidc", _loginMethods.OidcDisplayName ?? "OIDC"]
                            </K7Button>
                        </K7SettingRow>
                    }
                </div>
                @if (_loginMethodsError is not null)
                {
                    <K7Alert Severity="K7Severity.Error" Class="mt-2">@_loginMethodsError</K7Alert>
                }
            </section>
        }

        @* ---- Danger zone ---- *@
        <section class="account-section">
            <h6 class="account-section__title account-section__title--danger">@L["DangerZone"]</h6>

            <div>
                <K7SettingRow Label="@L["DeleteAccount"]" Hint="@L["DeleteAccountWarning"]">
                    <K7Button Variant="filled" Color="error" OnClick="DeleteAccount">@L["DeleteAccount"]</K7Button>
                </K7SettingRow>
            </div>
            @if (_deleteError is not null)
            {
                <K7Alert Severity="K7Severity.Error" Class="mt-2">@_deleteError</K7Alert>
            }
        </section>
    }
</div>
