@using K7.Clients.Shared.UI.Helpers
@using K7.Shared.Dtos.Home
@inject IStringLocalizer<Home> L
@inject IStringLocalizer<SharedResource> S
<PageTitle>@L["PageTitle"]</PageTitle>

@if (_isTv is null)
{
    <div class="tv-feed-page home-page home-page--tv" aria-busy="true"></div>
}
else
{
    <div class="@(_isTv == true ? "tv-feed-page home-page home-page--tv" : "home-page page-scrollable")" data-initial-focus="@(_isTv == true && FeedStore.IsLoaded && !isLoading ? _homeFocusSelector : null)">
        @if (_isOffline)
        {
            <div class="home-offline-banner">
                <K7Icon Icon="@Phosphor.WifiSlash" Style="font-size: 48px; opacity: 0.4;" />
                <p class="home-offline-banner__title">@L["OfflineTitle"]</p>
                <p class="home-offline-banner__subtitle">@L["OfflineSubtitle"]</p>
                <K7Button Href="/my-space/downloads" Variant="filled" Color="primary">
                    @L["GoToDownloads"]
                </K7Button>
            </div>
        }
        else if (_isTv == true)
        {
            <CustomNavFeedRow />
            <HomeTvHero @ref="_tvHero" Model="_focusedItem" />
            <VerticalCarousel VirtualizeRows="true" InitialActiveIndex="_tvInitialRowIndex">
                @if (!FeedStore.IsLoaded || isLoading)
                {
                    @for (int i = 0; i < 3; i++)
                    {
                        <Carousel Skeleton="true">
                            @for (int j = 0; j < 10; j++)
                            {
                                <CarouselItem>
                                    <MediaCard Skeleton="true" FooterVisible="true" />
                                </CarouselItem>
                            }
                        </Carousel>
                    }
                }
                else
                {
                    var tvRows = GetVisibleRows().ToList();
                    @for (var rowIndex = 0; rowIndex < tvRows.Count; rowIndex++)
                    {
                        var row = tvRows[rowIndex];
                        <div @key="row.Config.Id">
                            <TvFeedRow Index="rowIndex">
                                @RenderCarousel(row.Config, row.Items, _canTrackProgress, _canTrackProgress, row.Config.ContinueWatching)
                            </TvFeedRow>
                        </div>
                    }
                }
            </VerticalCarousel>
        }
        else if (!FeedStore.IsLoaded || isLoading)
        {
            var skeletonRows = FeedStore.SkeletonRows;
            <CustomNavFeedRow />
            @if (skeletonRows.Count == 0)
            {
                @for (int i = 0; i < 3; i++)
                {
                    <Carousel Skeleton="true">
                        @for (int j = 0; j < 10; j++)
                        {
                            <CarouselItem>
                                <MediaCard Skeleton="true" FooterVisible="true" />
                            </CarouselItem>
                        }
                    </Carousel>
                }
            }
            else
            {
                @* The placeholders take the shape of the layout: a banner stays a banner, wide rows stay wide. *@
                @foreach (var row in skeletonRows)
                {
                    <div class="home-row" @key="row.Id">
                        @if (row.DisplayType.IsBanner())
                        {
                            <div class="home-hero-skeleton @(row.DisplayType == HomeRowDisplayType.FeaturedBleed ? "home-hero-skeleton--bleed" : "")" aria-hidden="true">
                                <K7Skeleton />
                            </div>
                        }
                        else
                        {
                            var variant = row.DisplayType == HomeRowDisplayType.Landscape ? MediaCardVariant.Backdrop : MediaCardVariant.Poster;
                            <Carousel Skeleton="true" Title="@GetRowTitle(row.Title)">
                                @for (int j = 0; j < 10; j++)
                                {
                                    <CarouselItem>
                                        <MediaCard Skeleton="true" Variant="variant" FooterVisible="true" />
                                    </CarouselItem>
                                }
                            </Carousel>
                        }
                    </div>
                }
            }
        }
        else
        {
            var hasAnyCarousel = GetVisibleRows().Any();

            <CustomNavFeedRow />
            @foreach (var row in GetVisibleRows())
            {
                <div class="home-row" @key="row.Config.Id">
                    @RenderCarousel(row.Config, row.Items, _canTrackProgress, _canTrackProgress, row.Config.ContinueWatching)
                </div>
            }

            @if (!hasAnyCarousel)
            {
                @RenderEmptyState()
            }
        }

        @if (_isTv == true && FeedStore.IsLoaded && !isLoading && !GetVisibleRows().Any() && !_isOffline)
        {
            @RenderEmptyState()
        }
    </div>
}

@{ RenderFragment RenderEmptyState()
{
    if (_isAdmin && !_hasConfiguredLibraries)
    {
        return @<K7EmptyState Icon="@Phosphor.Folders" Title="@L["SetupLibrariesTitle"]" Subtitle="@L["SetupLibrariesSubtitle"]">
            <ActionContent>
                <K7Button Variant="filled" Color="primary" StartIcon="@Phosphor.Plus" Href="/admin/libraries">
                    @L["SetupLibrariesAction"]
                </K7Button>
            </ActionContent>
        </K7EmptyState>;
    }

    return @<K7EmptyState Icon="@Phosphor.FilmSlate" Title="@L["EmptyStateTitle"]" Subtitle="@L["EmptyStateSubtitle"]" />;
}

RenderFragment RenderCarousel(HomeRowConfigDto row, List<MediaCardViewModel> items, bool progress, bool watched, bool continueWatching = false)
{
    // A featured row is a banner, except on TV (which has its own hero) or with nothing to feature.
    var featured = _isTv == false ? HomeRowDisplay.Featured(row.DisplayType, items, row.PageSize) : [];
    if (featured.Count > 0)
        return @<HomeHero Items="featured" Label="@GetRowTitle(row.Title)" Bleed="@(row.DisplayType == HomeRowDisplayType.FeaturedBleed)" AutoAdvanceSeconds="row.AutoAdvanceSeconds" HrefFor="GetHref" />;

    var carouselItems = HomeRowDisplay.Items(items);
    return @<Carousel Title="@GetRowTitle(row.Title)" ContentKey="@GetCarouselContentKey(carouselItems)">
        @for (var cardIndex = 0; cardIndex < carouselItems.Count; cardIndex++)
        {
            var item = carouselItems[cardIndex];
            <CarouselItem @key="item.Id" ItemId="@GetHomeCardId(item.Id)">
                <MediaCard Model="@item"
                           Variant="HomeRowDisplay.Variant(row.DisplayType, item)"
                           Href="@GetHref(item)"
                           OverlayEnabled="true"
                           ProgressEnabled="progress"
                           WatchedStatusEnabled="watched"
                           FooterVisible="true"
                           ExcludeMenuEnabled="_canExclude"
                           ContinueWatchingMenuEnabled="continueWatching && _canTrackProgress"
                           WatchStateMenuEnabled="_canSetWatchState"
                           IsAdmin="_isAdmin"
                           OnFocused="@CreateSilentCardFocusCallback(row, item, cardIndex)"
                           OnExcludeForSelf="() => ExcludeForSelf(item)"
                           OnExcludeForOthers="() => ExcludeForOthers(item)"
                           OnDismissFromContinueWatching="() => DismissFromContinueWatching(item)" />
            </CarouselItem>
        }
    </Carousel>;
} }
