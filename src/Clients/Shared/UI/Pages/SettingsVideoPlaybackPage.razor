@page "/settings/video-playback"
@page "/settings/video-playback/{Section}"
@layout SettingsLayout
@implements IDisposable
@using K7.Shared
@using K7.Shared.Enums
@using K7.Clients.Shared.Helpers
@inject IStringLocalizer<SettingsVideoPlayerPage> L
@inject IStringLocalizer<SettingsTrackSelectionPage> Lt

@if (_loading)
{
    <div class="admin-page-intro">
        <AdminPageHeader Title="@L["PageTitle"]" Subtitle="@L["Subtitle"]">
            <Actions>
                <SettingsMirrorLink />
            </Actions>
        </AdminPageHeader>
    </div>
    <div class="d-flex flex-col pa-16">
        <K7Spinner />
    </div>
}
else if (_settings is not null && _preferences is not null && _videoPolicy is not null)
{
    <K7SettingsSplit IndexLabel="@L["PageTitle"]"
                     DetailTitle="@ActiveSectionTitle"
                     BackHref="@BasePath"
                     DetailOpen="IsSectionOpen"
                     SaveState="CurrentSaveState">
        <Header>
            <div class="admin-page-intro">
                <AdminPageHeader Title="@L["PageTitle"]" Subtitle="@L["Subtitle"]">
                    <Actions>
                        <SettingsMirrorLink />
                    </Actions>
                </AdminPageHeader>
            </div>
        </Header>
        <Index>
            @foreach (var section in Sections)
            {
                <K7SettingsNavItem Href="@($"{BasePath}/{section.Key}")"
                                   Icon="@section.Icon"
                                   Title="@section.Title"
                                   Description="@section.Description"
                                   Active="@(section.Key == ActiveSection)" />
            }
        </Index>
        <Footer>
            <K7Button Variant="outlined"
                      Color="secondary"
                      Disabled="_saving || ResetDisabled"
                      OnClick="ConfirmResetAsync">
                @S["ResetToDefaults"]
            </K7Button>
        </Footer>
        <Detail>
            @switch (ActiveSection)
            {
                case VideoSettingsSections.Tracks:
                    <TrackSelectionSettingsFields Preferences="_preferences"
                                                  Settings="_settings"
                                                  Libraries="_libraries"
                                                  SelectedLibraryId="_selectedLibraryId"
                                                  LibraryScopeChanged="OnLibraryScopeChanged"
                                                  Changed="StateHasChanged"
                                                  Localizer="Lt" />
                    break;

                case VideoSettingsSections.Resume:
                    <PlaybackPolicySettingsFields VideoPolicy="_videoPolicy"
                                                  VideoPolicyChanged="OnVideoPolicyChanged"
                                                  ShowHeading="false" />
                    break;

                case VideoSettingsSections.Advanced:
                    <span class="settings-field-hint">@L["AdvancedSectionHint"]</span>

                    <K7SettingRow Label="@L["AudioPassthrough"]" Hint="@L["AudioPassthroughHint"]">
                        <K7Switch AriaLabel="@L["AudioPassthrough"]" @bind-Value="_audioPassthrough" />
                    </K7SettingRow>

                    @if (_showMpcExternal)
                    {
                        <K7SettingRow Label="@L["MpcExternalPlayer"]" Hint="@L["MpcExternalPlayerHint"]">
                            <K7Switch AriaLabel="@L["MpcExternalPlayer"]" @bind-Value="_mpcEnabled" />
                        </K7SettingRow>

                        @if (_mpcEnabled)
                        {
                            <div class="settings-field-group">
                                <K7TextField Label="@L["MpcExePath"]"
                                             TValue="string"
                                             @bind-Value="_mpcExePath"
                                             Variant="outlined"
                                             Placeholder="@L["MpcExePathPlaceholder"]"
                                             HelperText="@L["MpcExePathHint"]"
                                             AdornmentIcon="@Phosphor.File"
                                             OnAdornmentClick="BrowseMpcExeAsync" />

                                <K7TextField Label="@L["MpcWebHost"]"
                                             TValue="string"
                                             @bind-Value="_mpcWebHost" />

                                <K7TextField Label="@L["MpcWebPort"]"
                                             TValue="string"
                                             @bind-Value="_mpcWebPortText" />
                                <span class="settings-field-hint">@L["MpcWebHint"]</span>

                                <K7TextField Label="@L["MpcExtraArgs"]"
                                             TValue="string"
                                             @bind-Value="_mpcExtraArgs" />
                                <span class="settings-field-hint">@L["MpcExtraArgsHint"]</span>

                                <h6 class="mt-2">@L["MpcLibraryPaths"]</h6>
                                <K7Alert Severity="K7Severity.Info" Variant="outlined" NoIcon="true">
                                    @L["MpcLibraryPathsFallback"]
                                </K7Alert>
                                <div class="mpc-library-map">
                                    <div class="mpc-library-map__header">
                                        <span>@L["MpcLibraryServerRoot"]</span>
                                        <span>@L["MpcLibraryWindowsRoot"]</span>
                                    </div>
                                    @foreach (var library in MpcMappableLibraries)
                                    {
                                        <div class="mpc-library-map__row">
                                            <div class="mpc-library-map__server">
                                                <span class="mpc-library-map__title">@library.Title</span>
                                                <code class="mpc-library-map__path">@(string.IsNullOrWhiteSpace(library.RootPath) ? "-" : library.RootPath)</code>
                                            </div>
                                            <div class="mpc-library-map__local">
                                                <K7TextField TValue="string"
                                                             Variant="outlined"
                                                             Placeholder="@L["MpcLibraryWindowsPlaceholder"]"
                                                             AdornmentIcon="@Phosphor.FolderOpen"
                                                             OnAdornmentClick="@(() => BrowseLibraryFolderAsync(library.Id))"
                                                             Value="@LibraryLocalRoot(library.Id)"
                                                             ValueChanged="@(value => SetLibraryLocalRoot(library.Id, value))" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }

                    @if (_showExoBuffer)
                    {
                        <K7SettingRow Label="@L["ExoBuffer"]" Hint="@L["ExoBufferHint"]">
                            <K7Select @bind-Value="_exoBuffer" TValue="ExoVideoBufferSize">
                                <K7SelectItem Value="@ExoVideoBufferSize.Auto" Text="@L["BufferAuto"]">@L["BufferAuto"]</K7SelectItem>
                                <K7SelectItem Value="@ExoVideoBufferSize.Default" Text="@L["BufferDefault"]">@L["BufferDefault"]</K7SelectItem>
                                <K7SelectItem Value="@ExoVideoBufferSize.Large" Text="@L["BufferLarge"]">@L["BufferLarge"]</K7SelectItem>
                                <K7SelectItem Value="@ExoVideoBufferSize.ExtraLarge" Text="@L["BufferExtraLarge"]">@L["BufferExtraLarge"]</K7SelectItem>
                            </K7Select>
                        </K7SettingRow>
                    }

                    @if (_showHdmiAfr)
                    {
                        <K7SettingRow Label="@L["HdmiAfr"]" Hint="@L["HdmiAfrHint"]">
                            <K7Select @bind-Value="_hdmiAfr" TValue="HdmiAutoFrameRateMode">
                                <K7SelectItem Value="@HdmiAutoFrameRateMode.Disabled" Text="@L["HdmiAfrDisabled"]">@L["HdmiAfrDisabled"]</K7SelectItem>
                                <K7SelectItem Value="@HdmiAutoFrameRateMode.ScaleOnTv" Text="@L["HdmiAfrScaleOnTv"]">@L["HdmiAfrScaleOnTv"]</K7SelectItem>
                                <K7SelectItem Value="@HdmiAutoFrameRateMode.ScaleOnDevice" Text="@L["HdmiAfrScaleOnDevice"]">@L["HdmiAfrScaleOnDevice"]</K7SelectItem>
                            </K7Select>
                        </K7SettingRow>

                        <K7SettingRow Label="@L["DolbyVision"]" Hint="@L["DolbyVisionHint"]">
                            <K7Select @bind-Value="_dvDecode" TValue="DolbyVisionDecodeMode">
                                <K7SelectItem Value="@DolbyVisionDecodeMode.HevcHdr10" Text="@L["DolbyVisionHevc"]">@L["DolbyVisionHevc"]</K7SelectItem>
                                <K7SelectItem Value="@DolbyVisionDecodeMode.Native" Text="@L["DolbyVisionNative"]">@L["DolbyVisionNative"]</K7SelectItem>
                            </K7Select>
                        </K7SettingRow>
                    }
                    break;

                default:
                    <VideoPlayerSettingsFields Settings="_settings"
                                               Section="@ActiveSection"
                                               Changed="StateHasChanged"
                                               Localizer="L" />
                    break;
            }
        </Detail>
    </K7SettingsSplit>
}
