@page "/settings/social"
@layout SettingsLayout
@using K7.Server.Domain.Enums
@using K7.Shared.Dtos.Federation.Social
@inject IStringLocalizer<SettingsSocialPage> L
@inject IStringLocalizer<SharedResource> S
@inject IReviewService ReviewService
@inject IK7Snackbar Snackbar

<PageTitle>@L["Title"]</PageTitle>

<div class="admin-page-intro">
    <AdminPageHeader Title="@L["Title"]" Subtitle="@L["Subtitle"]" />
</div>

@if (_loading)
{
    <K7ProgressBar Indeterminate="true" />
}
else
{
    <div class="settings-form-page">
        <div class="settings-form-page__body pa-4 d-flex flex-col gap-4">
            <div class="social-matrix-wrap">
                <K7SettingRow Label="@L["BlurReviewsForUnwatchedMedia"]">
                    <K7Switch AriaLabel="@L["BlurReviewsForUnwatchedMedia"]"
                              @bind-Value="_reviewPreferences.BlurReviewsForUnwatchedMedia" />
                </K7SettingRow>

                @* One line per kind of content, one column per direction. *@
                <div class="social-matrix" role="table" aria-label="@L["Title"]">
                    <div class="social-matrix__head" role="row">
                        <span role="columnheader"></span>
                        <span role="columnheader">@L["ShareTitle"]</span>
                        <span role="columnheader">@L["ViewTitle"]</span>
                    </div>
                    @foreach (var contentType in ContentTypes)
                    {
                        <div class="social-matrix__row" role="row" @key="contentType">
                            <span class="social-matrix__type" role="rowheader">@GetContentLabel(contentType)</span>
                            <div class="social-matrix__cell" role="cell">
                                <span class="social-matrix__cell-label">@L["ShareTitle"]</span>
                                <K7VisibilityScopeSelect Value="GetScope(contentType, share: true)"
                                                         ValueChanged="@(scope => SetShareScope(contentType, scope, share: true))" />
                                @if (GetScope(contentType, share: true) == VisibilityScope.SpecificPeople)
                                {
                                    <FederationVisibilityGrantsEditor ContentType="contentType"
                                                                      Grants="_shareGrants"
                                                                      GrantsChanged="OnShareGrantsChanged" />
                                }
                            </div>
                            <div class="social-matrix__cell" role="cell">
                                <span class="social-matrix__cell-label">@L["ViewTitle"]</span>
                                <K7VisibilityScopeSelect Value="GetScope(contentType, share: false)"
                                                         ValueChanged="@(scope => SetShareScope(contentType, scope, share: false))" />
                                @if (GetScope(contentType, share: false) == VisibilityScope.SpecificPeople)
                                {
                                    <FederationVisibilityGrantsEditor ContentType="contentType"
                                                                      Grants="_viewGrants"
                                                                      GrantsChanged="OnViewGrantsChanged" />
                                }
                            </div>
                        </div>
                    }
                </div>

                <p class="settings-field-hint social-matrix__note">@L["FederationDirectPeersNote"]</p>
            </div>
        </div>

        <K7SettingsActionBar AutoSave="true"
                             SaveState="_autoSave.State"
                             ShowResetToDefaults="false" />
    </div>
}
