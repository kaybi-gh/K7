@page "/select-profile"
@page "/select-user"
@layout EmptyLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject IStringLocalizer<SelectProfile> L

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="select-profile-page">
    @* First paint: shell only so EmptyLayout can AppReady before Carousel/avatars/icons JIT. *@
    @if (!_paintPicker)
    {
        <section class="select-profile-section">
            <p class="select-profile-prompt">@L["Prompt"]</p>
        </section>
    }
    else if (_loading)
    {
        <div class="d-flex flex-col align-center gap-4">
            <K7Spinner />
            @if (_showOfflineButton)
            {
                <K7Button Variant="text" Color="secondary" OnClick="ContinueOfflineAsync">
                    <K7Icon Icon="@Phosphor.WifiSlash" Class="mr-2" />
                    @L["ContinueOffline"]
                </K7Button>
            }
        </div>
    }
    else
    {
        <section class="select-profile-section">
            <Carousel @ref="_carousel" Title="@(_editing ? L["ManageProfiles"] : L["Prompt"])" ShowLoopBack="false">
                @for (var index = 0; index < _entries.Count; index++)
                {
                    var entry = _entries[index];
                    var entryIndex = index;
                    <CarouselItem @key="@entry.Token">
                        <div class="select-profile-card-wrap">
                            @if (entry.User is { } user)
                            {
                                <button type="button"
                                        class="@GetProfileCardClass(NeedsReconnect(user), editing: _editing, hidden: IsUserHidden(user))"
                                        tabindex="@(_editing ? -1 : 0)"
                                        @attributes="GetInitialFocusAttributes(!_editing && user.IdentityUserId == _initialFocusUserId)"
                                        @onclick="() => SelectUserAsync(user)">
                                    <K7Avatar Class="ma-2" Size="xl" Color="primary"
                                              Image="@user.AvatarUrl"
                                              Letter="@GetInitial(user)"
                                              UserId="@user.UserId">
                                        @if (NeedsReconnect(user))
                                        {
                                            <span class="select-profile-reconnect-badge"
                                                  title="@L["NeedsReconnect"]"
                                                  aria-label="@L["NeedsReconnect"]">
                                                <K7Icon Icon="@Phosphor.XCircle" IconSize="@K7IconSize.Sm" />
                                            </span>
                                        }
                                    </K7Avatar>
                                    <div class="select-profile-name">
                                        <span class="select-profile-name-text">
                                            <span class="select-profile-name-inner">@(user.DisplayName ?? user.UserName)</span>
                                        </span>
                                        @if (user.HasPin)
                                        {
                                            <K7Icon Icon="@Phosphor.Lock" IconSize="@K7IconSize.Sm" Color="secondary" />
                                        }
                                    </div>
                                </button>
                            }
                            else if (entry.Group is { } group)
                            {
                                <button type="button"
                                        class="@GetProfileCardClass(GroupNeedsReconnect(group), isGroup: true, editing: _editing)"
                                        tabindex="@(_editing ? -1 : 0)"
                                        @attributes="GetInitialFocusAttributes(!_editing && group.Id == _initialFocusGroupId)"
                                        @onclick="() => SelectGroupAsync(group)">
                                    <div class="select-profile-group-avatars">
                                        @if (!string.IsNullOrEmpty(group.AvatarUrl))
                                        {
                                            <K7Avatar Class="ma-2" Size="xl"
                                                      Image="@group.AvatarUrl"
                                                      Letter="@(string.IsNullOrEmpty(group.Name) ? "?" : group.Name[..1].ToUpperInvariant())"
                                                      Alt="@group.Name">
                                                @if (GroupNeedsReconnect(group))
                                                {
                                                    <span class="select-profile-reconnect-badge"
                                                          title="@L["NeedsReconnect"]"
                                                          aria-label="@L["NeedsReconnect"]">
                                                        <K7Icon Icon="@Phosphor.XCircle" IconSize="@K7IconSize.Sm" />
                                                    </span>
                                                }
                                            </K7Avatar>
                                        }
                                        else
                                        {
                                            <span class="select-profile-group-avatars-wrap">
                                                <K7AvatarGroup Class="ma-2" Size="xl"
                                                               Members="@(group.Members.Select(ToAvatarGroupItem).ToList())" />
                                                @if (GroupNeedsReconnect(group))
                                                {
                                                    <span class="select-profile-reconnect-badge"
                                                          title="@L["NeedsReconnect"]"
                                                          aria-label="@L["NeedsReconnect"]">
                                                        <K7Icon Icon="@Phosphor.XCircle" IconSize="@K7IconSize.Sm" />
                                                    </span>
                                                }
                                            </span>
                                        }
                                    </div>
                                    <div class="select-profile-name">
                                        <span class="select-profile-name-text">
                                            <span class="select-profile-name-inner">@group.Name</span>
                                        </span>
                                        @if (group.HasPin)
                                        {
                                            <K7Icon Icon="@Phosphor.Lock" IconSize="@K7IconSize.Sm" Color="secondary" />
                                        }
                                    </div>
                                </button>
                            }
                            @if (_editing)
                            {
                                <div class="select-profile-edit-actions">
                                    <K7IconButton Icon="@Phosphor.CaretLeft"
                                                  AriaLabel="@L["MoveEarlier"]"
                                                  Disabled="@(entryIndex == 0)"
                                                  Focusable="@(entryIndex > 0)"
                                                  OnClick="@(() => MoveEntry(entryIndex, -1))" />
                                    @if (entry.User is { } editableUser)
                                    {
                                        var hidden = IsUserHidden(editableUser);
                                        <K7IconButton Icon="@(hidden ? Phosphor.EyeSlash : Phosphor.Eye)"
                                                      AriaLabel="@(hidden ? L["ShowProfile"] : L["HideProfile"])"
                                                      OnClick="@(() => ToggleHidden(editableUser))" />
                                    }
                                    <K7IconButton Icon="@Phosphor.Trash"
                                                  Color="error"
                                                  AriaLabel="@L["RemoveProfile"]"
                                                  OnClick="@(() => RemoveEntryAsync(entry))" />
                                    <K7IconButton Icon="@Phosphor.CaretRight"
                                                  AriaLabel="@L["MoveLater"]"
                                                  Disabled="@(entryIndex == _entries.Count - 1)"
                                                  Focusable="@(entryIndex < _entries.Count - 1)"
                                                  OnClick="@(() => MoveEntry(entryIndex, 1))" />
                                </div>
                            }
                        </div>
                    </CarouselItem>
                }

                @if (!_editing)
                {
                    <CarouselItem>
                        <button type="button"
                                class="select-profile-card focusable my-2"
                                @attributes="GetInitialFocusAttributes(_initialFocusAddCard)"
                                @onclick="AddUserAsync">
                            <K7Avatar Class="ma-2" Size="xl" Color="default">
                                <K7Icon Icon="@Phosphor.Plus" IconSize="@K7IconSize.Lg" />
                            </K7Avatar>
                            <span class="select-profile-name">@L["AddServer"]</span>
                        </button>
                    </CarouselItem>
                    @if (_entries.Count > 0)
                    {
                        <CarouselItem>
                            <button type="button"
                                    class="select-profile-card focusable my-2"
                                    aria-label="@L["Edit"]"
                                    @onclick="BeginEditAsync">
                                <K7Avatar Class="ma-2" Size="xl" Color="default">
                                    <K7Icon Icon="@Phosphor.PencilSimple" IconSize="@K7IconSize.Lg" />
                                </K7Avatar>
                                <span class="select-profile-name">@L["Edit"]</span>
                            </button>
                        </CarouselItem>
                    }
                }
                else
                {
                    <CarouselItem>
                        <button type="button"
                                class="select-profile-card focusable my-2"
                                aria-label="@L["Apply"]"
                                @onclick="ApplyEditAsync">
                            <K7Avatar Class="ma-2" Size="xl" Color="primary">
                                <K7Icon Icon="@Phosphor.Check" IconSize="@K7IconSize.Lg" />
                            </K7Avatar>
                            <span class="select-profile-name">@L["Apply"]</span>
                        </button>
                    </CarouselItem>
                    <CarouselItem>
                        <button type="button"
                                class="select-profile-card focusable my-2"
                                aria-label="@S["Cancel"]"
                                @onclick="CancelEditAsync">
                            <K7Avatar Class="ma-2" Size="xl" Color="default">
                                <K7Icon Icon="@Phosphor.X" IconSize="@K7IconSize.Lg" />
                            </K7Avatar>
                            <span class="select-profile-name">@S["Cancel"]</span>
                        </button>
                    </CarouselItem>
                }
            </Carousel>
        </section>

        @if (!_editing && _users.Count > 0)
        {
            <div class="select-profile-switch">
                <K7Switch Value="_singleUserMode" ValueChanged="OnSingleUserModeChanged"
                           Label="@L["SingleUserMode"]" />
            </div>
        }
    }
</div>
