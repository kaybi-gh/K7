@page "/settings/syncplay"
@layout SettingsLayout
@inject IStringLocalizer<SettingsSharedProfilesPage> L
@inject ISyncPlayService SyncPlay

<PageTitle>@L["SyncPlayTitle"]</PageTitle>

<div class="admin-page-intro">
    <AdminPageHeader Title="@L["SyncPlayTitle"]" Subtitle="@L["SyncPlayPageDescription"]" />
</div>

<div class="pa-4">
    <section class="settings-section">
        <K7SettingRow Label="@L["SyncPlayDeviceEnabled"]" Hint="@L["SyncPlayDeviceDescription"]">
            <K7Switch AriaLabel="@L["SyncPlayDeviceEnabled"]" @bind-Value="SyncPlay.IsEnabled" />
        </K7SettingRow>
        <K7SettingRow Label="@L["SyncPlayInvitationsEnabled"]" Hint="@L["SyncPlayInvitationsDescription"]">
            <K7Switch AriaLabel="@L["SyncPlayInvitationsEnabled"]"
                      Value="_syncPlayPreferences.InvitationsEnabled"
                      ValueChanged="OnSyncPlayInvitationsChanged"
                      Disabled="_savingSyncPlayPreference" />
        </K7SettingRow>
    </section>
</div>
