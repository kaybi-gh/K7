@page "/playlists/{Id}"

@using K7.Clients.Shared.Models

@using K7.Shared.Dtos.Entities.Playlists

@using K7.Server.Domain.Enums

@inject IPlaylistService K7ServerService

@inject IK7ServerService ApiClient

@inject IStringLocalizer<PlaylistDetail> L

@inject IStringLocalizer<SharedResource> S

<PageTitle>@(_playlist?.Title ?? "Playlist")</PageTitle>



@if (_playlist is not null)

{

    <PlaylistDetailShell>

        <div class="playlist-header">

            <div class="playlist-header-cover">

                <K7CoverMosaic CoverPicture="@(_showHeaderPlaceholder ? null : _playlist.CoverPicture)"

                                ImageUrls="_headerPreviewUrls"

                                PreferPreviewWhenEmpty="@_showHeaderPlaceholder"

                                PlaceholderIcon="@Phosphor.Queue"

                                PictureSize="MetadataPictureSize.Medium"

                                Alt="@_playlist.Title" />

            </div>



            <div class="playlist-header-info">

                <p class="text-overline playlist-header-overline">@L["Header"]</p>

                <h4>@_playlist.Title</h4>



                @if (!string.IsNullOrEmpty(_playlist.Description))

                {

                    <p class="text-sm mt-1 playlist-header-desc" Color="secondary">@_playlist.Description</p>

                }



                <p class="text-sm mt-1 playlist-header-meta" Color="secondary">

                    @_playlist.ItemCount @GetItemLabel(_playlist.MediaType)

                    @if (_totalDuration > 0)

                    {

                        <text> · @FormatTotalDuration(_totalDuration)</text>

                    }

                </p>



            </div>



            <div class="playlist-header-actions">

                <K7Button Variant="filled"

                           Color="primary"

                           StartIcon="@Phosphor.Play"

                           OnClick="PlayAll"

                           Disabled="@(_loadingItems || !_items.Any(i => !i.IsUnavailable))"

                           AriaLabel="@S["PlayAll"]">

                    <span class="playlist-action-label">@S["PlayAll"]</span>

                </K7Button>

                <div class="playlist-header-manage">

                <K7Button Variant="outlined"

                           Color="primary"

                           StartIcon="@Phosphor.Shuffle"

                           OnClick="ShuffleAll"

                           Disabled="@(_loadingItems || !_items.Any(i => !i.IsUnavailable))"

                           AriaLabel="@S["Shuffle"]">

                    <span class="playlist-action-label">@S["Shuffle"]</span>

                </K7Button>

                <DownloadAllButton Items="GetDownloadRequests()" Label="@_playlist?.Title" />

                <K7IconButton Icon="@Phosphor.Pencil" OnClick="OpenEditDialog" AriaLabel="@L["EditDialogTitle"]" />

                <K7IconButton Icon="@Phosphor.Trash" Color="error" OnClick="ConfirmDelete" AriaLabel="@L["DeleteDialogTitle"]" />

                <K7Menu>
                    <ActivatorContent>
                        <K7IconButton Icon="@Phosphor.DotsThreeVertical" AriaLabel="@L["MoreActions"]" />
                    </ActivatorContent>
                    <ChildContent>
                        <K7MenuItem Icon="@(_showUnavailable ? "eye-slash" : "eye")"
                                    OnClick="ToggleShowUnavailableAsync">
                            @(_showUnavailable ? L["HideUnavailable"] : L["ShowUnavailable"])
                        </K7MenuItem>
                    </ChildContent>
                </K7Menu>

                    @if (_items.Count > 0)
                    {
                        <K7IconButton Icon="@Phosphor.Columns" OnClick="ToggleColumnPicker" AriaLabel="@S["ToggleColumns"]" />
                    }

                </div>

            </div>

        </div>



        @if (_loadingItems)
        {
            <K7ProgressBar Indeterminate="true" />
        }
        else if (_items.Count == 0)
        {
            <K7EmptyState Icon="@Phosphor.Queue" Title="@L["Empty"]" />
        }
        else
        {
            <div class="playlist-tracklist">
                <K7DataTable TItem="PlaylistItemViewModel"
                             ServerData="LoadTableDataAsync"
                             ActiveSortKey="@_activeSortKey"
                             ActiveSortDirection="@_activeSortDirection"
                             OnSortChanged="OnTableSortChanged"
                             OnRowClick="OnItemActivated"
                             RowHeight="56"
                             ShowToolbar="false"
                             FlexColumnMinWidth="200"
                             PersistenceKey="playlist-tracks"
                             Surface="false"
                             RowClass="@(_ => "cursor-pointer")"
                             @ref="_dataTable">
                    <K7DataColumn TItem="PlaylistItemViewModel" Title="@S["Title"]" SortKey="title" Hideable="false">
                        <CellTemplate Context="item">
                            <div class="playlist-tracklist-title">
                                @if (item.CoverUrl is not null)
                                {
                                    <K7Image Src="@item.CoverUrl" Width="40" Height="40"
                                              ObjectFit="cover" Class="playlist-tracklist-cover rounded"
                                              LoadingMode="K7ImageLoadingMode.Css" loading="lazy" />
                                }
                                else
                                {
                                    <div class="playlist-tracklist-cover playlist-tracklist-cover--placeholder">
                                        <K7Icon Icon="@Phosphor.Image" IconSize="@K7IconSize.Sm" />
                                    </div>
                                }
                                <span class="playlist-tracklist-name @(item.IsUnavailable ? "playlist-item-unavailable" : null)" style="@(item.IsPlaying ? "color: var(--color-accent);" : null)">
                                    @item.Title
                                    @if (item.IsUnavailable)
                                    {
                                        <span class="text-muted text-xs ml-1">@L["Unavailable"]</span>
                                    }
                                </span>
                            </div>
                        </CellTemplate>
                    </K7DataColumn>
                    <K7DataColumn TItem="PlaylistItemViewModel" Title="@S["Artist"]" SortKey="artist" Width="160px" Visible="@_isMusicPlaylist">
                        <CellTemplate Context="item">
                            <p class="text-sm playlist-tracklist-cell" Color="secondary">@item.ArtistName</p>
                        </CellTemplate>
                    </K7DataColumn>
                    <K7DataColumn TItem="PlaylistItemViewModel" Title="@S["Album"]" SortKey="album" Width="180px" Visible="@_isMusicPlaylist">
                        <CellTemplate Context="item">
                            <p class="text-sm playlist-tracklist-cell" Color="secondary">@item.AlbumTitle</p>
                        </CellTemplate>
                    </K7DataColumn>
                    <K7DataColumn TItem="PlaylistItemViewModel" Title="@S["Duration"]" SortKey="duration" Width="80px" Visible="@_isMusicPlaylist" VisibleOnMobile="false">
                        <CellTemplate Context="item">
                            <p class="text-sm" Color="secondary">@FormatTime(item.Duration)</p>
                        </CellTemplate>
                    </K7DataColumn>
                    <K7DataColumn TItem="PlaylistItemViewModel" Title="" Width="130px" Hideable="false" Visible="@_isMusicPlaylist" VisibleOnMobile="false">
                        <CellTemplate Context="item">
                            <div @onclick:stopPropagation="true">
                                <RatingStars MediaId="item.MediaId" Value="item.UserRating" Size="sm" />
                            </div>
                        </CellTemplate>
                    </K7DataColumn>
                    <K7DataColumn TItem="PlaylistItemViewModel" Title="" Width="88px" Hideable="false">
                        <CellTemplate Context="item">
                            @{
                                var vm = GetCardViewModel(item);
                                var href = GetItemHref(item);
                            }
                            <div @onclick:stopPropagation="true">
                                <PlaylistItemRowActions IsMusic="_isMusicPlaylist"
                                                         Track="BuildQueueItem(item)"
                                                         Model="vm"
                                                         Href="href"
                                                         OverlayEnabled="true"
                                                         ProgressEnabled="_canTrackProgress"
                                                         WatchedStatusEnabled="_canTrackProgress"
                                                         WatchStateMenuEnabled="_canSetWatchState"
                                                         OnWatchStateChanged="() => OnItemWatchStateChanged(vm)"
                                                         OnRemove="() => RemoveItem(item)" />
                            </div>
                        </CellTemplate>
                    </K7DataColumn>
                </K7DataTable>
            </div>
        }

    </PlaylistDetailShell>

}

else if (_loading)

{

    <div class="d-flex flex-col pa-16">

        <K7Spinner />

    </div>

}

