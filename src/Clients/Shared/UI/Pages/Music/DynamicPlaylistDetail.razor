@page "/dynamic-playlists/{Id}"
@using K7.Clients.Shared.UI.Components
@using K7.Clients.Shared.UI.Components.Dialogs
@using K7.Shared.Dtos.Entities.Playlists
@inject IPlaylistService K7ServerService
@inject ILibraryService LibraryService
@inject IK7ServerService ApiClient
@inject IStringLocalizer<DynamicPlaylistDetail> L
@inject IStringLocalizer<SharedResource> S
@inject IStringLocalizer<DynamicPlaylistDialog> FieldL
@inject IStringLocalizer<K7RuleEditor> OpL
<PageTitle>@(_dynamicPlaylist?.Title ?? "Dynamic Playlist")</PageTitle>

@if (_dynamicPlaylist is not null)
{
    <PlaylistDetailShell>
        <div class="playlist-header">
            <div class="playlist-header-cover">
                <K7CoverMosaic CoverPicture="@(_showHeaderPlaceholder ? null : _dynamicPlaylist.CoverPicture)"
                                ImageUrls="_headerPreviewUrls"
                                PreferPreviewWhenEmpty="@_showHeaderPlaceholder"
                                PlaceholderIcon="@Phosphor.Sparkle"
                                PictureSize="MetadataPictureSize.Medium"
                                Alt="@_dynamicPlaylist.Title" />
            </div>
            <div class="playlist-header-info">
                <p class="text-overline playlist-header-overline">@L["Header"]</p>
                <h4>@_dynamicPlaylist.Title</h4>

                @if (!string.IsNullOrEmpty(_dynamicPlaylist.Description))
                {
                    <p class="text-sm mt-1 playlist-header-desc" Color="secondary">@_dynamicPlaylist.Description</p>
                }

                <div class="d-flex mt-1 playlist-header-meta">
                    <p class="text-sm" Color="secondary">
                        @string.Format(L["RulesCount"], _dynamicPlaylist.RuleFilter.Items.Count)
                        · @_dynamicPlaylist.ItemCount @S["Tracks"]
                    </p>
                    @if (_dynamicPlaylist.LastEvaluatedAt.HasValue)
                    {
                        <p class="text-sm" Color="secondary">
                            · @string.Format(L["EvaluatedRelative"], FormatRelativeTime(_dynamicPlaylist.LastEvaluatedAt.Value))
                        </p>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_rulesDescription))
                {
                    <p class="playlist-rules" title="@_rulesDescription">
                        <K7Icon Name="funnel" IconSize="@K7IconSize.Xs" />
                        <span>@_rulesDescription</span>
                    </p>
                }
            </div>

            <div class="playlist-header-actions">
                <K7Button Variant="filled" Color="primary"
                           StartIcon="@Phosphor.Play"
                           OnClick="PlayAll" Disabled="@(_loadingItems || _items.Count == 0)"
                           AriaLabel="@S["PlayAll"]">
                    <span class="playlist-action-label">@S["PlayAll"]</span>
                </K7Button>
                <div class="playlist-header-manage">
                    <K7Button Variant="outlined" Color="primary"
                               StartIcon="@Phosphor.Shuffle"
                               OnClick="ShuffleAll" Disabled="@(_loadingItems || _items.Count == 0)"
                               AriaLabel="@S["Shuffle"]">
                        <span class="playlist-action-label">@S["Shuffle"]</span>
                    </K7Button>
                    <K7Button Variant="outlined" Color="secondary"
                               StartIcon="@Phosphor.ArrowClockwise"
                               OnClick="EvaluateAsync" Disabled="_evaluating"
                               AriaLabel="@L["Reevaluate"]">
                        @if (_evaluating)
                        {
                            <K7Spinner Size="sm" />
                            <span class="playlist-action-label">@L["Evaluating"]</span>
                        }
                        else
                        {
                            <span class="playlist-action-label">@L["Reevaluate"]</span>
                        }
                    </K7Button>
                    <K7Button Variant="outlined" Color="secondary"
                               StartIcon="@Phosphor.Funnel"
                               OnClick="BrowseInLibraryAsync"
                               Disabled="@(_dynamicPlaylist.RuleFilter.Items.Count == 0)"
                               AriaLabel="@L["BrowseInLibrary"]">
                        <span class="playlist-action-label">@L["BrowseInLibrary"]</span>
                    </K7Button>
                    <K7IconButton Icon="@Phosphor.Pencil" OnClick="OpenEditDialog" AriaLabel="@L["EditDialogTitle"]" />
                    <K7IconButton Icon="@Phosphor.Trash" Color="error" OnClick="ConfirmDelete" AriaLabel="@L["DeleteDialogTitle"]" />
                </div>
            </div>
        </div>

        @if (_loadingItems)
        {
            <K7ProgressBar Indeterminate="true" />
        }
        else if (_items.Count == 0)
        {
            <div class="d-flex flex-col pa-16">
                <K7Icon Name="music-note" Style="font-size: 48px; opacity: 0.3;" />
                <p Color="secondary">@L["NoResults"]</p>
            </div>
        }
        else
        {
            <div class="playlist-tracklist">
                <K7DataTable TItem="DynamicPlaylistItemViewModel"
                             ServerData="LoadTableDataAsync"
                             OnRowClick="OnTrackClick"
                             RowHeight="56"
                             ShowToolbar="false"
                             Surface="false"
                             RowClass="@(_ => "cursor-pointer")"
                             @ref="_dataTable">
                    <K7DataColumn TItem="DynamicPlaylistItemViewModel" Title="#" Width="50px" Hideable="false">
                        <CellTemplate Context="item">
                            @if (item.IsPlaying)
                            {
                                <K7Icon Name="equalizer" IconSize="@K7IconSize.Sm" Color="primary" />
                            }
                            else
                            {
                                <p class="text-sm" Color="secondary">@(item.Order + 1)</p>
                            }
                        </CellTemplate>
                    </K7DataColumn>
                    <K7DataColumn TItem="DynamicPlaylistItemViewModel" Title="@S["Title"]" Hideable="false">
                        <CellTemplate Context="item">
                            <div class="playlist-tracklist-title">
                                @if (item.CoverUrl is not null)
                                {
                                    <K7Image Src="@item.CoverUrl" Width="36"
                                              ObjectFit="cover" Class="rounded" LoadingMode="K7ImageLoadingMode.Css" loading="lazy" />
                                }
                                <span style="@(item.IsPlaying ? "color: var(--color-accent);" : null)">
                                    @item.Title
                                </span>
                            </div>
                        </CellTemplate>
                    </K7DataColumn>
                    <K7DataColumn TItem="DynamicPlaylistItemViewModel" Title="@S["Artist"]" Width="160px" VisibleOnMobile="false">
                        <CellTemplate Context="item">
                            <p class="text-sm" Color="secondary">@item.ArtistName</p>
                        </CellTemplate>
                    </K7DataColumn>
                    <K7DataColumn TItem="DynamicPlaylistItemViewModel" Title="@S["Album"]" Width="180px" VisibleOnMobile="false">
                        <CellTemplate Context="item">
                            <p class="text-sm" Color="secondary">@item.AlbumTitle</p>
                        </CellTemplate>
                    </K7DataColumn>
                    <K7DataColumn TItem="DynamicPlaylistItemViewModel" Title="@S["Duration"]" Width="80px" VisibleOnMobile="false">
                        <CellTemplate Context="item">
                            <p class="text-sm" Color="secondary">@FormatTime(item.Duration)</p>
                        </CellTemplate>
                    </K7DataColumn>
                    <K7DataColumn TItem="DynamicPlaylistItemViewModel" Title="" Width="130px" Hideable="false" VisibleOnMobile="false">
                        <CellTemplate Context="item">
                            <div @onclick:stopPropagation="true">
                                <RatingStars MediaId="item.MediaId" Value="item.UserRating" Size="sm" />
                            </div>
                        </CellTemplate>
                    </K7DataColumn>
                    <K7DataColumn TItem="DynamicPlaylistItemViewModel" Title="" Width="50px" Hideable="false">
                        <CellTemplate Context="item">
                            <div @onclick:stopPropagation="true">
                                @if (item.IndexedFileId.HasValue)
                                {
                                    <TrackContextMenu Track="BuildQueueItem(item)" />
                                }
                            </div>
                        </CellTemplate>
                    </K7DataColumn>
                </K7DataTable>
            </div>
        }
    </PlaylistDetailShell>
}
else if (_loading)
{
    <div class="d-flex flex-col pa-16">
        <K7Spinner />
    </div>
}
