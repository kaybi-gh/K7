@page "/settings/offline"
@layout SettingsLayout
@using K7.Clients.Shared.UI.Helpers
@inject IStringLocalizer<SettingsOfflinePage> L
@inject IDeviceStorageService DeviceStorageService
@inject IMusicCacheService MusicCacheService
@inject IOfflineMediaStore OfflineStore

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="admin-page-intro">
    <AdminPageHeader Title="@L["PageTitle"]" Subtitle="@L["Subtitle"]" />
</div>

<div class="pa-4 d-flex flex-col gap-4">
    @if (_storageInfo is not null)
    {
        <K7Paper Outlined="true" Elevation="0" Class="admin-surface-card storage-overview">
            <div class="storage-overview-row">
                <div class="d-flex justify-space-between align-center">
                    <span class="text-sm text-secondary">@L["Downloads"]</span>
                    <span class="text-sm">@FormatBytes(_storageInfo.UsedBytes - _storageInfo.CacheBytes) / @FormatBytes(_maxDownloadBytes)</span>
                </div>
                <K7ProgressBar Value="@GetDownloadStoragePercent()" Class="mt-1" />
            </div>
            <div class="storage-overview-row">
                <div class="d-flex justify-space-between align-center">
                    <span class="text-sm text-secondary">@L["Cache"]</span>
                    <span class="text-sm">@FormatBytes(_storageInfo.CacheBytes) / @FormatBytes(_maxCacheBytes)</span>
                </div>
                <K7ProgressBar Value="@GetCacheStoragePercent()" Class="mt-1" />
            </div>
        </K7Paper>

        @if (_storageInfo.DeviceTotalBytes is { } deviceTotal)
        {
            <p class="text-caption text-secondary mt-2">
                @string.Format(L["DeviceStorageCapacity"], FormatBytes(deviceTotal))
            </p>
        }
    }

    <h6>@L["StorageLimits"]</h6>

    <div>
        <K7SettingRow Label="@L["MaxDownloadStorage"]">
            <K7ByteSizeSelect Value="_maxDownloadBytes"
                              ValueChanged="OnMaxDownloadChanged"
                              Presets="OfflineStoragePresets.DownloadLimits"
                              DeviceTotalBytes="_storageInfo?.DeviceTotalBytes"
                              SiblingBytes="_maxCacheBytes" />
        </K7SettingRow>

        <K7SettingRow Label="@L["MaxCacheStorage"]">
            <K7ByteSizeSelect Value="_maxCacheBytes"
                              ValueChanged="OnMaxCacheChanged"
                              Presets="OfflineStoragePresets.CacheLimits"
                              MaxBytes="@(50L * 1024 * 1024 * 1024)"
                              DeviceTotalBytes="_storageInfo?.DeviceTotalBytes"
                              SiblingBytes="_maxDownloadBytes" />
        </K7SettingRow>
    </div>

    <h6>@L["Network"]</h6>

    <div>
        <K7SettingRow Label="@L["AllowWifi"]">
            <K7Switch AriaLabel="@L["AllowWifi"]" Value="_allowWifi" ValueChanged="OnAllowWifiChanged" />
        </K7SettingRow>

        <K7SettingRow Label="@L["AllowMobileData"]">
            <K7Switch AriaLabel="@L["AllowMobileData"]" Value="_allowMobileData" ValueChanged="OnAllowMobileDataChanged" />
        </K7SettingRow>
    </div>

    <h6>@L["MusicCache"]</h6>

    <div>
        <K7SettingRow Label="@L["LookaheadWifi"]">
            <K7PresetIntSelect Value="_lookaheadWifi"
                               ValueChanged="OnLookaheadWifiChanged"
                               Presets="OfflineStoragePresets.LookaheadWifi"
                               DisabledLabel="@L["Disabled"]"
                               Max="200" />
        </K7SettingRow>

        <K7SettingRow Label="@L["LookaheadMobile"]">
            <K7PresetIntSelect Value="_lookaheadMobile"
                               ValueChanged="OnLookaheadMobileChanged"
                               Presets="OfflineStoragePresets.LookaheadMobile"
                               DisabledLabel="@L["Disabled"]"
                               Max="100" />
        </K7SettingRow>
    </div>
</div>
