  <data name="SubtitleFontSize" xml:space="preserve"><value>Subtitle font size</value></data>
  <data name="SubtitleFontColor" xml:space="preserve"><value>Subtitle font color</value></data>
  <data name="SubtitleBackgroundOpacity" xml:space="preserve"><value>Subtitle background opacity</value></data>
  <data name="SubtitleBackgroundOpacityHint" xml:space="preserve"><value>0 = transparent, 1 = opaque background behind text.</value></data>
