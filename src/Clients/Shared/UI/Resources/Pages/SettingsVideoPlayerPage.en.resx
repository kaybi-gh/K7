  <data name="BufferDefault" xml:space="preserve"><value>Default</value></data>
  <data name="BufferLarge" xml:space="preserve"><value>Large</value></data>
  <data name="BufferExtraLarge" xml:space="preserve"><value>Extra large</value></data>
