@using K7.Clients.Shared.UI.Components.Explore
@using K7.Clients.Shared.UI.Pages
@implements IDisposable
@inject IExploreGroupStore ExploreGroupStore
@inject IStringLocalizer<ExplorePage> L

@if (_isTv is null || _loading)
{
    <div class="@(_isTv == true ? "tv-feed-page" : "explore-page page-scrollable")" aria-busy="true">
        @if (_isTv == true)
        {
            <VerticalCarousel>
                @for (var i = 0; i < 3; i++)
                {
                    <Carousel Skeleton="true">
                        @for (var j = 0; j < 10; j++)
                        {
                            <CarouselItem>
                                <MediaCard Skeleton="true" FooterVisible="true" />
                            </CarouselItem>
                        }
                    </Carousel>
                }
            </VerticalCarousel>
        }
        else
        {
            <div class="d-flex flex-col pa-16">
                <K7Spinner />
            </div>
        }
    </div>
}
else if (_group is null)
{
    <div class="explore-page page-scrollable">
        <K7EmptyState Title="@L["NoLibraryGroup"]" />
    </div>
}
else
{
    <div class="@_pageClass" data-initial-focus="@_initialFocus">
        <CascadingValue Value="_focusNavigation" IsFixed="true">
            <ExploreLibraryGroupView Group="_group" IsTv="@(_isTv == true)" />
        </CascadingValue>
    </div>
}
