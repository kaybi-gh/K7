@inject IStringLocalizer<HomeRowDialog> L
@inject IStringLocalizer<SharedResource> S
@namespace K7.Clients.Shared.UI.Components.Dialogs

<div class="k7-dialog-content home-row-dialog">
    <div>
        <K7SettingRow Label="@L["Title"]" Required="true">
            <K7TextField @bind-Value="_title" Required="true" Variant="outlined" />
        </K7SettingRow>
        @if (!_continueWatching)
        {
            <K7SettingRow Label="@L["CatalogScope"]">
                <K7Select TValue="CatalogScope" Value="_catalogScope" ValueChanged="OnCatalogScopeChanged"
                          Variant="outlined">
                    @foreach (var scope in Enum.GetValues<CatalogScope>())
                    {
                        <K7SelectItem Value="@scope" Text="@GetCatalogScopeLabel(scope)">@GetCatalogScopeLabel(scope)</K7SelectItem>
                    }
                </K7Select>
            </K7SettingRow>

            @if (_catalogScope == CatalogScope.LibraryGroups && LibraryGroups.Count > 0)
            {
                <K7SettingRow Label="@L["LibraryGroups"]" Hint="@L["LibraryGroupsHint"]" Stacked="true">
                    <K7CheckboxList TItem="LibraryGroupDto"
                                    Items="LibraryGroups"
                                    IsChecked="@(group => _libraryGroupIds.Contains(group.Id))"
                                    CheckedChanged="@(e => ToggleLibraryGroup(e.Item.Id, e.Checked))"
                                    ItemLabel="@(group => group.Title)"
                                    Class="home-row-dialog__list" />
                </K7SettingRow>
            }

            @if (_catalogScope == CatalogScope.Libraries && Libraries.Count > 0)
            {
                <K7SettingRow Label="@L["Libraries"]" Hint="@L["LibrariesHint"]" Stacked="true">
                    <K7CheckboxList TItem="LibraryDto"
                                    Items="Libraries"
                                    IsChecked="@(lib => _libraryIds.Contains(lib.Id))"
                                    CheckedChanged="@(e => ToggleLibrary(e.Item.Id, e.Checked))"
                                    ItemLabel="@(lib => lib.Title)"
                                    Class="home-row-dialog__list" />
                </K7SettingRow>
            }

            <K7SettingRow Label="@L["MediaTypes"]" Hint="@L["MediaTypesHint"]" Stacked="true">
                <K7CheckboxList TItem="MediaType"
                                Items="_availableMediaTypes"
                                IsChecked="@(type => _mediaTypes.Contains(type))"
                                CheckedChanged="@(e => ToggleMediaType(e.Item, e.Checked))"
                                ItemLabel="@GetMediaTypeLabel"
                                Class="home-row-dialog__list" />
            </K7SettingRow>

            <K7SettingRow Label="@L["Sort"]">
                <K7Select TValue="MediaOrderingOption" @bind-Value="_orderBy" Variant="outlined">
                    @foreach (var option in OrderOptions)
                    {
                        <K7SelectItem Value="@option" Text="@GetOrderLabel(option)">@GetOrderLabel(option)</K7SelectItem>
                    }
                </K7Select>
            </K7SettingRow>
        }

        <K7SettingRow Label="@L["Display"]" Hint="@KindHint">
            <K7ButtonGroup TValue="RowKind"
                           Options="KindOptions"
                           Value="Kind"
                           ValueChanged="OnKindChanged"
                           AriaLabel="@L["Display"]" />
        </K7SettingRow>
        <K7SettingRow Label="@(Kind == RowKind.Banner ? L["BannerStyle"] : L["CardFormat"])" Hint="@DisplayHint">
            <K7ButtonGroup TValue="HomeRowDisplayType"
                           Options="DisplayOptions"
                           Value="_displayType"
                           ValueChanged="@(value => _displayType = value)"
                           AriaLabel="@(Kind == RowKind.Banner ? L["BannerStyle"] : L["CardFormat"])" />
        </K7SettingRow>

        @if (Kind == RowKind.Banner)
        {
            <K7SettingRow Label="@L["AutoAdvance"]" Hint="@L["AutoAdvanceHint"]">
                <K7Select TValue="int" @bind-Value="_autoAdvanceSeconds" Variant="outlined">
                    @foreach (var seconds in _autoAdvanceOptions)
                    {
                        <K7SelectItem Value="@seconds" Text="@GetAutoAdvanceLabel(seconds)">@GetAutoAdvanceLabel(seconds)</K7SelectItem>
                    }
                </K7Select>
            </K7SettingRow>
        }

        <K7SettingRow Label="@L["ItemCount"]">
            <K7Select TValue="int" @bind-Value="_pageSize" Variant="outlined">
                @foreach (var size in PageSizeOptions)
                {
                    <K7SelectItem Value="@size" Text="@size.ToString()">@size</K7SelectItem>
                }
            </K7Select>
        </K7SettingRow>
    </div>
</div>
<div class="k7-dialog-actions">
    <K7Button OnClick="Cancel">@S["Cancel"]</K7Button>
    <K7Button Color="primary" Variant="filled" OnClick="Submit"
              Disabled="@(string.IsNullOrWhiteSpace(_title))">
        @S["Save"]
    </K7Button>
</div>
