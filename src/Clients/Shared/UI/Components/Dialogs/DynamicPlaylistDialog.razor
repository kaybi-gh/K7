@using K7.Server.Domain.Enums
@using K7.Shared.Dtos.Rules
@inject IPlaylistService K7ServerService
@inject IMediaService MediaService
@inject IK7Snackbar Snackbar
@inject IStringLocalizer<DynamicPlaylistDialog> L
@inject IStringLocalizer<LibraryBrowseFilters> BrowseL
@inject IStringLocalizer<SharedResource> S

<div class="k7-dialog-content smart-playlist-dialog">
    <div>
        <K7SettingRow Label="@L["NameLabel"]" Required="true">
            <K7TextField @bind-Value="_title" Variant="outlined"
                          Required="true" RequiredError="@L["NameRequired"]" MaxLength="200" />
        </K7SettingRow>
        <K7SettingRow Label="@L["DescriptionOptional"]" Stacked="true">
            <K7TextField @bind-Value="_description"
                          Variant="outlined" Lines="2" MaxLength="2000" />
        </K7SettingRow>

        @if (ForCollection)
        {
            <K7SettingRow Label="@L["VisibilityScope"]">
                <K7VisibilityScopeSelect @bind-Value="_visibilityScope" Variant="outlined" />
            </K7SettingRow>
        }

        <K7SettingRow Label="@L["MediaType"]">
            <K7Select TValue="MediaType" Value="_mediaType" ValueChanged="OnMediaTypeChanged"
                       Variant="outlined">
                @if (ForCollection)
                {
                    <K7SelectItem TValue="MediaType" Value="MediaType.Movie" Text="@S["MediaTypeMovies"]">@S["MediaTypeMovies"]</K7SelectItem>
                    <K7SelectItem TValue="MediaType" Value="MediaType.Serie" Text="@S["MediaTypeSeries"]">@S["MediaTypeSeries"]</K7SelectItem>
                    <K7SelectItem TValue="MediaType" Value="MediaType.SerieSeason" Text="@S["MediaTypeSerieSeasons"]">@S["MediaTypeSerieSeasons"]</K7SelectItem>
                    <K7SelectItem TValue="MediaType" Value="MediaType.SerieEpisode" Text="@S["MediaTypeSerieEpisodes"]">@S["MediaTypeSerieEpisodes"]</K7SelectItem>
                    <K7SelectItem TValue="MediaType" Value="MediaType.MusicAlbum" Text="@S["MediaTypeMusicAlbums"]">@S["MediaTypeMusicAlbums"]</K7SelectItem>
                    <K7SelectItem TValue="MediaType" Value="MediaType.MusicTrack" Text="@S["MediaTypeMusicTracks"]">@S["MediaTypeMusicTracks"]</K7SelectItem>
                    <K7SelectItem TValue="MediaType" Value="MediaType.MusicArtist" Text="@S["MediaTypeMusicArtists"]">@S["MediaTypeMusicArtists"]</K7SelectItem>
                }
                else
                {
                    <K7SelectItem TValue="MediaType" Value="MediaType.MusicTrack" Text="@S["MediaTypeMusic"]">@S["MediaTypeMusic"]</K7SelectItem>
                    <K7SelectItem TValue="MediaType" Value="MediaType.Movie" Text="@S["MediaTypeMovies"]">@S["MediaTypeMovies"]</K7SelectItem>
                    <K7SelectItem TValue="MediaType" Value="MediaType.SerieEpisode" Text="@S["MediaTypeTVShows"]">@S["MediaTypeTVShows"]</K7SelectItem>
                }
            </K7Select>
        </K7SettingRow>
    </div>

    <K7RuleEditor Value="_ruleFilter"
                  ValueChanged="OnRuleFilterChanged"
                  FieldDescriptors="_fieldDescriptors"
                  SearchSuggestionsAsync="SearchSuggestionsAsync" />

    <div>
        <K7SettingRow Label="@L["SortBy"]">
            <K7Select TValue="DynamicPlaylistOrderBy" @bind-Value="_orderBy"
                       Variant="outlined">
                @foreach (var order in _orderByOptions)
                {
                    <K7SelectItem Value="@order" Text="@GetOrderByLabel(order)">@GetOrderByLabel(order)</K7SelectItem>
                }
            </K7Select>
        </K7SettingRow>
        <K7SettingRow Label="@L["Descending"]">
            <K7Switch @bind-Value="_orderDescending" AriaLabel="@L["Descending"]" />
        </K7SettingRow>
        <K7SettingRow Label="@L["Limit"]">
            <K7TextField TValue="int?" Type="number" @bind-Value="_limit"
                         Variant="outlined" Clearable="true" />
        </K7SettingRow>
    </div>
</div>
<div class="k7-dialog-actions">
    <K7Button OnClick="Cancel">@S["Cancel"]</K7Button>
    <K7Button Color="primary" Variant="filled" OnClick="SubmitAsync"
               Disabled="@(string.IsNullOrWhiteSpace(_title) || _isSubmitting)">
        @if (_isSubmitting)
        {
            <K7Spinner Size="sm" />
            <span class="ms-2">@(_isEdit ? L["Saving"] : L["Creating"])</span>
        }
        else { <span>@(_isEdit ? S["Save"] : S["Create"])</span> }
    </K7Button>
</div>
