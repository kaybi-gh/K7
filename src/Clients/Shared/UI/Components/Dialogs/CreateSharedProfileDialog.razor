@using K7.Shared.Dtos.SharedProfiles
@inject IStringLocalizer<CreateSharedProfileDialog> L
@inject IStringLocalizer<SharedResource> S

<div class="k7-dialog-content">
    @if (_loading)
    {
        <K7ProgressBar Indeterminate="true" />
    }
    else
    {
        <div class="d-flex flex-col mt-2 gap-3">
            <K7TextField @bind-Value="_name" Label="@L["GroupName"]" Variant="outlined" Required="true" />

            <div>
                <span class="text-sm text-muted">@L["Members"]</span>
                <p class="text-xs text-secondary mt-1 mb-0">@L["MembersMinHint"]</p>
                <K7Alert Severity="K7Severity.Info" Variant="outlined" NoIcon="true" Class="mt-2 mb-2">
                    @L["MembersInvitationHint"]
                </K7Alert>
                <K7CheckboxList TItem="SharedProfileMemberCandidateDto"
                                Items="_candidates"
                                IsChecked="@(c => _selectedMemberIds.Contains(c.Id))"
                                IsDisabled="@(c => c.Id == _currentUserId)"
                                CheckedChanged="@(e => ToggleMember(e.Item.Id, e.Checked))">
                    <ItemTemplate Context="candidate">
                        <K7Avatar Size="sm" Image="@candidate.AvatarUrl" Letter="@GetInitial(candidate)" />
                        <span class="text-sm">@(candidate.DisplayName ?? "-")</span>
                    </ItemTemplate>
                </K7CheckboxList>
                @if (!_loading && _selectedMemberIds.Count < 2)
                {
                    <K7Alert Severity="K7Severity.Warning" Variant="outlined" NoIcon="true" Class="mt-2 mb-0">
                        @L["MembersMinRequired"]
                    </K7Alert>
                }
            </div>

            @if (_selectedMemberIds.Count >= 2)
            {
                <K7Select TValue="Guid" @bind-Value="_hostUserId" Label="@L["Host"]" Variant="outlined"
                          ToStringFunc="@GetMemberDisplayName"
                          FullWidth="true">
                    @foreach (var memberId in _selectedMemberIds)
                    {
                        <K7SelectItem TValue="Guid" Value="@memberId" Text="@GetMemberDisplayName(memberId)">
                            @GetMemberDisplayName(memberId)
                        </K7SelectItem>
                    }
                </K7Select>
            }

            <div>
                <span class="text-sm text-muted">@L["PinSectionTitle"]</span>
                <p class="text-xs text-secondary mt-1 mb-2">@L["GroupPinHelper"]</p>
                <div class="d-flex flex-wrap gap-2">
                    @if (_hasPin)
                    {
                        <K7Button Variant="outlined" OnClick="ChangePinAsync" Disabled="_isSubmitting">@L["ChangePin"]</K7Button>
                        <K7Button Variant="text" Color="error" OnClick="RemovePinAsync" Disabled="_isSubmitting">@L["RemovePin"]</K7Button>
                    }
                    else
                    {
                        <K7Button Variant="outlined" OnClick="SetPinAsync" Disabled="_isSubmitting">@L["SetPin"]</K7Button>
                    }
                </div>
            </div>
        </div>
    }
</div>
<div class="k7-dialog-actions">
    <K7Button OnClick="Cancel">@S["Cancel"]</K7Button>
    <K7Button Color="primary" Variant="filled" OnClick="SubmitAsync"
               Disabled="@(_isSubmitting || _loading || string.IsNullOrWhiteSpace(_name) || _selectedMemberIds.Count < 2)">
        @if (_isSubmitting)
        {
            <K7Spinner Size="sm" />
        }
        @(EditGroup is null ? L["Create"] : L["Save"])
    </K7Button>
</div>
