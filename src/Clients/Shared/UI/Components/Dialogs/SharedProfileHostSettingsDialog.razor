@namespace K7.Clients.Shared.UI.Components.Dialogs
@using K7.Shared.Dtos
@using K7.Shared.Dtos.Entities.Playlists
@using K7.Shared.Dtos.Restrictions
@using K7.Shared.Dtos.SharedProfiles
@inject IStringLocalizer<SharedProfileHostSettingsDialog> L
@inject IStringLocalizer<SharedResource> S

@if (_loading)
{
    <div class="k7-dialog-content">
        <K7Spinner />
    </div>
}
else
{
    <div class="k7-dialog-content host-settings">
        @* Who this is about first: the profile's avatar and name, with the avatar actions beside. *@
        <div class="host-settings__identity">
            @if (!string.IsNullOrEmpty(_avatarUrl))
            {
                <K7Avatar Image="@_avatarUrl" Letter="@_avatarLetter" Size="xl" Alt="@Group.Name" />
            }
            else
            {
                <K7AvatarGroup Size="lg" Members="@_memberAvatarItems" />
            }
            <div class="host-settings__identity-text">
                <span class="host-settings__identity-name">@Group.Name</span>
                <div class="host-settings__identity-actions">
                    <K7Button Variant="outlined" Size="sm" OnClick="UploadAvatar" Disabled="_saving"
                              @attributes="_initialFocusAttributes">@L["UploadAvatar"]</K7Button>
                    @if (!string.IsNullOrEmpty(_avatarUrl))
                    {
                        <K7Button Variant="text" Size="sm" Color="error" OnClick="RemoveAvatar" Disabled="_saving">@L["RemoveAvatar"]</K7Button>
                    }
                </div>
            </div>
        </div>
        <p class="host-settings__hint">@L["Description"]</p>
        <InputFile id="@_avatarFileInputId" OnChange="OnAvatarFileSelected" accept="image/*" style="display:none" />
        @if (_avatarError is not null)
        {
            <K7Alert Severity="K7Severity.Error">@_avatarError</K7Alert>
        }

        <div>
            <h6 class="host-settings__heading">@L["RestrictionTitle"]</h6>
            <K7SettingRow Label="@L["AgeRestrictionEnabled"]" Hint="@L["AgeRestrictionHelp"]">
                <K7Switch AriaLabel="@L["AgeRestrictionEnabled"]" @bind-Value="_ageRestrictionEnabled" />
            </K7SettingRow>
            <K7SettingRow Label="@L["DateOfBirth"]" Hint="@L["DateOfBirthHelp"]" Required="_ageRestrictionEnabled">
                <K7TextField TValue="string" Type="date"
                             @bind-Value="_dateOfBirthText"
                             Required="_ageRestrictionEnabled" />
            </K7SettingRow>
            <K7SettingRow Label="@L["HideUnratedTitles"]">
                <K7Switch AriaLabel="@L["HideUnratedTitles"]"
                          @bind-Value="_hideUnratedTitles"
                          Disabled="@(!_ageRestrictionEnabled)" />
            </K7SettingRow>
            <K7SettingRow Label="@L["RestrictionProfile"]" Hint="@L["RestrictionProfileHelp"]">
                <K7Select TValue="Guid?" @bind-Value="_restrictionProfileId" Clearable="true">
                    @foreach (var profile in _restrictionProfiles)
                    {
                        <K7SelectItem Value="@((Guid?)profile.Id)" Text="@profile.Name" />
                    }
                </K7Select>
            </K7SettingRow>
        </div>
        @if (_restrictionError is not null)
        {
            <K7Alert Severity="K7Severity.Error">@_restrictionError</K7Alert>
        }

        <div>
            <h6 class="host-settings__heading">@L["PlaylistsTitle"]</h6>
            <p class="host-settings__hint">@L["PlaylistsDescription"]</p>
        </div>
        @if (_playlists.Count == 0)
        {
            <p class="host-settings__hint">@L["NoPlaylists"]</p>
        }
        else
        {
            <K7CheckboxList TItem="LitePlaylistDto"
                            Items="_playlists"
                            IsChecked="@(playlist => _sharedPlaylistIds.Contains(playlist.Id))"
                            IsDisabled="@(_ => _saving)"
                            CheckedChanged="@(change => OnPlaylistShareChanged(change.Item.Id, change.Checked))">
                <ItemTemplate Context="playlist">
                    <K7Icon Icon="@Phosphor.Queue" IconSize="@K7IconSize.Sm" />
                    <span class="host-settings__text">
                        <span class="host-settings__name">@playlist.Title</span>
                        @if (!string.IsNullOrEmpty(playlist.Description))
                        {
                            <span class="host-settings__secondary">@playlist.Description</span>
                        }
                    </span>
                </ItemTemplate>
            </K7CheckboxList>
        }
    </div>

    <div class="k7-dialog-actions">
        <K7Button Variant="text" OnClick="Cancel" Disabled="_saving">@S["Cancel"]</K7Button>
        <K7Button OnClick="SaveAsync" Disabled="_saving">@S["Save"]</K7Button>
    </div>
}
