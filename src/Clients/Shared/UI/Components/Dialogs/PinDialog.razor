@inject IStringLocalizer<PinDialog> L
@inject IStringLocalizer<SharedResource> S

<div class="pin-dialog focusable"
     @ref="_rootRef"
     tabindex="0"
     role="group"
     data-initial-focus
     aria-label="@L["PinLabel"]"
     @onkeydown="OnKeyDown">
    <div class="k7-dialog-content pin-dialog__content">
        @if (!string.IsNullOrEmpty(UserName))
        {
            <p class="pin-dialog__hint">@((MarkupString)string.Format(L["EnterForUser"], UserName))</p>
        }

        <div class="pin-dialog__slots" aria-hidden="true">
            @for (var i = 0; i < PinLength; i++)
            {
                var filled = i < _pin.Length;
                var active = i == _pin.Length && _pin.Length < PinLength;
                <div class="pin-dialog__slot @(filled ? "pin-dialog__slot--filled" : "") @(active ? "pin-dialog__slot--active" : "")">
                    @if (filled)
                    {
                        <span class="pin-dialog__dot"></span>
                    }
                </div>
            }
        </div>

        <div class="pin-dialog__keypad">
            @foreach (var digit in Digits)
            {
                var d = digit;
                <button type="button"
                        class="pin-dialog__key focusable"
                        aria-label="@string.Format(L["DigitAria"], d)"
                        @onclick="() => AppendDigit(d)">
                    @d
                </button>
            }
            <button type="button"
                    class="pin-dialog__key pin-dialog__key--action focusable"
                    aria-label="@L["BackspaceAria"]"
                    @onclick="Backspace">
                <K7Icon Icon="@Phosphor.Backspace" IconSize="@K7IconSize.Md" />
            </button>
            <button type="button"
                    class="pin-dialog__key focusable"
                    aria-label="@string.Format(L["DigitAria"], 0)"
                    @onclick="() => AppendDigit('0')">
                0
            </button>
            <button type="button"
                    class="pin-dialog__key pin-dialog__key--action focusable"
                    aria-label="@L["ClearAria"]"
                    @onclick="Clear"
                    disabled="@string.IsNullOrEmpty(_pin)">
                <K7Icon Icon="@Phosphor.X" IconSize="@K7IconSize.Md" />
            </button>
        </div>
    </div>

    <div class="k7-dialog-actions pin-dialog__actions">
        <K7Button OnClick="Cancel">@S["Cancel"]</K7Button>
    </div>
</div>
