@using K7.Clients.Shared.Helpers
@using K7.Clients.Shared.Interfaces
@using K7.Clients.Shared.Models
@inject IStringLocalizer<SmartPlaylistDialog> L
@inject IMusicIntelligenceClientService MusicIntelligence
@inject IMediaService MediaService
@inject IK7ServerService ApiClient
@inject IAudioPlayerService Audio
@inject IK7Snackbar Snackbar
@inject IStringLocalizer<SharedResource> S
@inject IServerPreferencesService ServerPreferences

<div class="k7-dialog-content">
    <div class="d-flex flex-col gap-4 pa-4 ai-smart-playlist-dialog">
        <K7Select TValue="AiPlaylistMode" Value="_mode" ValueChanged="OnModeChanged" Label="@L["ModeLabel"]" Variant="outlined">
            @if (_instantPlaylistAvailable)
            {
                <K7SelectItem TValue="AiPlaylistMode" Value="AiPlaylistMode.Prompt" Text="@L["ModePrompt"]">@L["ModePrompt"]</K7SelectItem>
            }
            <K7SelectItem TValue="AiPlaylistMode" Value="AiPlaylistMode.Sonic" Text="@L["ModeSonic"]">@L["ModeSonic"]</K7SelectItem>
            <K7SelectItem TValue="AiPlaylistMode" Value="AiPlaylistMode.Lyrics" Text="@L["ModeLyrics"]">@L["ModeLyrics"]</K7SelectItem>
        </K7Select>

        <K7TextField @bind-Value="_prompt"
                     Label="@L["Prompt"]"
                     Placeholder="@GetPlaceholder()"
                     HelperText="@GetHelperText()" />

        @if (_examples.Length > 0)
        {
            <div class="ai-smart-playlist-dialog__examples">
                @foreach (var example in _examples)
                {
                    <button type="button"
                            class="ai-smart-playlist-dialog__chip"
                            @onclick="() => UseExample(example)">
                        @example
                    </button>
                }
            </div>
        }

        <div class="d-flex gap-2 justify-end">
            <K7Button OnClick="Cancel" Variant="K7ButtonVariant.Text">@L["Cancel"]</K7Button>
            <K7Button OnClick="Generate" Variant="K7ButtonVariant.Filled" Disabled="string.IsNullOrWhiteSpace(_prompt) || _loading">
                @if (_loading)
                {
                    <K7Spinner Size="16" />
                }
                else
                {
                    @L["Generate"]
                }
            </K7Button>
        </div>
    </div>
</div>
