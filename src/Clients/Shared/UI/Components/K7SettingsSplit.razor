@namespace K7.Clients.Shared.UI.Components

<div class="k7-settings-split @(DetailOpen ? "k7-settings-split--detail-open" : "") @(WideIndex ? "k7-settings-split--wide-index" : "") @Class">
    @if (Header is not null)
    {
        <div class="k7-settings-split__intro">
            @Header
        </div>
    }
    <div class="k7-settings-split__panes">
        <nav class="k7-settings-split__index" aria-label="@IndexLabel">
            @Index
        </nav>
        <div class="k7-settings-split__detail">
            @if (ExtraLeads)
            {
                @ExtraPanel
            }
            <section class="k7-settings-split__panel">
                <header class="k7-settings-split__header">
                    @if (!ExtraLeads)
                    {
                        @BackLink
                    }
                    <h5 class="k7-settings-split__title">@DetailTitle</h5>
                </header>
                <div class="k7-settings-split__body">
                    @Detail
                </div>
            </section>
            @if (Extra is not null && !ExtraLeads)
            {
                @ExtraPanel
            }
        </div>
        @if (Footer is not null || SaveState != SettingsSaveState.Idle)
        {
            <div class="k7-settings-split__footer">
                @Footer
                <K7SaveIndicator State="SaveState" />
            </div>
        }
    </div>
</div>

@code {
    // The way back to the index stays at the top of the sub-page: in the first panel, whichever
    // it is.
    private RenderFragment BackLink => __builder =>
    {
        <a class="k7-settings-split__back focusable" href="@BackHref">
            <K7Icon Icon="@Phosphor.ArrowLeft" IconSize="@K7IconSize.Sm" />
            <span>@IndexLabel</span>
        </a>
    };

    private RenderFragment ExtraPanel => __builder =>
    {
        <section class="k7-settings-split__panel k7-settings-split__panel--extra">
            <header class="k7-settings-split__header">
                @if (ExtraLeads)
                {
                    @BackLink
                }
                <h5 class="k7-settings-split__title">@ExtraTitle</h5>
            </header>
            <div class="k7-settings-split__body">
                @Extra
            </div>
        </section>
    };
}
