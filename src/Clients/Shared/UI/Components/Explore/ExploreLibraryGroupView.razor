@using K7.Clients.Shared.UI.Components.Explore
@using K7.Clients.Shared.UI.Components.Music
@using K7.Clients.Shared.UI.Pages
@using K7.Server.Domain.Enums
@inject IStringLocalizer<ExplorePage> L

@if (!IsTv)
{
    <header class="explore-group-header">
        <div class="explore-group-header__start">
            <K7IconButton Icon="@Phosphor.ArrowLeft"
                          Size="sm"
                          AriaLabel="@L["Back"]"
                          OnClick="GoBack" />
            <h1 class="explore-group-header__title">@Group.Title</h1>
        </div>
        <K7Button Variant="filled"
                  Color="primary"
                  StartIcon="@Phosphor.SquaresFour"
                  OnClick="GoToBrowse">
            @L["BrowseAll"]
        </K7Button>
    </header>
}

<ExploreSectionContent IsTv="IsTv"
                       IsLoading="_loading"
                       GroupTitle="@(IsTv ? Group.Title : null)"
                       BrowseHref="@(IsTv ? BrowseHref : null)"
                       BrowseLabel="@(IsTv ? L["BrowseAll"].Value : null)"
                       BackAriaLabel="@(IsTv ? L["Back"].Value : null)"
                       OnBack="GoBack">
    @switch (Group.MediaType)
    {
        case LibraryMediaType.Movie:
            <TvFeedRow Index="0" KeepMounted="true">
                <HomeFeedCarouselRow Title="@L["RecentlyAddedMovies"]" LibraryIds="_libraryIds" LibraryGroupIds="_libraryGroupIds" MediaTypes="_movieTypes" OrderBy="CreatedOrder" ProgressEnabled="true" />
            </TvFeedRow>
            <TvFeedRow Index="1" KeepMounted="true">
                <MediasCarouselRow Title="@L["TrendingMovies"]" LibraryIds="_libraryIds" LibraryGroupIds="_libraryGroupIds" MediaTypes="_movieTypes" OrderBy="TrendingOrder" ProgressEnabled="true" />
            </TvFeedRow>
            @for (var genreIndex = 0; genreIndex < _genres.Count; genreIndex++)
            {
                var genre = _genres[genreIndex];
                <TvFeedRow Index="@(2 + genreIndex)" KeepMounted="true">
                    <MediasCarouselRow Title="@string.Format(L["BestMoviesGenre"].Value, genre.DisplayName)"
                                       LibraryIds="_libraryIds"
                                       LibraryGroupIds="_libraryGroupIds"
                                       MediaTypes="_movieTypes"
                                       Genres="@(new[] { genre.DisplayName })"
                                       OrderBy="ProviderRatingOrder"
                                       UnwatchedOnly="true"
                                       ProgressEnabled="true" />
                </TvFeedRow>
            }
            break;
        case LibraryMediaType.Serie:
            <TvFeedRow Index="0" KeepMounted="true">
                <HomeFeedCarouselRow Title="@L["RecentlyAddedSeries"]" LibraryIds="_libraryIds" LibraryGroupIds="_libraryGroupIds" MediaTypes="_serieTypes" OrderBy="CreatedOrder" ProgressEnabled="true" />
            </TvFeedRow>
            <TvFeedRow Index="1" KeepMounted="true">
                <MediasCarouselRow Title="@L["TrendingSeries"]" LibraryIds="_libraryIds" LibraryGroupIds="_libraryGroupIds" MediaTypes="_serieTypes" OrderBy="TrendingOrder" ProgressEnabled="true" />
            </TvFeedRow>
            @for (var genreIndex = 0; genreIndex < _genres.Count; genreIndex++)
            {
                var genre = _genres[genreIndex];
                <TvFeedRow Index="@(2 + genreIndex)" KeepMounted="true">
                    <MediasCarouselRow Title="@string.Format(L["BestSeriesGenre"].Value, genre.DisplayName)"
                                       LibraryIds="_libraryIds"
                                       LibraryGroupIds="_libraryGroupIds"
                                       MediaTypes="_serieTypes"
                                       Genres="@(new[] { genre.DisplayName })"
                                       OrderBy="ProviderRatingOrder"
                                       UnwatchedOnly="true"
                                       ProgressEnabled="true" />
                </TvFeedRow>
            }
            break;
        case LibraryMediaType.Music:
            <TvFeedRow Index="0">
                <MusicRadioPresets Title="@L["Radios"]" LibraryGroupIds="_libraryGroupIds" />
            </TvFeedRow>
            <TvFeedRow Index="1" KeepMounted="true">
                <HomeFeedCarouselRow Title="@L["RecentlyAddedMusic"]" LibraryIds="_libraryIds" LibraryGroupIds="_libraryGroupIds" MediaTypes="_musicAlbumTypes" OrderBy="CreatedOrder" />
            </TvFeedRow>
            <TvFeedRow Index="2" KeepMounted="true">
                <MediasCarouselRow Title="@L["TrendingAlbums"]" LibraryIds="_libraryIds" LibraryGroupIds="_libraryGroupIds" MediaTypes="_musicAlbumTypes" OrderBy="TrendingOrder" />
            </TvFeedRow>
            <TvFeedRow Index="3">
                <ExploreTopTracksTable LibraryIds="_libraryIds" IsTv="IsTv" />
            </TvFeedRow>
            break;
    }
</ExploreSectionContent>
