@namespace K7.Clients.Shared.UI.Components
@typeparam TValue
@inject IStringLocalizer<SharedResource> S

<div class="k7-field @Class" style="@(string.IsNullOrEmpty(Style) ? null : Style)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="k7-label @(Required ? "k7-label--required" : "")" for="@_id">@Label</label>
    }
    @if (Lines > 1)
    {
        <textarea id="@_id"
                  @ref="_inputRef"
                  class="k7-textarea focusable @(_hasError ? "k7-input--error" : "")"
                  placeholder="@Placeholder"
                  disabled="@Disabled"
                  readonly="@ReadOnly"
                  data-sn-activatable="@SpatialActivatable"
                  rows="@Lines"
                  maxlength="@(MaxLength > 0 ? MaxLength : int.MaxValue)"
                  value="@Value"
                  @attributes="UserAttributes"
                  @oninput="OnInput"
                  @onchange="OnChange"
                  @onfocus="HandleFocusAsync"
                  @onfocusout="OnFocusOut"
                  @onkeydown="OnKeyDown"
                  @onkeyup="OnKeyUp"
                  @onclick="OnClick"></textarea>
    }
    else
    {
        <div class="k7-input-wrap">
            <input id="@_id"
                   @ref="_inputRef"
                   class="k7-input focusable @(_hasError ? "k7-input--error" : "") @(HasAdornment ? "k7-input--has-adornment" : "")"
                   type="@EffectiveInputType"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   data-sn-activatable="@SpatialActivatable"
                   maxlength="@(MaxLength > 0 ? MaxLength : int.MaxValue)"
                   value="@Value"
                   @attributes="UserAttributes"
                   @oninput="OnInput"
                   @onchange="OnChange"
                   @onfocus="HandleFocusAsync"
                   @onfocusout="OnFocusOut"
                   @onkeydown="OnKeyDown"
                   @onkeyup="OnKeyUp"
                   @onclick="OnClick" />
            @if (ShowPasswordToggleButton)
            {
                <K7IconButton Icon="@(_passwordRevealed ? Phosphor.Eye : Phosphor.EyeClosed)"
                               Class="k7-input-adornment"
                               OnClick="TogglePasswordReveal"
                               AriaLabel="@(_passwordRevealed ? S["HidePassword"] : S["ShowPassword"])" />
            }
            else if (Clearable && Value is not null && !string.IsNullOrEmpty(Value.ToString()))
            {
                <K7IconButton Icon="@Phosphor.X" Class="k7-input-adornment k7-input-clear" OnClick="ClearAsync" AriaLabel="clear" />
            }
            else if (!string.IsNullOrEmpty(AdornmentIcon))
            {
                <K7IconButton Icon="@AdornmentIcon" Class="k7-input-adornment" OnClick="OnAdornmentClick" />
            }
        </div>
    }
    @if (_hasError)
    {
        <span class="k7-field-error">@_errorText</span>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <span class="k7-field-helper">@HelperText</span>
    }
</div>
