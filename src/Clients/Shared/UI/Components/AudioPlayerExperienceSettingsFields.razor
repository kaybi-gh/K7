@using K7.Clients.Shared.UI.Pages
@inject IStringLocalizer<SettingsAudioPlayerPage> L

@if (Settings is not null)
{
    @switch (Section)
    {
        case AudioSettingsSections.Loudness:
            <K7SettingRow Label="@L["EnableLoudness"]">
                <K7Switch AriaLabel="@L["EnableLoudness"]" Value="Settings.LoudnessEnabled" ValueChanged="v => OnChanged(s => s.LoudnessEnabled = v)" />
            </K7SettingRow>

            @if (Settings.LoudnessEnabled)
            {
                <div class="settings-field-group">
                    <K7Slider TValue="double" Min="-26" Max="-6" Step="1" Immediate="true"
                              Label="@L["TargetLoudness"]"
                              FormatValue="FormatLufs"
                              Value="Settings.LoudnessTargetLufs"
                              ValueChanged="v => OnChanged(s => s.LoudnessTargetLufs = v)" />

                    <K7Slider TValue="double" Min="-6" Max="6" Step="0.5" Immediate="true"
                              Label="@L["PreAmp"]"
                              FormatValue="FormatPreampDb"
                              Value="Settings.LoudnessPreampDb"
                              ValueChanged="v => OnChanged(s => s.LoudnessPreampDb = v)" />
                </div>

                <K7SettingRow Label="@L["EnableLimiter"]">
                    <K7Switch AriaLabel="@L["EnableLimiter"]" Value="Settings.LimiterEnabled" ValueChanged="v => OnChanged(s => s.LimiterEnabled = v)" />
                </K7SettingRow>
            }
            break;

        case AudioSettingsSections.Equalizer:
            <K7SettingRow Label="@L["EnableEqualizer"]">
                <K7Switch AriaLabel="@L["EnableEqualizer"]" Value="Settings.EqEnabled" ValueChanged="v => OnChanged(s => s.EqEnabled = v)" />
            </K7SettingRow>

            @if (Settings.EqEnabled)
            {
                <K7SettingRow Label="@L["Preset"]">
                    <K7Select Value="Settings.EqPresetName" ValueChanged="OnPresetChanged" TValue="string">
                        <K7SelectItem Value="@("flat")" Text="@L["PresetFlat"]">@L["PresetFlat"]</K7SelectItem>
                        <K7SelectItem Value="@("bass-boost")" Text="@L["PresetBassBoost"]">@L["PresetBassBoost"]</K7SelectItem>
                        <K7SelectItem Value="@("treble-boost")" Text="@L["PresetTrebleBoost"]">@L["PresetTrebleBoost"]</K7SelectItem>
                        <K7SelectItem Value="@("vocal")" Text="@L["PresetVocal"]">@L["PresetVocal"]</K7SelectItem>
                        <K7SelectItem Value="@("rock")" Text="@L["PresetRock"]">@L["PresetRock"]</K7SelectItem>
                        <K7SelectItem Value="@("electronic")" Text="@L["PresetElectronic"]">@L["PresetElectronic"]</K7SelectItem>
                        <K7SelectItem Value="@("custom")" Text="@L["PresetCustom"]">@L["PresetCustom"]</K7SelectItem>
                    </K7Select>
                </K7SettingRow>

                <div class="eq-bands">
                    @for (var i = 0; i < Settings.EqBands.Length; i++)
                    {
                        var index = i;
                        var bandValue = Settings.EqBands[index];
                        <div class="eq-band">
                            <span class="eq-band-value text-caption">@FormatEqBandValue(bandValue)</span>
                            <div class="eq-band-slider">
                                <K7Slider TValue="double" Min="-12" Max="12" Step="0.5"
                                          Vertical="true"
                                          Immediate="true"
                                          Value="bandValue"
                                          ValueChanged="v => OnBandChanged(index, v)" />
                            </div>
                            <span class="text-caption eq-band-label">@EqFrequencyLabels[index]</span>
                        </div>
                    }
                </div>
            }
            break;

        case AudioSettingsSections.Crossfade:
            <div class="settings-field-group">
                <K7Slider TValue="double" Min="0" Max="12" Step="1" Immediate="true"
                          Label="@L["CrossfadeDuration"]"
                          Hint="@(Settings.CrossfadeDuration <= 0 ? L["CrossfadeGaplessHint"].Value : null)"
                          FormatValue="FormatCrossfadeDuration"
                          Value="Settings.CrossfadeDuration"
                          ValueChanged="v => OnChanged(s => s.CrossfadeDuration = v)" />
            </div>

            @if (Settings.CrossfadeDuration > 0)
            {
                <K7SettingRow Label="@L["AdaptiveCrossfade"]" Hint="@L["AdaptiveCrossfadeHint"]">
                    <K7Switch AriaLabel="@L["AdaptiveCrossfade"]" Value="Settings.AdaptiveCrossfade" ValueChanged="v => OnChanged(s => s.AdaptiveCrossfade = v)" />
                </K7SettingRow>
            }
            break;

        case AudioSettingsSections.Autoplay:
            <K7SettingRow Label="@L["AutoplayDescription"]">
                <K7Switch AriaLabel="@L["AutoplayDescription"]" Value="Settings.AutoplayEnabled" ValueChanged="v => OnChanged(s => s.AutoplayEnabled = v)" />
            </K7SettingRow>
            break;

        case AudioSettingsSections.Quality:
            <K7SettingRow Label="@L["QualityWifi"]">
                <K7Select Value="Settings.StreamingQualityWifi" ValueChanged="v => OnChanged(s => s.StreamingQualityWifi = v)" TValue="int">
                    <K7SelectItem Value="0" Text="@L["Original"]">@L["Original"]</K7SelectItem>
                    <K7SelectItem Value="320" Text="320 kbps">320 kbps</K7SelectItem>
                    <K7SelectItem Value="256" Text="256 kbps">256 kbps</K7SelectItem>
                    <K7SelectItem Value="192" Text="192 kbps">192 kbps</K7SelectItem>
                    <K7SelectItem Value="128" Text="128 kbps">128 kbps</K7SelectItem>
                </K7Select>
            </K7SettingRow>

            <K7SettingRow Label="@L["QualityMobile"]">
                <K7Select Value="Settings.StreamingQualityMobile" ValueChanged="v => OnChanged(s => s.StreamingQualityMobile = v)" TValue="int">
                    <K7SelectItem Value="0" Text="@L["Original"]">@L["Original"]</K7SelectItem>
                    <K7SelectItem Value="320" Text="320 kbps">320 kbps</K7SelectItem>
                    <K7SelectItem Value="256" Text="256 kbps">256 kbps</K7SelectItem>
                    <K7SelectItem Value="192" Text="192 kbps">192 kbps</K7SelectItem>
                    <K7SelectItem Value="128" Text="128 kbps">128 kbps</K7SelectItem>
                </K7Select>
            </K7SettingRow>
            break;

        case AudioSettingsSections.Behavior:
            <K7SettingRow Label="@L["RememberMusicSession"]">
                <K7Switch AriaLabel="@L["RememberMusicSession"]" Value="Settings.RememberMusicSession != false" ValueChanged="v => OnChanged(s => s.RememberMusicSession = v)" />
            </K7SettingRow>

            <K7SettingRow Label="@L["ShowFullscreenOnPlay"]">
                <K7Switch AriaLabel="@L["ShowFullscreenOnPlay"]" Value="Settings.ShowFullscreenOnPlay" ValueChanged="v => OnChanged(s => s.ShowFullscreenOnPlay = v)" />
            </K7SettingRow>

            <K7SettingRow Label="@L["KeepScreenOn"]">
                <K7Switch AriaLabel="@L["KeepScreenOn"]" Value="Settings.KeepScreenOn" ValueChanged="v => OnChanged(s => s.KeepScreenOn = v)" />
            </K7SettingRow>

            <div class="settings-field-group">
                <K7Slider TValue="int" Min="5" Max="30" Step="5" Immediate="true"
                          Label="@L["SkipBackDuration"]"
                          FormatValue="FormatSkipSeconds"
                          Value="Settings.SkipBackSeconds"
                          ValueChanged="v => OnChanged(s => s.SkipBackSeconds = v)" />
                <K7Slider TValue="int" Min="5" Max="30" Step="5" Immediate="true"
                          Label="@L["SkipForwardDuration"]"
                          FormatValue="FormatSkipSeconds"
                          Value="Settings.SkipForwardSeconds"
                          ValueChanged="v => OnChanged(s => s.SkipForwardSeconds = v)" />
            </div>
            break;
    }
}
