@using K7.Server.Domain.Enums
@inject IStringLocalizer<LibraryProcessingSettingsSection> L

@if (ShowAny)
{
    <div class="d-flex flex-col gap-3">
        @if (ShowSectionTitle)
        {
            <h6 class="edit-library-section__title">@(SectionTitle ?? L["SectionTitle"])</h6>
        }

        <div>
            @if (LibraryProcessingSettingsDto.ShowIntroDetection(MediaType))
            {
                <K7SettingRow Label="@L["IntroDetection"]" Hint="@L["IntroDetectionDescription"]">
                    <K7Switch AriaLabel="@L["IntroDetection"]" Value="IntroDetectionEnabled" ValueChanged="OnIntroDetectionChangedAsync" Disabled="Disabled" />
                </K7SettingRow>
            }

            @if (LibraryProcessingSettingsDto.ShowThemeSongGeneration(MediaType))
            {
                <K7SettingRow Label="@L["ThemeSongGeneration"]" Hint="@L["ThemeSongGenerationDescription"]">
                    <K7Switch AriaLabel="@L["ThemeSongGeneration"]"
                              Value="ThemeSongGenerationEnabled && IntroDetectionEnabled"
                              ValueChanged="OnThemeSongGenerationChangedAsync"
                              Disabled="Disabled || !IntroDetectionEnabled" />
                </K7SettingRow>
            }

            @if (LibraryProcessingSettingsDto.ShowSeekbarThumbnails(MediaType))
            {
                <K7SettingRow Label="@L["SeekbarThumbnails"]">
                    <K7Switch AriaLabel="@L["SeekbarThumbnails"]" @bind-Value="SeekbarThumbnailGenerationEnabled" Disabled="Disabled" />
                </K7SettingRow>
            }

            @if (LibraryProcessingSettingsDto.ShowChapterExtraction(MediaType))
            {
                <K7SettingRow Label="@L["ChapterExtraction"]" Hint="@L["ChapterExtractionDescription"]">
                    <K7Switch AriaLabel="@L["ChapterExtraction"]" @bind-Value="ChapterExtractionEnabled" Disabled="Disabled" />
                </K7SettingRow>
            }

            @if (LibraryProcessingSettingsDto.ShowMusicAudioAnalysis(MediaType))
            {
                <K7SettingRow Label="@L["MusicAudioAnalysis"]">
                    <K7Switch AriaLabel="@L["MusicAudioAnalysis"]" @bind-Value="MusicAudioAnalysisEnabled" Disabled="Disabled" />
                </K7SettingRow>
            }

            @if (LibraryProcessingSettingsDto.ShowTranscodeOptions(MediaType))
            {
                <K7SettingRow Label="@L["Transcoding"]">
                    <K7Switch AriaLabel="@L["Transcoding"]" @bind-Value="TranscodingEnabled" Disabled="Disabled" />
                </K7SettingRow>
                <K7SettingRow Label="@L["Transmuxing"]">
                    <K7Switch AriaLabel="@L["Transmuxing"]" @bind-Value="TransmuxingEnabled" Disabled="Disabled" />
                </K7SettingRow>
            }
        </div>
    </div>
}
