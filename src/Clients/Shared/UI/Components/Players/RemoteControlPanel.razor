@using System.Globalization
@inject IRemoteControlService Remote
@inject IPlayerService PlayerService
@inject IK7ServerService K7Server
@inject ISpatialNavService SpatialNav
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> S

<div @ref="_root"
     class="remote-control-panel @(Remote.IsAudio ? "remote-control-panel--audio" : "remote-control-panel--video")"
     data-sn-layer="overlay"
     data-initial-focus=".remote-control-panel__play">
    <div class="remote-control-panel__header">
        <div class="remote-control-panel__header-start">
            <K7Icon Icon="@Phosphor.HandWithdraw" IconSize="@K7IconSize.Sm" />
            <span class="remote-control-panel__header-title">@string.Format(S["PlayingOn"], string.IsNullOrWhiteSpace(Remote.TargetDeviceName) ? "Device" : Remote.TargetDeviceName)</span>
        </div>
        <div class="remote-control-panel__header-actions">
            @if (!Remote.IsAudio)
            {
                <PlaybackSettingsMenu @bind-Open="_isMenuOpen" RemoteSession="true" Class="playback-settings-menu--remote" />
            }
            <K7IconButton Icon="@Phosphor.X" OnClick="OnLeaveWithoutStop" AriaLabel="@S["LeaveRemoteControl"]" />
        </div>
    </div>

    <div class="remote-control-panel__body">
        @if (Remote.CoverUrl is not null)
        {
            <div class="remote-control-panel__cover">
                <K7Image Src="@Remote.CoverUrl"
                         Alt=""
                         ObjectFit="cover"
                         Fluid="true"
                         LoadingMode="K7ImageLoadingMode.Css" />
            </div>
        }

        <div class="remote-control-panel__info">
            @if (!string.IsNullOrEmpty(Remote.Title))
            {
                <span class="remote-control-panel__title">@Remote.Title</span>
            }
            @if (!string.IsNullOrEmpty(Remote.Artist))
            {
                <span class="remote-control-panel__artist">@Remote.Artist</span>
            }
            @if (!string.IsNullOrEmpty(Remote.AlbumTitle))
            {
                <span class="remote-control-panel__album">@Remote.AlbumTitle</span>
            }
        </div>

        <RemoteControlSeekClock ThumbnailsUri="@_thumbnailsUri"
                                Chapters="@_chapters"
                                OnSeekRequested="OnSeekAsync" />

        <div class="remote-control-panel__transport">
            @* One stable button so 1 Hz state ticks do not remount and steal SpatialNav focus. *@
            <K7IconButton Class="remote-control-panel__play"
                          Icon="@(Remote.PlaybackState == RemotePlaybackState.Playing ? Phosphor.Pause : Phosphor.Play)"
                          OnClick="OnPlayPause"
                          Size="lg"
                          AriaLabel="@(Remote.PlaybackState == RemotePlaybackState.Playing ? "Pause" : "Play")"
                          data-initial-focus />
            <K7IconButton Icon="@Phosphor.Stop" OnClick="OnStop" AriaLabel="Stop" />
        </div>

        <div class="remote-control-panel__volume">
            <K7Icon Icon="@(Remote.Volume < 0.01 ? Phosphor.SpeakerNone : Phosphor.SpeakerHigh)" IconSize="@K7IconSize.Sm" />
            <K7Slider TValue="double"
                      Min="0" Max="1"
                      Step="0.01"
                      Immediate="true"
                      Value="@Remote.Volume"
                      ValueChanged="OnVolumeChanged"
                      Class="remote-control-panel__volume-slider" />
        </div>

        <div class="remote-control-panel__actions">
            <K7Button Variant="outlined" Size="sm" OnClick="OnResumeHere">
                <K7Icon Icon="@Phosphor.ArrowSquareIn" IconSize="@K7IconSize.Sm" /> @S["ResumeHere"]
            </K7Button>
            @if (Remote.MediaId is not null)
            {
                <K7Button Variant="outlined" Size="sm" OnClick="OnGoToMedia">
                    <K7Icon Icon="@Phosphor.Info" IconSize="@K7IconSize.Sm" /> @S["GoToMedia"]
                </K7Button>
            }
        </div>
    </div>
</div>
