@if (_rowWindow is not null)
{
    <CascadingValue Value="_rowWindow" IsFixed="true">
        @RenderRoot()
    </CascadingValue>
}
else
{
    @RenderRoot()
}

@{
    RenderFragment RenderRoot() => @<div class="vertical-carousel" @ref="_root" data-vcarousel-initial="@InitialActiveIndex">
        <div class="vertical-carousel__pagination" data-vcarousel-pagination aria-hidden="true" hidden>
            <i class="ph ph-caret-up vertical-carousel__chevron" data-vcarousel-chevron-up hidden></i>
            <div class="vertical-carousel__dots" data-vcarousel-dots></div>
            <i class="ph ph-caret-down vertical-carousel__chevron" data-vcarousel-chevron-down hidden></i>
        </div>
        <div class="vertical-carousel__viewport" data-vcarousel-viewport>
            <div class="vertical-carousel__container">
                @ChildContent
            </div>
        </div>
    </div>;
}
