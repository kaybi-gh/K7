@inject IRatingService K7ServerService
@inject IConnectivityService Connectivity
@inject IPlaybackJournal PlaybackJournal
@inject IFeatureAccessService FeatureAccess
@inject IUserRatingSync Ratings
@inject ILocalUserService LocalUsers

@if (ReadOnly || _canRate)
{
    @if (ReadOnly)
    {
        <span class="rating-stars rating-stars--readonly @SizeClass"
              role="img"
              aria-label="@(AriaLabel ?? DefaultAriaLabel)">
            @for (var i = 1; i <= RatingStarValue.StarCount; i++)
            {
                var star = i;
                <span class="rating-star @StarModifierClass(star)">
                    <span class="rating-star-empty">
                        <K7Icon Icon="@Phosphor.Star" IconSize="@IconSize" />
                    </span>
                    <span class="rating-star-fill">
                        <K7Icon Icon="@Phosphor.Fill.Star" IconSize="@IconSize" />
                    </span>
                </span>
            }
        </span>
    }
    else
    {
        <span @ref="_element"
              class="rating-stars focusable @SizeClass @(_isDragging ? "rating-stars--dragging" : "")"
              role="slider"
              data-sn-activatable
              aria-valuemin="0"
              aria-valuemax="@RatingStarValue.Max"
              aria-valuenow="@DisplayValue"
              aria-valuetext="@RatingStarValue.FormatStarsLabel(DisplayValue)"
              aria-label="Rating"
              tabindex="0"
              @onclick:stopPropagation="true"
              @onpointerdown:stopPropagation="true"
              @onkeydown="HandleKeyDown"
              @onpointerdown="OnPointerDown"
              @onpointermove="OnPointerMove"
              @onpointerup="OnPointerUp"
              @onlostpointercapture="OnPointerUp"
              @onpointercancel="OnPointerCancel"
              @onpointerleave="OnPointerLeave">
            @for (var i = 1; i <= RatingStarValue.StarCount; i++)
            {
                var star = i;
                <span class="rating-star @StarModifierClass(star)">
                    <span class="rating-star-empty">
                        <K7Icon Icon="@Phosphor.Star" IconSize="@IconSize" />
                    </span>
                    <span class="rating-star-fill">
                        <K7Icon Icon="@Phosphor.Fill.Star" IconSize="@IconSize" />
                    </span>
                </span>
            }
        </span>
    }
}
