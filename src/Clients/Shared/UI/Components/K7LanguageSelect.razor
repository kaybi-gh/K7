@namespace K7.Clients.Shared.UI.Components
@using K7.Shared
@using System.Globalization

<K7Select TValue="string" Value="@Value" ValueChanged="@ValueChanged" Label="@Label" Variant="@Variant" Class="@Class" Style="@Style" Disabled="Disabled">
    <SelectedContent>
        @{ var selected = DisplayLanguages.FirstOrDefault(l => l.Code == Value); }
        @if (selected is not null)
        {
            @if (selected.Code != TrackSelectionLanguages.Original)
            {
                <span class="fi fi-@selected.CountryCode"></span>
            }
            @GetDisplayText(selected)
        }
        else if (Value == TrackSelectionLanguages.Original)
        {
            @OriginalLanguageLabel
        }
    </SelectedContent>
    <ChildContent>
        @foreach (var lang in DisplayLanguages)
        {
            <K7SelectItem TValue="string" Value="@lang.Code" Text="@GetDisplayText(lang)">
                @if (lang.Code != TrackSelectionLanguages.Original)
                {
                    <span class="fi fi-@lang.CountryCode"></span>
                }
                @GetDisplayText(lang)
            </K7SelectItem>
        }
    </ChildContent>
</K7Select>
