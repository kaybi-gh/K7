@namespace K7.Clients.Shared.UI.Components
@using K7.Shared.Dtos.Notifications
@inject IStringLocalizer<ScrobbleWebhookPayloadEditor> L

<div class="d-flex flex-col gap-3">
    @if (ReadOnly)
    {
        <p class="text-caption" style="color: var(--color-text-muted);">@L["PresetReadOnlyHint"]</p>
    }

    <div>
        <p class="text-sm mb-1">@L["Events"]</p>
        <K7CheckboxList TItem="string"
                        Items="_allEvents"
                        IsChecked="@(e => EnabledEvents.Contains(e))"
                        CheckedChanged="@(e => OnEventToggled(e.Item, e.Checked))"
                        ItemLabel="@GetEventLabel" />
        <p class="text-caption mt-1" style="color: var(--color-text-muted);">@L["EventsHint"]</p>
        <p class="text-caption" style="color: var(--color-text-muted);">@L["SharedProfileHint"]</p>
    </div>

    @if (EnabledEvents.Count > 0)
    {
        <div class="d-flex align-center justify-between gap-2">
            <K7Tabs TValue="string" Tabs="_tabOptions" Value="_activeTab" ValueChanged="OnTabChanged" />
            <K7ButtonGroup TValue="bool" Options="_previewModeOptions" Value="_isPreviewMode"
                           ValueChanged="@(v => _isPreviewMode = v)" AriaLabel="@L["EditPreview"]" />
        </div>

        @if (!_isPreviewMode)
        {
            <K7TextField @ref="_templateField"
                         TValue="string"
                         Value="@GetActiveTemplate()"
                         ValueChanged="OnActiveTemplateChanged"
                         Label="@GetEventLabel(_activeTab)"
                         Variant="outlined"
                         Lines="8"
                         Immediate="true"
                         ReadOnly="ReadOnly"
                         HelperText="@(ReadOnly ? L["TemplateReadOnlyHelper"] : L["TemplateHelper"])" />
        }
        else
        {
            <K7Paper Outlined="true" Class="pa-4">
                <span class="text-caption" style="color: var(--color-text-muted);">@L["PreviewNote"]</span>
                <pre class="mt-2" style="white-space: pre-wrap; word-break: break-all; font-size: 0.85em;">@RenderPreview(GetActiveTemplate())</pre>
            </K7Paper>
        }

        @if (!ReadOnly)
        {
            <div>
                <span class="text-caption" style="color: var(--color-text-muted);">@L["AvailableParams"]</span>
                <K7GroupedList TItem="NotificationParameterInfoDto"
                               Groups="ParameterGroups"
                               Searchable="true"
                               SearchPlaceholder="@L["SearchParams"]"
                               ItemLabel="@(p => p.DisplayName)"
                               ItemDescription="@(p => FormatParamDescription(p))"
                               ItemKeywords="@(p => new[] { p.Name, p.DisplayName })"
                               ItemKeySelector="@(p => p.Name)"
                               ItemClicked="@(p => InsertParam(p.Name))" />
            </div>
        }
    }
</div>
