@namespace K7.Clients.Shared.UI.Components
@using K7.Shared.Dtos.Notifications
@inject IStringLocalizer<ScrobbleWebhookPayloadEditor> L

<div class="webhook-editor">
    <div>
        <K7SettingRow Label="@L["Events"]" Hint="@L["EventsHint"]" Stacked="true">
            <HintContent>@L["SharedProfileHint"]</HintContent>
            <ChildContent>
                <K7CheckboxList TItem="string"
                                Items="_allEvents"
                                IsChecked="@(e => EnabledEvents.Contains(e))"
                                CheckedChanged="@(e => OnEventToggled(e.Item, e.Checked))"
                                ItemLabel="@GetEventLabel"
                                Class="webhook-editor__events" />
            </ChildContent>
        </K7SettingRow>
    </div>

    @if (EnabledEvents.Count > 0)
    {
        @* What is sent for each event: folded by default, since presets and the default
           templates work as they are. *@
        <K7ExpansionPanel Text="@(ReadOnly ? L["PayloadTitleReadOnly"] : L["PayloadTitle"])">
            <div class="webhook-editor__payload">
                @if (ReadOnly)
                {
                    <p class="webhook-editor__note">@L["PresetReadOnlyHint"]</p>
                }

                <div class="webhook-editor__toolbar">
                    <K7Tabs TValue="string" Tabs="_tabOptions" Value="_activeTab" ValueChanged="OnTabChanged" />
                    <K7ButtonGroup TValue="bool" Options="_previewModeOptions" Value="_isPreviewMode"
                                   ValueChanged="@(v => _isPreviewMode = v)" AriaLabel="@L["EditPreview"]" />
                </div>

                <div class="webhook-editor__columns @(ReadOnly ? "webhook-editor__columns--single" : "")">
                    <div class="webhook-editor__template">
                        @if (!_isPreviewMode)
                        {
                            <K7TextField @ref="_templateField"
                                         TValue="string"
                                         Value="@GetActiveTemplate()"
                                         ValueChanged="OnActiveTemplateChanged"
                                         Label="@GetEventLabel(_activeTab)"
                                         Variant="outlined"
                                         Lines="10"
                                         Immediate="true"
                                         ReadOnly="ReadOnly"
                                         HelperText="@(ReadOnly ? L["TemplateReadOnlyHelper"] : L["TemplateHelper"])" />
                        }
                        else
                        {
                            <div class="webhook-editor__preview">
                                <span class="webhook-editor__note">@L["PreviewNote"]</span>
                                <pre class="webhook-editor__preview-text">@RenderPreview(GetActiveTemplate())</pre>
                            </div>
                        }
                    </div>

                    @if (!ReadOnly)
                    {
                        <div class="webhook-editor__params">
                            <span class="webhook-editor__note">@L["AvailableParams"]</span>
                            <K7GroupedList TItem="NotificationParameterInfoDto"
                                           Groups="ParameterGroups"
                                           Searchable="true"
                                           SearchPlaceholder="@L["SearchParams"]"
                                           ItemLabel="@(p => p.DisplayName)"
                                           ItemDescription="@(p => FormatParamDescription(p))"
                                           ItemKeywords="@(p => new[] { p.Name, p.DisplayName })"
                                           ItemKeySelector="@(p => p.Name)"
                                           ItemClicked="@(p => InsertParam(p.Name))" />
                        </div>
                    }
                </div>
            </div>
        </K7ExpansionPanel>
    }
</div>
