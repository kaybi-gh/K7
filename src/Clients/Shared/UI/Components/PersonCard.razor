@{
    RenderFragment body =
        @<div class="d-flex flex-col">
            <K7Avatar>
                @if (ImageUrl is not null)
                {
                    <K7Image Src="@ImageUrl" Alt="@Alt" Fluid="true" ObjectFit="cover" LoadingMode="K7ImageLoadingMode.Css" loading="lazy" />
                }
                else
                {
                    <K7Image Src="_content/K7.Clients.Shared.UI/images/person-placeholder.png" Alt="@Alt" Fluid="true" ObjectFit="cover" LoadingMode="K7ImageLoadingMode.Css" loading="lazy" />
                }
            </K7Avatar>

            <div class="person-footer">
                <div class="person-title"><span class="person-title-inner">@Title</span></div>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <div class="person-subtitle"><span class="person-subtitle-inner">@Subtitle</span></div>
                }
            </div>
        </div>;
}

@if (Href is not null)
{
    <a class="personrole-item focusable @HoverClass" href="@Href">@body</a>
}
else
{
    @* No person page to go to (public share): same card, not a link. *@
    <div class="personrole-item personrole-item--static">@body</div>
}
