@inject IStringLocalizer<SubtitlePreview> L

<div class="subtitle-preview">
    <div class="subtitle-preview__scene">
        <span class="subtitle-preview__text"
              style="font-family: @FontFamilyCss; font-size: @FontSizePx; color: @FontColorCss; background-color: @BackgroundCss; @TextShadowStyle">
            @L["SampleText"]
        </span>
    </div>
</div>
