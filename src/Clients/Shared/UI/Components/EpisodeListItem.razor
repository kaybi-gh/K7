@using K7.Server.Domain.Enums
@using K7.Shared.Dtos.Entities.Medias
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject IStringLocalizer<SharedResource> S

<div class="episode-card @(_menuOpen ? "episode-card--menu-open" : null)"
     data-longpress="true"
     @ontouchstart="OnTouchStart"
     @ontouchmove="OnTouchMove"
     @ontouchend="OnTouchEnd"
     @ontouchend:preventDefault="@_longPressTriggered"
     @ontouchcancel="OnTouchCancel"
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:preventDefault="true">
    <a class="episode-card-link focusable"
       href="@Href"
       data-episode-anchor="ep-@Episode.EpisodeNumber"
       @onclick="OnLinkClick"
       @onclick:preventDefault="@(PlayOnActivate || ShouldPreventLinkActivation)"
       @onfocusin="OnLinkFocusIn"
       @onkeydown="OnKeyDown"
       @onkeyup="OnKeyUp">
        <div class="episode-card-still">
            @if (!string.IsNullOrEmpty(StillUrl))
            {
                <K7Image Src="@StillUrl"
                          Alt="@Episode.Title"
                          Class="rounded-lg"
                          Style="width: 100%; height: 100%;"
                          ObjectFit="cover"
                          LoadingMode="K7ImageLoadingMode.Css"
                          loading="lazy" />
            }
            else
            {
                <div class="episode-card-still-placeholder">
                    <K7Icon Icon="@Phosphor.FilmSlate" IconSize="@K7IconSize.Md" Style="opacity: 0.3;" />
                </div>
            }
            @if (Episode.UserState is { ProgressPercentage: >= 1 and < 100 })
            {
                <div class="episode-card-progress">
                    <K7ProgressBar Value="@Episode.UserState.ProgressPercentage" />
                </div>
            }
            @if (Episode.UserState?.IsCompleted == true)
            {
                <div class="episode-card-watched">
                    <K7Icon  IconSize="@K7IconSize.Lg" Color="success" Icon="@Phosphor.Fill.CheckCircle" />
                </div>
            }
        </div>

        <div class="episode-card-info">
            <div class="episode-card-meta">
                <span class="episode-card-number">E@(Episode.EpisodeNumber)</span>
                @if (DurationLabel is not null)
                {
                    <span class="episode-card-meta-separator">&bull;</span>
                    <span class="episode-card-duration">@DurationLabel</span>
                }
            </div>
            <p class="episode-card-title @(IsUnavailable ? "episode-card-title--unavailable" : null)">@(Episode.Title ?? S["Untitled"])</p>
            @if (IsUnavailable)
            {
                <span class="episode-card-unavailable text-muted text-xs">@S["MediaUnavailable"]</span>
            }
            @if (AirDateLabel is not null)
            {
                <span class="episode-card-date">@AirDateLabel</span>
            }
            @if (!string.IsNullOrEmpty(Episode.Overview))
            {
                <p class="episode-card-synopsis">@Episode.Overview</p>
            }
        </div>
    </a>

    <div class="episode-card-menu @(_menuOpen ? "episode-card-menu--open" : null)" data-longpress-target @onclick:stopPropagation="true">
        <div @ref="_menuTriggerRef">
            <K7IconButton Icon="@Phosphor.DotsThreeVertical"
                           Size="sm"
                           Class="episode-card-menu-trigger"
                           AriaLabel="more-actions"
                           Focusable="false"
                           OnClick="OpenSharedMenuAsync" />
        </div>
    </div>
</div>
