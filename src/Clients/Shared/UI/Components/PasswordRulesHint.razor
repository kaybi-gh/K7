@namespace K7.Clients.Shared.UI.Components
@using K7.Shared.Security
@inject IStringLocalizer<PasswordRulesHint> L

<ul class="password-rules" aria-live="polite">
    @foreach (var (rule, isMet) in PasswordPolicy.Evaluate(Password))
    {
        <li class="password-rules__item @(isMet ? "password-rules__item--met" : "")">
            <K7Icon Icon="@(isMet ? Phosphor.CheckCircle : Phosphor.Circle)"
                    IconSize="@K7IconSize.Sm"
                    Class="password-rules__icon" />
            <span>@LabelFor(rule)</span>
        </li>
    }
</ul>
