@namespace K7.Clients.Shared.UI.Components

@if (OnClick.HasDelegate)
{
    <button type="button"
            class="@CssClass"
            id="@Id"
            disabled="@Disabled"
            @onclick="OnClick">
        @Content
    </button>
}
else
{
    <a class="@CssClass"
       id="@Id"
       href="@Href"
       aria-current="@(Active ? "page" : null)">
        @Content
        <span class="k7-entity-row__caret" aria-hidden="true">
            <K7Icon Icon="@Phosphor.CaretRight" IconSize="@K7IconSize.Sm" />
        </span>
    </a>
}

@code {
    private RenderFragment Content =>
        @<text>
            @if (Checked is not null)
            {
                <span class="k7-entity-row__check" aria-hidden="true">
                    <K7Icon Icon="@(Checked == true ? Phosphor.Fill.CheckCircle : Phosphor.Circle)" IconSize="@K7IconSize.Md" />
                </span>
            }
            @if (Leading is not null)
            {
                <span class="k7-entity-row__leading @(Dimmed ? "k7-entity-row__leading--dimmed" : null)">@Leading</span>
            }
            <span class="k7-entity-row__text">
                <span class="k7-entity-row__title">@Title</span>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <span class="k7-entity-row__subtitle">@Subtitle</span>
                }
            </span>
            @if (Trailing is not null)
            {
                <span class="k7-entity-row__trailing">@Trailing</span>
            }
        </text>;
}
