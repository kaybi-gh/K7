@using K7.Shared.Security

<div>
    <input name="@Name"
           type="email"
           class="auth-input focusable"
           placeholder="@Placeholder"
           autocomplete="@Autocomplete"
           inputmode="email"
           value="@_email"
           aria-invalid="@(ShowInvalid ? "true" : "false")"
           aria-describedby="@(ShowInvalid ? InvalidId : null)"
           @oninput="OnInput" />
    @if (ShowInvalid)
    {
        <p id="@InvalidId" class="auth-validation" role="status">@L["InvalidEmail"]</p>
    }
</div>
