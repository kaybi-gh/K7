@using K7.Shared.Security

<div data-k7-auth-email>
    <input name="@Name"
           type="email"
           class="auth-input focusable"
           placeholder="@Placeholder"
           autocomplete="@Autocomplete"
           inputmode="email"
           value="@Value"
           aria-invalid="@(ShowInvalid ? "true" : "false")"
           aria-describedby="@(ShowInvalid ? InvalidId : null)" />
    <p id="@InvalidId" class="auth-validation" role="status" data-k7-auth-email-invalid hidden="@(!ShowInvalid)">@L["InvalidEmail"]</p>
</div>
