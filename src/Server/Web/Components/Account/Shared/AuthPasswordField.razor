@using K7.Clients.Shared.UI.Components
@using K7.Shared.Dtos

<div data-k7-auth-password>
    @if (ShowVisibilityToggle)
    {
        <div class="auth-input-row">
            <input id="@PasswordId"
                   name="@Name"
                   type="password"
                   class="auth-input focusable"
                   placeholder="@Placeholder"
                   autocomplete="new-password"
                   aria-required="true"
                   value="@Value"
                   data-k7-password />
            <button type="button"
                    class="auth-input-action focusable"
                    data-k7-toggle-password
                    data-k7-toggle-for="@PasswordId"
                    aria-label="@ToggleLabel">
                <i class="ph ph-eye"></i>
            </button>
        </div>
    }
    else
    {
        <input name="@Name"
               type="password"
               class="auth-input focusable"
               placeholder="@Placeholder"
               autocomplete="new-password"
               aria-required="true"
               value="@Value"
               data-k7-password />
    }

    <PasswordRulesHint Password="@Value" Policy="@Policy" />

    @if (ShowConfirm)
    {
        <div class="auth-form-field auth-form-field--follow">
            @if (!string.IsNullOrEmpty(ConfirmLabel))
            {
                <label>@ConfirmLabel</label>
            }
            @if (ShowVisibilityToggle)
            {
                <div class="auth-input-row">
                    <input id="@ResolvedConfirmId"
                           name="@ConfirmName"
                           type="password"
                           class="auth-input focusable"
                           placeholder="@ConfirmPlaceholder"
                           autocomplete="new-password"
                           aria-required="true"
                           aria-invalid="false"
                           value="@ConfirmValue"
                           data-k7-password-confirm />
                    <button type="button"
                            class="auth-input-action focusable"
                            data-k7-toggle-password
                            data-k7-toggle-for="@ResolvedConfirmId"
                            aria-label="@ToggleLabel">
                        <i class="ph ph-eye"></i>
                    </button>
                </div>
            }
            else
            {
                <input name="@ConfirmName"
                       type="password"
                       class="auth-input focusable"
                       placeholder="@ConfirmPlaceholder"
                       autocomplete="new-password"
                       aria-required="true"
                       aria-invalid="false"
                       value="@ConfirmValue"
                       data-k7-password-confirm />
            }
            <p id="@MismatchId" class="auth-validation" role="status" data-k7-password-mismatch hidden>@L["PasswordMismatch"]</p>
            <p id="@MatchId" class="auth-validation auth-validation--ok" role="status" data-k7-password-match hidden>@L["PasswordsMatch"]</p>
        </div>
    }
</div>
