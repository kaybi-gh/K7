@using K7.Clients.Shared.UI.Components
@using K7.Shared.Dtos

<div>
    @if (ShowVisibilityToggle)
    {
        <div class="auth-input-row">
            <input id="@Id"
                   name="@Name"
                   type="@InputType"
                   class="auth-input focusable"
                   placeholder="@Placeholder"
                   autocomplete="new-password"
                   aria-required="true"
                   value="@_password"
                   @oninput="OnPasswordInput" />
            <button type="button"
                    class="auth-input-action focusable"
                    @onclick="ToggleVisibility"
                    aria-label="@ToggleLabel">
                <i class="ph @(_reveal ? "ph-eye-slash" : "ph-eye")"></i>
            </button>
        </div>
    }
    else
    {
        <input name="@Name"
               type="password"
               class="auth-input focusable"
               placeholder="@Placeholder"
               autocomplete="new-password"
               aria-required="true"
               value="@_password"
               @oninput="OnPasswordInput" />
    }

    <PasswordRulesHint Password="@_password" Policy="@Policy" />

    @if (ShowConfirm)
    {
        <div class="auth-form-field auth-form-field--follow">
            @if (!string.IsNullOrEmpty(ConfirmLabel))
            {
                <label>@ConfirmLabel</label>
            }
            @if (ShowVisibilityToggle)
            {
                <div class="auth-input-row">
                    <input id="@ConfirmId"
                           name="@ConfirmName"
                           type="@ConfirmInputType"
                           class="auth-input focusable"
                           placeholder="@ConfirmPlaceholder"
                           autocomplete="new-password"
                           aria-required="true"
                           aria-invalid="@(ShowMismatch ? "true" : "false")"
                           aria-describedby="@ConfirmHintId"
                           value="@_confirm"
                           @oninput="OnConfirmInput" />
                    <button type="button"
                            class="auth-input-action focusable"
                            @onclick="ToggleConfirmVisibility"
                            aria-label="@ToggleLabel">
                        <i class="ph @(_revealConfirm ? "ph-eye-slash" : "ph-eye")"></i>
                    </button>
                </div>
            }
            else
            {
                <input name="@ConfirmName"
                       type="password"
                       class="auth-input focusable"
                       placeholder="@ConfirmPlaceholder"
                       autocomplete="new-password"
                       aria-required="true"
                       aria-invalid="@(ShowMismatch ? "true" : "false")"
                       aria-describedby="@ConfirmHintId"
                       value="@_confirm"
                       @oninput="OnConfirmInput" />
            }
            @if (ShowMismatch)
            {
                <p id="@ConfirmHintId" class="auth-validation" role="status">@L["PasswordMismatch"]</p>
            }
            else if (ShowMatch)
            {
                <p id="@ConfirmHintId" class="auth-validation auth-validation--ok" role="status">@L["PasswordsMatch"]</p>
            }
        </div>
    }
</div>
