@page "/sign-in/access-denied"
@layout K7.Server.Web.Components.Pages.Auth.AuthLayout

@inject IStringLocalizer<AccessDenied> L

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="auth-card">
    <div class="auth-card-header">
        <h1 class="auth-title">@L["Title"]</h1>
        <p class="auth-subtitle">@L["Message"]</p>
    </div>
    <div class="auth-card-body">
        <a href="/" data-enhance-nav="false" style="text-decoration:none;">
            <button type="button" class="k7-btn k7-btn--filled focusable" style="width:100%;">@L["GoToHome"]</button>
        </a>
    </div>
</div>
