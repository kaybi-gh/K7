<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Mono win-x64 packs are not published for .NET 10. Set before the SDK imports so a Windows TFM stays on CoreCLR. -->
    <UseMonoRuntime Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</UseMonoRuntime>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.17.3</Version>
    <StaticWebAssetMakeReferencedAssetOriginalItemSpecAbsolute Condition="'$(StaticWebAssetMakeReferencedAssetOriginalItemSpecAbsolute)' == ''">true</StaticWebAssetMakeReferencedAssetOriginalItemSpecAbsolute>
  </PropertyGroup>
  <ItemGroup>
    <_StaticWebAssetCanonicalMetadata Include="FileLength" />
    <_StaticWebAssetCanonicalMetadata Include="LastWriteTime" />
  </ItemGroup>
</Project>